<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:animation="clr-namespace:StartRide.App.Behaviors.Animation" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:converters="clr-namespace:StartRide.App.Converters" xmlns:res="clr-namespace:StartRide.App.Resources">

  <Style x:Key="LauncherContentSectionStyle" TargetType="{x:Type GroupBox}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="3" Height="15" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" />
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="15" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" />
            </Grid>
            <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource Brush.Glass.EdgeSoft}" SnapsToDevicePixels="True" />
            <ContentPresenter Margin="0,14,0,0" ContentSource="Content" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RideSectionStyle" TargetType="{x:Type GroupBox}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <Border Background="{DynamicResource Brush.Glass.Face}" BorderBrush="{DynamicResource Brush.Glass.Edge}" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- 顶部内高光：玻璃最关键的一道光 -->
              <Border Height="1" Margin="18,0,18,0" VerticalAlignment="Top" Background="{DynamicResource Brush.Glass.TopHighlightSoft}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
              <!-- 头部即开关：默认收起，点一下展开本板块 -->
              <Grid Grid.Row="0">
                <ToggleButton x:Name="SectionHeaderToggle" Focusable="False" Cursor="Hand" Background="#00FFFFFF" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <!-- 透明背景 Grid 作为可命中根：HeaderHover 是 IsHitTestVisible=False 的装饰层，
                           若直接做模板根会导致整个开关点不中（点击穿透到卡片） -->
                      <Grid Background="#00FFFFFF">
                        <Border Name="HeaderHover" Background="{DynamicResource Brush.Glass.HoverFace}" CornerRadius="15,15,0,0" Opacity="0" IsHitTestVisible="False" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="HeaderHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction>
                                  <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="HeaderHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                  <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <Grid Margin="18,14,16,14" IsHitTestVisible="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="3" Height="14" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" />
                  <ContentPresenter Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="15" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" />
                  <Path Grid.Column="2" Width="11" Height="7" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource Brush.Text.Subtle}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" Data="M 0.9 1 L 5.5 5.6 L 10.1 1" RenderTransformOrigin="0.5,0.5">
                    <UIElement.RenderTransform>
                      <RotateTransform x:Name="SectionChevronRotate" Angle="0" />
                    </UIElement.RenderTransform>
                  </Path>
                </Grid>
              </Grid>
              <!-- 板块内容：跟随头部开关做高度动画收起 / 展开 -->
              <Grid Grid.Row="1">
                <Grid x:Name="SectionBody" Margin="0,14,0,0" animation:AnimatedCollapse.Duration="0:0:0.2" animation:AnimatedCollapse.IsExpanded="{Binding IsChecked, ElementName=SectionHeaderToggle}">
                  <Border Height="1" Margin="18,0,18,0" VerticalAlignment="Top" Background="{DynamicResource Brush.Glass.EdgeSoft}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                  <Border Padding="18,15,18,17">
                    <ContentPresenter ContentSource="Content" />
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger SourceName="SectionHeaderToggle" Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SectionChevronRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SectionChevronRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListPageItemButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="13">
            <Grid>
              <Border Name="SelectedBackground" Background="{DynamicResource Brush.Glass.SelectedFace}" CornerRadius="13" Opacity="0" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.Glass.HoverFace}" CornerRadius="13" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Glass.SelectedFace}" CornerRadius="13" Opacity="0" />
              <Border Name="SelectedAccent" Width="2.5" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" Opacity="0" />
              <Border Name="TopSeparator" Height="1" Margin="15,0,15,0" VerticalAlignment="Top" Background="{DynamicResource Brush.14FFFFFF}" />
              <Border Name="BottomSeparator" Height="1" Margin="15,0,15,0" VerticalAlignment="Bottom" Background="{DynamicResource Brush.14FFFFFF}" Opacity="0" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SelectedAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SelectedAccent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="SelectedAccent" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="BottomSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DownloadVersionListButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ListPageItemButtonStyle}" />
  <Style x:Key="ListPagePrimaryFloatingButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="116" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="0,0,30,28" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.AccentFace}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.AccentEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Panel.ZIndex" Value="4" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="21" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="22" Color="{DynamicResource Color.0891FE}" Opacity="0.38" ShadowDepth="2" />
            </UIElement.Effect>
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" CornerRadius="21" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.Glass.AccentHover}" CornerRadius="21" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Glass.AccentPressed}" CornerRadius="21" Opacity="0" />
              <Border Name="GlassHighlight" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="16" Background="{DynamicResource Brush.Glass.TopHighlight}" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource Brush.BFFFFFFF}" Property="Foreground" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter TargetName="Root" Property="UIElement.Effect" Value="{x:Null}" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.5A5A5A}" Property="Border.Background" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DownloadNextStepButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ListPagePrimaryFloatingButtonStyle}">
    <Setter Property="Width" Value="100" />
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="ListPageSecondaryFloatingButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="96" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0,0,0,32" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.FaceSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Panel.ZIndex" Value="5" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="17">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="18" Color="{DynamicResource Color.000000}" Opacity="0.28" ShadowDepth="0" />
            </UIElement.Effect>
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.Glass.HoverFace}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Glass.SelectedFace}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="GlassHighlight" Height="1" Margin="1,1,1,0" VerticalAlignment="Top" Background="{DynamicResource Brush.Glass.TopHighlightSoft}" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LauncherProgressBarStyle" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource Brush.24FFFFFF}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="behaviors:ProgressBarAnimation.IsEnabled" Value="True" />
    <Setter Property="behaviors:ProgressBarAnimation.DurationMilliseconds" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid Name="Root" Height="{TemplateBinding FrameworkElement.Height}" UseLayoutRounding="True">
            <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" />
            <Grid ClipToBounds="True" behaviors:RoundedClip.Radius="3">
              <Border Name="Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" CornerRadius="3" Width="{Binding Path=(behaviors:ProgressBarAnimation.AnimatedWidth), RelativeSource={RelativeSource TemplatedParent}}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="8" Color="{DynamicResource Color.0891FE}" Opacity="0.26" ShadowDepth="0" />
                </UIElement.Effect>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="10">
            <Grid>
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="10" />
              <Border Name="SelectedBackground" Background="{DynamicResource Brush.Glass.SelectedFace}" BorderBrush="{DynamicResource Brush.Glass.EdgeSoft}" BorderThickness="1" CornerRadius="10" Opacity="0" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.Glass.HoverFace}" CornerRadius="10" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Glass.HoverFace}" CornerRadius="10" Opacity="0" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="behaviors:SecondaryMenuButtonBehavior.IsSelected" Value="True" />
                <Condition Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding IsSelected}" />
                <Condition Value="False" Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Tag.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                <Condition Value="False" Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiDataTrigger>
            <Trigger Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="True">
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource Brush.Text.Disabled}" Property="Foreground" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.68" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuDeleteButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
