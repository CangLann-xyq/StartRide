<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:converters="clr-namespace:Launcher.App.Converters" xmlns:res="clr-namespace:Launcher.App.Resources">
  <!-- StartRide：原版模板就是「16px 半透明白标题 + 12px 间距 + 卡片」，和 StartRide 逐像素一致，
       所以换过配色之后整页仍然一眼认得出出处。这里改成左侧强调竖条 + 高对比标题 + 一条基线，
       每一段都有明确的"章节"起止，19 个设置/详情页共用。 -->
  <Style x:Key="LauncherContentSectionStyle" TargetType="{x:Type GroupBox}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="3" Height="15" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" />
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="15" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" />
            </Grid>
            <Border Height="1" Margin="0,10,0,0" Background="#14FFFFFF" SnapsToDevicePixels="True" />
            <ContentPresenter Margin="0,14,0,0" ContentSource="Content" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- StartRide 设置页章节（取代 LauncherContentSectionStyle 的旧骨架）。
       旧骨架是「裸标题 + 标题下一道线 + 内嵌一张带描边的卡片」，卡片里还套着卡片 —— 盒套盒一眼看出是套模板。
       新版把整块收成一张极淡的卡片，标题旁边一枚强调竖条，正文左缩进 12px 与标题文字对齐（同一条左轨）。
       与 Ride* 系列（styles/controlstyles.page.xaml）共用一套版式语言。 -->
  <Style x:Key="RideSectionStyle" TargetType="{x:Type GroupBox}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <Border Padding="18,15,18,17" Background="#0AFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="3" Height="14" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" />
                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="15" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" />
              </Grid>
              <Border Height="1" Margin="12,11,0,0" Background="#12FFFFFF" SnapsToDevicePixels="True" />
              <ContentPresenter Margin="12,15,0,0" ContentSource="Content" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListPageItemButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="13">
            <Grid>
              <Border Name="SelectedBackground" Background="{DynamicResource Brush.List.Item.Selected}" CornerRadius="13" Opacity="0" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.List.Item.Hover}" CornerRadius="13" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.2EFFFFFF}" CornerRadius="13" Opacity="0" />
              <!-- 选中态左侧强调条：比整行变色更克制，也更像"自己设计的" -->
              <Border Name="SelectedAccent" Width="2.5" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" CornerRadius="2" Background="{DynamicResource Brush.Accent.Primary}" Opacity="0" />
              <Border Name="TopSeparator" Height="1" Margin="15,0,15,0" VerticalAlignment="Top" Background="{DynamicResource Brush.14FFFFFF}" />
              <Border Name="BottomSeparator" Height="1" Margin="15,0,15,0" VerticalAlignment="Bottom" Background="{DynamicResource Brush.14FFFFFF}" Opacity="0" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SelectedAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SelectedAccent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="SelectedAccent" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="BottomSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}">
              <Setter TargetName="TopSeparator" Property="UIElement.Opacity" Value="0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DownloadVersionListButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ListPageItemButtonStyle}" />
  <Style x:Key="ListPagePrimaryFloatingButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="116" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="0,0,30,28" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Panel.ZIndex" Value="4" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="21">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="22" Color="{DynamicResource Color.0891FE}" Opacity="0.38" ShadowDepth="2" />
            </UIElement.Effect>
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" CornerRadius="21" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.047EDC}" CornerRadius="21" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.036FC2}" CornerRadius="21" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource Brush.BFFFFFFF}" Property="Foreground" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter TargetName="Root" Property="UIElement.Effect" Value="{x:Null}" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.5A5A5A}" Property="Border.Background" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DownloadNextStepButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ListPagePrimaryFloatingButtonStyle}">
    <Setter Property="Width" Value="100" />
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="14" />
  </Style>
