    <Setter Property="Margin" Value="0,0,0,32" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.B03D3D3D}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.22FFFFFF}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Panel.ZIndex" Value="5" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="17">
