  <Style x:Key="LauncherSwitchToggleButtonStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="28" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <!--
      关闭态原来是一块 #6E6E6E 实心灰：在深色玻璃卡上像贴了张纸，还把旁边的
      文字压暗了。换成「凹陷玻璃槽」（FaceSunken）后才像一条真的轨道。
    -->
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.FaceSunken}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" Background="#00FFFFFF">
            <Border Name="Track" Background="{TemplateBinding Control.Background}" CornerRadius="14" />
            <Border Name="TrackOutline" Background="#00FFFFFF" BorderBrush="{DynamicResource Brush.Glass.EdgeSoft}" BorderThickness="1" CornerRadius="14" />
            <Border Name="ActiveTrack" Background="{DynamicResource Brush.Glass.AccentFace}" BorderBrush="{DynamicResource Brush.Glass.AccentEdge}" BorderThickness="1" CornerRadius="14" Opacity="0" />
            <Border Name="Thumb" Width="22" Height="22" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Brush.FFFFFF}" CornerRadius="11">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="ThumbTranslateTransform" X="0" />
              </UIElement.RenderTransform>
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="6" Color="{DynamicResource Color.20000000}" Direction="270" Opacity="0.35" ShadowDepth="1" />
              </UIElement.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="ActiveTrack" Property="UIElement.Opacity" Value="1" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="UIElement.Opacity" Value="0.98" />
              <Setter TargetName="Thumb" Property="UIElement.Opacity" Value="0.98" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Track" Property="UIElement.Opacity" Value="0.92" />
              <Setter TargetName="Thumb" Property="UIElement.Opacity" Value="0.94" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="1" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter TargetName="Track" Value="{DynamicResource Brush.Glass.FaceSoft}" Property="Border.Background" />
              <Setter TargetName="TrackOutline" Value="{DynamicResource Brush.18FFFFFF}" Property="Border.BorderBrush" />
              <Setter TargetName="ActiveTrack" Value="{DynamicResource Brush.Glass.FaceSoft}" Property="Border.Background" />
              <Setter TargetName="ActiveTrack" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="Thumb" Value="{DynamicResource Brush.C8D0D9}" Property="Border.Background" />
              <Setter TargetName="Thumb" Property="UIElement.Opacity" Value="0.62" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="ToggleButton.IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Value="{DynamicResource Brush.Glass.FaceSoft}" Property="Border.Background" />
              <Setter TargetName="TrackOutline" Value="{DynamicResource Brush.Accent.Border}" Property="Border.BorderBrush" />
              <Setter TargetName="ActiveTrack" Value="{DynamicResource Brush.Accent.Border}" Property="Border.Background" />
              <Setter TargetName="Thumb" Value="{DynamicResource Brush.FFFFFF}" Property="Border.Background" />
              <Setter TargetName="Thumb" Property="UIElement.Opacity" Value="0.82" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
