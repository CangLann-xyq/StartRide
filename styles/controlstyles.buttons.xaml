  <Style x:Key="LauncherProgressBarStyle" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource Brush.24FFFFFF}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="behaviors:ProgressBarAnimation.IsEnabled" Value="True" />
    <Setter Property="behaviors:ProgressBarAnimation.DurationMilliseconds" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid Name="Root" Height="{TemplateBinding FrameworkElement.Height}" UseLayoutRounding="True">
            <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" />
            <Grid ClipToBounds="True" behaviors:RoundedClip.Radius="3">
              <Border Name="Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" CornerRadius="3" Width="{Binding Path=(behaviors:ProgressBarAnimation.AnimatedWidth), RelativeSource={RelativeSource TemplatedParent}}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="8" Color="{DynamicResource Color.0891FE}" Opacity="0.26" ShadowDepth="0" />
                </UIElement.Effect>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" CornerRadius="10">
            <Grid>
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="10" />
              <Border Name="SelectedBackground" Background="{DynamicResource Brush.22FFFFFF}" CornerRadius="10" Opacity="0" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.22FFFFFF}" CornerRadius="10" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.34FFFFFF}" CornerRadius="10" Opacity="0" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="behaviors:SecondaryMenuButtonBehavior.IsSelected" Value="True" />
                <Condition Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding IsSelected}" />
                <Condition Value="False" Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Tag.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                <Condition Value="False" Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
            </MultiDataTrigger>
            <Trigger Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="True">
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource Brush.Text.Disabled}" Property="Foreground" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.68" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
