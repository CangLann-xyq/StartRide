              <DropShadowEffect BlurRadius="18" Color="{DynamicResource Color.000000}" Opacity="0.28" ShadowDepth="0" />
            </UIElement.Effect>
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.D04A4A4A}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.E05A5A5A}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
