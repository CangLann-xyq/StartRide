<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:controls="clr-namespace:StartRide.App.Controls">
  <Style x:Key="BackdropBlurBorderStyle" TargetType="{x:Type controls:BackdropBlurBorder}">
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="{DynamicResource Brush.Backdrop.Base}" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="{DynamicResource Brush.Backdrop.Tint}" />
    <Setter Property="controls:BackdropBlurBorder.SourceElement" Value="{Binding LauncherPreblurredBackdropSourceElement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="controls:BackdropBlurBorder.BlurRadius" Value="42" />
    <Setter Property="controls:BackdropBlurBorder.BlurRenderingBias" Value="Performance" />
    <Setter Property="controls:BackdropBlurBorder.IsSourcePreblurred" Value="False" />
    <Setter Property="controls:BackdropBlurBorder.IsTintEnabled" Value="False" />
    <Setter Property="controls:BackdropBlurBorder.CornerRadius" Value="{StaticResource LauncherCornerRadiusMedium}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:BackdropBlurBorder}">
          <Grid Name="PART_Root" ClipToBounds="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
            <Border Name="PART_BaseLayer" Background="{TemplateBinding controls:BackdropBlurBorder.BaseBrush}" CornerRadius="{TemplateBinding controls:BackdropBlurBorder.CornerRadius}" IsHitTestVisible="False" />
            <Border Name="PART_BlurLayer" IsHitTestVisible="False" Visibility="Collapsed">
              <UIElement.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="0.2" SnapsToDevicePixels="True" />
              </UIElement.CacheMode>
              <Border.Background>
                <VisualBrush AlignmentX="Left" AlignmentY="Top" RenderOptions.CachingHint="Cache" RenderOptions.CacheInvalidationThresholdMinimum="0.5" RenderOptions.CacheInvalidationThresholdMaximum="2" Stretch="Fill" TileMode="FlipXY" ViewboxUnits="Absolute" ViewportUnits="Absolute" />
              </Border.Background>
              <UIElement.Effect>
                <BlurEffect KernelType="Gaussian" Radius="{Binding BlurRadius, RelativeSource={RelativeSource TemplatedParent}}" RenderingBias="{Binding BlurRenderingBias, RelativeSource={RelativeSource TemplatedParent}}" />
              </UIElement.Effect>
            </Border>
            <Border Name="PART_TintLayer" Background="{TemplateBinding controls:BackdropBlurBorder.TintBrush}" CornerRadius="{TemplateBinding controls:BackdropBlurBorder.CornerRadius}" IsHitTestVisible="False" />
            <Border Name="PART_OverlayLayer" Background="{TemplateBinding controls:BackdropBlurBorder.OverlayBrush}" CornerRadius="{TemplateBinding controls:BackdropBlurBorder.CornerRadius}" IsHitTestVisible="False" />
            <Border Name="PART_ContentLayer" Padding="{TemplateBinding Control.Padding}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding controls:BackdropBlurBorder.CornerRadius}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:BackdropBlurBorder.IsSourcePreblurred" Value="True">
              <Setter TargetName="PART_BlurLayer" Property="UIElement.Effect" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:BackdropBlurBorder}" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}" />
  <Style x:Key="SharedBackdropBlurSourceStyle" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}">
    <Setter Property="controls:BackdropBlurBorder.IsBlurEnabled" Value="{DynamicResource Is.Surface.BackdropBlur.Enabled}" />
    <Setter Property="controls:BackdropBlurBorder.IsSourcePreblurred" Value="False" />
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="controls:BackdropBlurBorder.CornerRadius" Value="0" />
  </Style>
  <Style x:Key="SurfaceBackdropBlurStyle" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}">
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="{Binding Path=(behaviors:BackdropBlurHost.FallbackBrush), RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.IsTintEnabled" Value="{DynamicResource Is.ImageBackground.ControlTint.Enabled}" />
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <Trigger Property="controls:BackdropBlurBorder.IsTintEnabled" Value="True">
        <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="#00FFFFFF" />
        <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="{DynamicResource Brush.SecondaryMenu.BackdropTint}" />
        <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="{DynamicResource Brush.SurfaceBackdrop.ContrastOverlay}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SecondaryMenuBackdropStyle" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}">
    <Setter Property="controls:BackdropBlurBorder.IsBlurEnabled" Value="{DynamicResource Is.SecondaryMenu.BackdropBlur.Enabled}" />
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="{DynamicResource Brush.SecondaryMenu.Panel}" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="#38101318" />
    <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.IsTintEnabled" Value="{DynamicResource Is.ImageBackground.ControlTint.Enabled}" />
    <!-- 四边 1px 描边 + 18px 圆角 = 悬浮卡片观感。

         ⚠️ 这个键**不只**给那六个页面的左栏用 —— 主页的启动菜单面板
         （`HomeLaunchGameListView.xaml` 的 `HomeLaunchMenuPanel`）也挂着它，
         那是一张真·悬浮卡片（配 14px 圆角的阴影层 + 圆角底边）。

         2026-09-26 曾把这里整体改成"贴边竖栏"（描边只留右侧、圆角归零），
         顺手把主页那张卡片也改坏了 —— 所以现在**拆成两个键**：
         本键恢复卡片原样，贴边竖栏走下面的 `SecondaryMenuSidebarBackdropStyle`。
         教训：共享样式改之前先 grep 全部引用方，别只看自己正在改的那一处。 -->
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SecondaryMenu.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:BackdropBlurBorder.CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="behaviors:RoundedClip.Radius" Value="18" />
    <Style.Triggers>
      <Trigger Property="controls:BackdropBlurBorder.IsTintEnabled" Value="True">
        <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="#00FFFFFF" />
        <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="{DynamicResource Brush.SecondaryMenu.BackdropTint}" />
        <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="{DynamicResource Brush.SurfaceBackdrop.ContrastOverlay}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 侧栏专用（贴边竖栏）：左 / 上 / 下都贴住页面边，只有右侧一条 1px 分隔线，
       但**右侧两个角留 18px 圆角** —— 竖栏从页面顶铺到底，右缘的两个转角不再是死直角。

       ⚠️ `CornerRadius` 必须写 "0,18,18,0"（左上 / 右上 / 右下 / 左下）：
       左边两个角贴着窗口左缘，圆了会露出后面的页面底色，变成两个缺口。
       ⚠️ 逐角圆角**只能靠 `CornerRadius`** —— `behaviors:RoundedClip.Radius` 是 `double`，
       底层 `RectangleGeometry(rect, rx, ry)` 只能均匀圆角，给不出"只圆右边两角"。
       模板里三层填充（Base / Tint / Overlay）与描边层都绑 `CornerRadius`，所以逐角值是有效的。
       子元素不会画进圆角区：侧栏内容左右各留 14px 边距（`SecondaryMenuItemsPanelStyle`），
       滚动条也在边距之内。 -->
  <Style x:Key="SecondaryMenuSidebarBackdropStyle" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}">
    <Setter Property="controls:BackdropBlurBorder.IsBlurEnabled" Value="{DynamicResource Is.SecondaryMenu.BackdropBlur.Enabled}" />
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="{DynamicResource Brush.SecondaryMenu.Panel}" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="#38101318" />
    <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.IsTintEnabled" Value="{DynamicResource Is.ImageBackground.ControlTint.Enabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SecondaryMenu.Border}" />
    <Setter Property="BorderThickness" Value="0,1,1,0" />
    <Setter Property="controls:BackdropBlurBorder.CornerRadius" Value="0,18,18,0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Style.Triggers>
      <Trigger Property="controls:BackdropBlurBorder.IsTintEnabled" Value="True">
        <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="#00FFFFFF" />
        <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="{DynamicResource Brush.SecondaryMenu.BackdropTint}" />
        <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="{DynamicResource Brush.SurfaceBackdrop.ContrastOverlay}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryMenuBackdropStyle" TargetType="{x:Type controls:BackdropBlurBorder}" BasedOn="{StaticResource BackdropBlurBorderStyle}">
    <Setter Property="controls:BackdropBlurBorder.IsBlurEnabled" Value="{DynamicResource Is.SecondaryMenu.BackdropBlur.Enabled}" />
    <Setter Property="controls:BackdropBlurBorder.BaseBrush" Value="#D913141B" />
    <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="#38101318" />
    <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="#00FFFFFF" />
    <Setter Property="controls:BackdropBlurBorder.IsTintEnabled" Value="{DynamicResource Is.ImageBackground.ControlTint.Enabled}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="controls:BackdropBlurBorder.CornerRadius" Value="0" />
    <Style.Triggers>
      <Trigger Property="controls:BackdropBlurBorder.IsTintEnabled" Value="True">
        <Setter Property="controls:BackdropBlurBorder.TintBrush" Value="{DynamicResource Brush.SecondaryMenu.BackdropTint}" />
        <Setter Property="controls:BackdropBlurBorder.OverlayBrush" Value="{DynamicResource Brush.SurfaceBackdrop.ContrastOverlay}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>