  <Style x:Key="LauncherSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Control.Background}" CornerRadius="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LauncherSliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Root" Background="{DynamicResource Brush.FFFFFF}" CornerRadius="10">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="8" Color="{DynamicResource Color.20000000}" Direction="270" Opacity="0.4" ShadowDepth="1" />
            </UIElement.Effect>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.98" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.94" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Value="{DynamicResource Brush.C8D0D9}" Property="Border.Background" />
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.62" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LauncherSliderStyle" TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="28" />
    <Setter Property="RangeBase.Minimum" Value="0" />
    <Setter Property="RangeBase.Maximum" Value="100" />
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Height="{TemplateBinding FrameworkElement.Height}" Background="#00FFFFFF">
            <Border Height="6" VerticalAlignment="Center" Background="{DynamicResource Brush.24FFFFFF}" CornerRadius="3" />
            <Track Name="PART_Track" Height="20" VerticalAlignment="Center" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" IsDirectionReversed="{TemplateBinding Slider.IsDirectionReversed}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Background="{DynamicResource LauncherAccentBrush}" Command="Slider.DecreaseLarge" Style="{StaticResource LauncherSliderTrackButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Background="#00FFFFFF" Command="Slider.IncreaseLarge" Style="{StaticResource LauncherSliderTrackButtonStyle}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource LauncherSliderThumbStyle}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.58" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
