      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.IsApplied="True" behaviors:BackdropBlurHost.FallbackBrush="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.LightweightShadowEffect="{Binding Path=(behaviors:BackdropBlurHost.LightweightShadowEffect), RelativeSource={RelativeSource TemplatedParent}}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
