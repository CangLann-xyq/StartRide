<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:converters="clr-namespace:StartRide.App.Converters" xmlns:res="clr-namespace:StartRide.App.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/StartRide;component/Styles/ControlStyles.Scroll.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogOverlayStyle" TargetType="{x:Type Grid}">
    <Setter Property="ColumnSpan" Value="2" />
    <Setter Property="RowSpan" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.99000000}" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  </Style>
  <Style x:Key="DialogShadowStyle" TargetType="{x:Type Border}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.01000000}" />
    <Setter Property="Border.CornerRadius" Value="20" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="40" Color="{DynamicResource Color.000000}" Opacity="0.42" ShadowDepth="6" Direction="270" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DialogSurfaceStyle" TargetType="{x:Type Border}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Flyout}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.2AFFFFFF}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="behaviors:RoundedClip.Radius" Value="20" />
  </Style>
  <Style x:Key="DialogContentGridStyle" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="26" />
  </Style>
  <Style x:Key="DialogTitleTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DialogSubtitleTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AFFFFFFF}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="DialogBodyTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.CFFFFFFF}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="DialogFieldLabelTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="DialogValidationTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="2,8,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFF8A8A}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="DialogChoiceItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="Root" CornerRadius="12">
            <Grid>
              <Border Name="BaseBackground" Background="{DynamicResource Brush.List.Item.Background}" behaviors:BackdropBlurHost.IsApplied="True" behaviors:BackdropBlurHost.IsBlurEnabled="{DynamicResource Is.Surface.BackdropBlur.Enabled}" behaviors:BackdropBlurHost.FallbackBrush="{DynamicResource Brush.List.Item.Background}" CornerRadius="12" />
              <Border Name="SelectedBackground" Background="{DynamicResource Brush.List.Item.Selected}" CornerRadius="12" Opacity="0" />
              <Border Name="SelectedOutline" BorderBrush="{DynamicResource Brush.List.Item.SelectedBorder}" BorderThickness="2" CornerRadius="12" Opacity="0" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.List.Item.Hover}" CornerRadius="12" Opacity="0" />
              <ContentPresenter Margin="14" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="SelectedBackground" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="SelectedOutline" Property="UIElement.Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DialogChoiceListStyle" TargetType="{x:Type ListBox}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource DialogChoiceItemStyle}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,22,0,18" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
    <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MainContentScrollBarStyle}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="DialogActionItemButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
    <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border CornerRadius="12">
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" CornerRadius="12" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.List.Item.Hover}" CornerRadius="12" Opacity="0" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Button.Secondary.Pressed}" CornerRadius="12" Opacity="0" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter Value="{DynamicResource Brush.Text.Disabled}" Property="Foreground" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DialogFormPanelStyle" TargetType="{x:Type StackPanel}">
    <Setter Property="Margin" Value="0,24,0,26" />
  </Style>
  <Style x:Key="DialogDropZoneBorderStyle" TargetType="{x:Type Border}">
    <Setter Property="MinHeight" Value="148" />
    <Setter Property="Border.Padding" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.24FFFFFF}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="16" />
    <Setter Property="behaviors:RoundedClip.Radius" Value="16" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding LocalImportDialog.IsDragOver}">
        <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.List.Item.SelectedBorder}" />
        <Setter Property="BorderThickness" Value="2" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DialogFooterStyle" TargetType="{x:Type StackPanel}">
    <Setter Property="StackPanel.Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style x:Key="DialogTrailingButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>
  <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="MinWidth" Value="86" />
    <Setter Property="Height" Value="{StaticResource LauncherCompactControlHeight}" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Card.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.TextBox.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="behaviors:BackdropBlurHost.LightweightShadowEffect" Value="{DynamicResource Effect.Card.Surface}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.IsApplied="True" behaviors:BackdropBlurHost.IsBlurEnabled="{DynamicResource Is.Surface.BackdropBlur.Enabled}" behaviors:BackdropBlurHost.FallbackBrush="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.LightweightShadowEffect="{Binding Path=(behaviors:BackdropBlurHost.LightweightShadowEffect), RelativeSource={RelativeSource TemplatedParent}}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="SurfaceContrastLayer" Background="{DynamicResource Brush.Button.Secondary.Background}" IsHitTestVisible="False" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.Button.Secondary.Hover}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.Button.Secondary.Pressed}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding Path=(behaviors:BackdropBlurHost.IsBlurEnabled), ElementName=BaseBackground}">
              <Setter TargetName="SurfaceContrastLayer" Property="UIElement.Opacity" Value="1" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter Value="{DynamicResource Brush.Text.Disabled}" Property="Foreground" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="behaviors:BackdropBlurHost.FallbackBrush" />
              <Setter TargetName="SurfaceContrastLayer" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="behaviors:SurfaceShadow.SuppressChildShadows" Value="True">
        <Setter Property="behaviors:BackdropBlurHost.LightweightShadowEffect" Value="{x:Null}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryDialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="behaviors:GlassHighlightBehavior.IsEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <!-- 液态玻璃对话框主按钮。
               弹性缩放加在 Root 上（整块玻璃连着文案一起压扁/回弹）：
               一来 BackdropBlurHost 是挂在 BaseBackground 上的行为，动父级结构风险太大；
               二来 4.5% 的形变落在 36px 高的按钮上，观感就是「玻璃弹了一下」，字看不出扭。
               玻璃覆层的画法与首页大按钮同源，只是尺寸整体收小。 -->
          <Border Name="Root" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
            <Border.BorderBrush>
              <!-- 玻璃厚度：上缘受天光、底缘受反射，中段几乎不描 -->
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8AFFFFFF" Offset="0" />
                <GradientStop Color="#1FFFFFFF" Offset="0.3" />
                <GradientStop Color="#1CFFFFFF" Offset="0.64" />
                <GradientStop Color="#52FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
              <ScaleTransform x:Name="GlassScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
              <Border Name="BaseBackground" Background="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.IsApplied="True" behaviors:BackdropBlurHost.FallbackBrush="{TemplateBinding Control.Background}" behaviors:BackdropBlurHost.LightweightShadowEffect="{Binding Path=(behaviors:BackdropBlurHost.LightweightShadowEffect), RelativeSource={RelativeSource TemplatedParent}}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="SurfaceContrastLayer" Background="{DynamicResource Brush.Button.Secondary.Background}" IsHitTestVisible="False" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="SemanticBackground" Background="{TemplateBinding Control.Background}" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="HoverBackground" Background="{DynamicResource Brush.047EDC}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <Border Name="PressedBackground" Background="{DynamicResource Brush.036FC2}" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}" />
              <!-- 玻璃覆层 -->
              <Border Name="LensDomeMark" IsHitTestVisible="False" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}">
                <Border.Background>
                  <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.44" RadiusX="0.98" RadiusY="0.98">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#05FFFFFF" Offset="0.52" />
                    <GradientStop Color="#22FFFFFF" Offset="0.82" />
                    <GradientStop Color="#6BFFFFFF" Offset="1" />
                  </RadialGradientBrush>
                </Border.Background>
              </Border>
              <Border Name="TopSheen" IsHitTestVisible="False" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0.12,1">
                    <GradientStop Color="#5EFFFFFF" Offset="0" />
                    <GradientStop Color="#1CFFFFFF" Offset="0.42" />
                    <GradientStop Color="#00FFFFFF" Offset="0.72" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border Name="BottomBounce" IsHitTestVisible="False" Opacity="0" behaviors:InnerCornerRadius.Source="{Binding ElementName=Root}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,1" EndPoint="0,0.42">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Canvas IsHitTestVisible="False" behaviors:RoundedClip.Radius="18">
                <Ellipse Name="PART_GlassDomeSpot" Width="86" Height="44" Canvas.Left="7" Canvas.Top="-4" Opacity="0">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#3AFFFFFF" Offset="0" />
                      <GradientStop Color="#0DFFFFFF" Offset="0.55" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Name="PART_GlassGlossSpot" Width="70" Height="52" Canvas.Left="15" Canvas.Top="-8" Opacity="0">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#80FFFFFF" Offset="0" />
                      <GradientStop Color="#2EFFFFFF" Offset="0.45" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
              </Canvas>
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="LensDomeMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TopSheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.26">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="BottomBounce" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.26">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="PART_GlassGlossSpot" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="PART_GlassDomeSpot" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="1.028" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="1.028" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="LensDomeMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TopSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="BottomBounce" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="PART_GlassGlossSpot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.34">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="PART_GlassDomeSpot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.34">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.34">
                    <DoubleAnimation.EasingFunction>
                      <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.34">
                    <DoubleAnimation.EasingFunction>
                      <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="PART_GlassGlossSpot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="0.972" Duration="0:0:0.09">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="0.945" Duration="0:0:0.09">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                    <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.56">
                      <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4.5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlassScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.56">
                      <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4.5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding Path=(behaviors:BackdropBlurHost.IsBlurEnabled), ElementName=BaseBackground}">
              <Setter TargetName="SurfaceContrastLayer" Property="UIElement.Opacity" Value="1" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
              <Setter Value="{DynamicResource Brush.Text.Disabled}" Property="Foreground" />
              <Setter TargetName="Root" Property="Border.BorderBrush" Value="{x:Null}" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Is.Surface.BackdropBlur.Enabled}" Property="behaviors:BackdropBlurHost.IsBlurEnabled" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="behaviors:BackdropBlurHost.FallbackBrush" />
              <Setter TargetName="SurfaceContrastLayer" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="SemanticBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="LensDomeMark" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="TopSheen" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="BottomBounce" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PART_GlassGlossSpot" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PART_GlassDomeSpot" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DangerDialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
    <Setter Property="Background" Value="{DynamicResource Brush.D94343}" />
