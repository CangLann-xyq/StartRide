              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="BaseBackground" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="behaviors:BackdropBlurHost.FallbackBrush" />
              <Setter TargetName="SurfaceContrastLayer" Value="{DynamicResource Brush.Button.Secondary.Disabled}" Property="Border.Background" />
              <Setter TargetName="HoverBackground" Property="UIElement.Opacity" Value="0" />
              <Setter TargetName="PressedBackground" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
