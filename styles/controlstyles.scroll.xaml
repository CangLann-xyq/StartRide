<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:converters="clr-namespace:StartRide.App.Converters" xmlns:res="clr-namespace:StartRide.App.Resources">
  <converters:MinimumScrollThumbViewportConverter x:Key="MinimumScrollThumbViewportConverter" />

  <Style x:Key="SecondaryMenuPanelSurfaceStyle" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="224" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="SnapsToDevicePixels" Value="True" />

    <Setter Property="Border.Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="34" Direction="270" ShadowDepth="16"
                          Opacity="0.34" Color="#000000" RenderingBias="Quality" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuPanelStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Brush.SecondaryMenu.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SecondaryMenu.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="behaviors:RoundedClip.Radius" Value="18" />
  </Style>
  <Style x:Key="SecondaryMenuHeaderTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="22,18,22,9" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SecondaryMenuHeaderOverlayStyle" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="76" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Panel.ZIndex" Value="2" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />

    <Setter Property="Border.CornerRadius" Value="18,18,0,0" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#14FFFFFF" Offset="0" />
          <GradientStop Color="#06FFFFFF" Offset="0.62" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuHeaderRuleStyle" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="22,0,22,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.EdgeSoft}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
  </Style>
  <Style x:Key="SecondaryMenuHeaderSpacerStyle" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="70" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
  </Style>
  <Style x:Key="SlimScrollRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--
    滚动条滑块。
    原来的做法是一根 5px 的纯色细线，在深色玻璃面上两个问题：
      ① 没有底槽，看不出「总长多少、我停在哪」，只能靠它自己推位置
      ② 圆角 2.5 + 硬色，边缘发毛，hover 时突然跳亮一档，很廉价
    现在：6px 圆角 3 + 上下留 3px 呼吸 + 拖动时切主题蓝（一眼看出「正在拖」）。
  -->
  <Style x:Key="SlimScrollThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="#66FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Root" Width="6" Margin="1,3" HorizontalAlignment="Center" Background="{TemplateBinding Control.Background}" CornerRadius="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Value="#8CFFFFFF" Property="Border.Background" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Brush.Accent.Primary}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SlimVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <!-- 底槽：极淡的一条，只说明「轨道有多长」，不能抢滑块的存在感 -->
            <Border Name="TrackBed" Width="6" HorizontalAlignment="Right" Margin="0,3,2,3"
                    CornerRadius="3" Background="#14FFFFFF" />
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SlimScrollRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SlimScrollRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="TrackBed" Property="Background" Value="#1FFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OverlayScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CanContentScroll" Value="False" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Control.Background}" ClipToBounds="{TemplateBinding UIElement.ClipToBounds}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
            <ScrollContentPresenter Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Control.Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" />
            <ScrollBar Name="PART_VerticalScrollBar" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}" Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollBar.ViewportSize>
                <MultiBinding ConverterParameter="58" Converter="{StaticResource MinimumScrollThumbViewportConverter}">
                  <Binding Path="ViewportHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ScrollBar.ViewportSize>
            </ScrollBar>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryMenuScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimVerticalScrollBarStyle}">
    <Setter Property="Margin" Value="0,74,5,14" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Setter Property="UIElement.Opacity" Value="1" />
        <Setter Property="UIElement.IsHitTestVisible" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SecondaryMenuScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource OverlayScrollViewerStyle}">
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="72" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ClipToBounds" Value="True" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SecondaryMenuScrollBarStyle}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="SecondaryMenuVirtualizedScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource SecondaryMenuScrollViewerStyle}">
    <Setter Property="CanContentScroll" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
  </Style>
  <Style x:Key="MainContentScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimVerticalScrollBarStyle}">
    <Setter Property="Margin" Value="0,8,0,8" />
    <Setter Property="UIElement.Opacity" Value="0" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <!--
        显隐用动画而不是 Setter 直切：直切在快速划过页面时会「啪啪」闪，像在抖。
        160ms 淡入 / 220ms 淡出后就只是安静地出现和消失。
      -->
      <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Setter Property="UIElement.IsHitTestVisible" Value="True" />
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="MainContentScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource OverlayScrollViewerStyle}">
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ClipToBounds" Value="True" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MainContentScrollBarStyle}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <Style x:Key="RidePersistentScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimVerticalScrollBarStyle}">
    <Setter Property="Margin" Value="0,8,2,8" />
    <Setter Property="UIElement.Opacity" Value="1" />
    <Setter Property="UIElement.IsHitTestVisible" Value="True" />
  </Style>
  <Style x:Key="RidePersistentScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource MainContentScrollViewerStyle}">
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource RidePersistentScrollBarStyle}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <Style x:Key="UpdateNotesScrollThumbStyle" TargetType="{x:Type Thumb}" BasedOn="{StaticResource SlimScrollThumbStyle}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="#40FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Root" Width="4" Margin="1,3" HorizontalAlignment="Center" Background="{TemplateBinding Control.Background}" CornerRadius="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Brush.84FFFFFF}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Brush.A8FFFFFF}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UpdateNotesScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Margin" Value="0,2,0,2" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SlimScrollRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource UpdateNotesScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SlimScrollRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UpdateNotesScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource OverlayScrollViewerStyle}">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="56" />
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource UpdateNotesScrollBarStyle}" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>
</ResourceDictionary>