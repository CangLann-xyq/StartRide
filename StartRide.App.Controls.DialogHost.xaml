<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Controls.DialogHost" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" x:Name="Host" Focusable="False" xmlns:controls="clr-namespace:StartRide.App.Controls">
  <Grid Name="RootOverlay" behaviors:BackdropBlurHost.IsBlurSuppressed="True" Style="{StaticResource DialogOverlayStyle}">
    <Border Margin="0,24" Style="{StaticResource DialogShadowStyle}" Width="{Binding DialogWidth, ElementName=Host}" MaxHeight="{Binding ActualHeight, ElementName=Host}" />
    <Border Name="Surface" Margin="0,24" Style="{StaticResource DialogSurfaceStyle}" Width="{Binding DialogWidth, ElementName=Host}" MaxHeight="{Binding ActualHeight, ElementName=Host}">
      <ContentPresenter Content="{Binding DialogContent, ElementName=Host}" />
    </Border>
  </Grid>
</UserControl>