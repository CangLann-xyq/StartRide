<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Home.HomePageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Launcher.App.Views.Home" Focusable="False">
  <Grid Name="PageRoot">
    <Grid Name="HomeLaunchContentHost">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="HomeLaunchContentTranslate" />
      </UIElement.RenderTransform>
      <views:HomeLaunchPanelView />
    </Grid>
    <views:HomeLaunchGameListView Panel.ZIndex="4" DataContext="{Binding LaunchGames}" />
  </Grid>
</UserControl>