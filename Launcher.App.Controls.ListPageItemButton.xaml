<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Controls.ListPageItemButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:controls="clr-namespace:Launcher.App.Controls" x:Name="Root" Focusable="False" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
  <FrameworkElement.Style>
    <Style TargetType="{x:Type controls:ListPageItemButton}">
      <Setter Property="controls:ListPageItemButton.TitleForeground" Value="{DynamicResource Brush.F2F2F2}" />
      <Setter Property="controls:ListPageItemButton.SubtitleForeground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="controls:ListPageItemButton.TrailingForeground" Value="{DynamicResource Brush.Text.Subtle}" />
      <Setter Property="controls:ListPageItemButton.IconOverlayForeground" Value="{DynamicResource Brush.Text.Danger}" />
    </Style>
  </FrameworkElement.Style>
  <Grid Name="AnimatedRoot">
    <Button Name="PART_Button" RenderTransformOrigin="0.5,0.5" Style="{StaticResource ListPageItemButtonStyle}" Margin="{Binding ItemMargin, ElementName=Root}" Tag="{Binding ElementName=Root}" Command="{Binding Command, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding IconColumnWidth, ElementName=Root}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 图标底板：默认 Padding=0 / 描边=0 / 背景=null，观感与旧版完全一致；
             需要"控件感"的页面传 IconTileBackground + IconTilePadding=9 + IconTileBorderThickness=1 即可。
             底板自动贴合 glyph 尺寸，所以不用额外给宽高。 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True" Margin="{Binding IconMargin, ElementName=Root}" Padding="{Binding IconTilePadding, ElementName=Root}" BorderThickness="{Binding IconTileBorderThickness, ElementName=Root}" Background="{Binding IconTileBackground, ElementName=Root}" BorderBrush="{Binding IconTileBorderBrush, ElementName=Root}" CornerRadius="{Binding IconTileCornerRadius, ElementName=Root}">
          <Grid Width="{Binding IconWidth, ElementName=Root}" Height="{Binding IconHeight, ElementName=Root}">
            <Border Background="#00FFFFFF" CornerRadius="{StaticResource LauncherCornerRadiusSmall}" ClipToBounds="True" behaviors:RoundedClip.Radius="6" Opacity="{Binding IconOpacity, ElementName=Root}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ResolvedIconSource, ElementName=Root}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <Image HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="UniformToFill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="{Binding IconScalingMode, ElementName=Root}" Source="{Binding ResolvedIconSource, ElementName=Root}" />
            </Border>
            <controls:SvgIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.DFFFFFFF}" Width="{Binding IconWidth, ElementName=Root}" Height="{Binding IconHeight, ElementName=Root}" IconKey="{Binding IconKey, ElementName=Root}" Opacity="{Binding IconOpacity, ElementName=Root}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type controls:SvgIcon}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IconKey, ElementName=Root}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="" Binding="{Binding IconKey, ElementName=Root}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </controls:SvgIcon>
            <controls:SvgIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding IconOverlayKey, ElementName=Root}" Foreground="{Binding IconOverlayForeground, ElementName=Root}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type controls:SvgIcon}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IconOverlayKey, ElementName=Root}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="" Binding="{Binding IconOverlayKey, ElementName=Root}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </controls:SvgIcon>
          </Grid>
        </Border>
        <Grid Column="1" VerticalAlignment="Center" Margin="{Binding TextMargin, ElementName=Root}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False" ClipToBounds="True">
            <TextBlock DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Title, ElementName=Root}" Foreground="{Binding TitleForeground, ElementName=Root}" FontSize="{Binding TitleFontSize, ElementName=Root}" FontWeight="{Binding TitleFontWeight, ElementName=Root}" />
            <ContentPresenter DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Content="{Binding TitleTrailingContent, ElementName=Root}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentPresenter}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TitleTrailingContent, ElementName=Root}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentPresenter>
          </DockPanel>
          <TextBlock Grid.Row="1" Margin="0,2,0,0" FontWeight="Normal" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle, ElementName=Root}" Foreground="{Binding SubtitleForeground, ElementName=Root}" FontSize="{Binding SubtitleFontSize, ElementName=Root}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="" Binding="{Binding Subtitle, ElementName=Root}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Subtitle, ElementName=Root}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </Grid>
        <TextBlock Name="TrailingTextBlock" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="{Binding TrailingMargin, ElementName=Root}" Text="{Binding TrailingText, ElementName=Root}" Foreground="{Binding TrailingForeground, ElementName=Root}" FontSize="{Binding TrailingFontSize, ElementName=Root}" />
      </Grid>
    </Button>
    <ContentPresenter Name="TrailingContentPresenter" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0" Margin="{Binding TrailingMargin, ElementName=Root}" Content="{Binding TrailingContent, ElementName=Root}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentPresenter}">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="UIElement.IsHitTestVisible" Value="False" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding TrailingContent, ElementName=Root}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=Root}">
              <Setter Property="UIElement.IsHitTestVisible" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentPresenter>
  </Grid>
</UserControl>