<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.GameSettings.InstanceJavaSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:gamesettings="clr-namespace:Launcher.App.Views.GameSettings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/GameSettings/GameSettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <Border Margin="0,0,0,26" Style="{StaticResource SectionFieldSurfaceStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchSettingsModeLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
        <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource InstanceJavaSelectionOptionTemplate}" SelectionItemTemplate="{StaticResource InstanceJavaSelectionOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding LaunchSettingsModeOptions}" SelectedItem="{Binding SelectedInstanceJavaSettingsModeOption, Mode=TwoWay}" />
      </Grid>
    </Border>
    <GroupBox Header="{x:Static res:Strings.Settings_JavaSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_JavaSelectionLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource InstanceJavaSelectionOptionTemplate}" SelectionItemTemplate="{StaticResource InstanceJavaSelectionOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding InstanceJavaSelectionOptions}" SelectedItem="{Binding SelectedInstanceJavaSelectionOption, Mode=TwoWay}" IsEnabled="{Binding AreInstanceJavaSettingsOverridesEnabled}" />
          </Grid>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{x:Static res:Strings.Settings_JavaListLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
              <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding InstanceJavaRuntimeListMessage}" Visibility="{Binding HasInstanceJavaRuntimeListMessage, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
            </StackPanel>
            <Button Grid.Column="1" Margin="0,0,10,0" Content="{x:Static res:Strings.Refresh_Button}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding RefreshInstanceJavaRuntimesCommand}" />
            <Button Grid.Column="2" Content="{x:Static res:Strings.ManualImport_Button}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Command="{Binding ImportInstanceJavaRuntimeCommand}" />
          </Grid>
          <Grid>
            <ListBox ItemTemplate="{StaticResource InstanceJavaRuntimeItemTemplate}" ItemContainerStyle="{StaticResource InstanceJavaRuntimeListBoxItemStyle}" Style="{StaticResource InstanceJavaRuntimeListBoxStyle}" ItemsSource="{Binding InstanceJavaRuntimes}" SelectedItem="{Binding SelectedInstanceJavaRuntime, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>