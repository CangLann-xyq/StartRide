<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Resources.ResourcesModPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" xmlns:viewModels="clr-namespace:Launcher.App.ViewModels.Resources" xmlns:views="clr-namespace:Launcher.App.Views.Resources" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/GameSettings/GameSettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ResourcesModDetailLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="ResourcesModDetailTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="ResourcesModVersionsTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="MaxWidth" Value="{StaticResource DetailPageContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.A8FFFFFF}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="ResourcesModDetailDescriptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextBlock.LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="ResourcesModDetailFieldRowStyle" TargetType="{x:Type Grid}">
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>
      <Style x:Key="ResourcesModDetailValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="ResourcesModDetailHyperlinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
        <Style.Triggers>
          <Trigger Property="ContentElement.IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ResourcesModInstallTargetStateTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,12" />
      </Style>
      <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:ResourcesModVersionListHeaderItem}}" DataType="{x:Type viewModels:ResourcesModVersionListHeaderItem}">
        <TextBlock Style="{StaticResource ResourcesModVersionsTitleTextStyle}" Text="{Binding Title}" />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:ResourcesListFooterStatusItem}}" DataType="{x:Type viewModels:ResourcesListFooterStatusItem}">
        <TextBlock MinHeight="44" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.B8FFFFFF}" FontSize="12" TextAlignment="Center" Text="{Binding Message}" />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:ResourcesModProjectItemViewModel}}" DataType="{x:Type viewModels:ResourcesModProjectItemViewModel}">
        <controls:ListPageItemButton Style="{StaticResource ListPageItemButtonEntranceStyle}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" TrailingText="{Binding TrailingText}" IconSource="{Binding IconSource}" IconKey="{Binding IconKey}" IsFirstVisible="{Binding Tag.IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsLastVisible="{Binding Tag.IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsPreviousItemHighlighted="{Binding Tag.IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" ShouldPlayEnterAnimation="{Binding Tag.ShouldPlayEnterAnimation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" EnterAnimationIndex="{Binding Tag.EnterAnimationIndex, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Command="{Binding DataContext.ProjectList.SelectProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding}">
          <controls:ListPageItemButton.TitleTrailingContent>
            <controls:AdaptiveTagList ItemsSource="{Binding TitleTags}" Visibility="{Binding HasTitleTags, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
          </controls:ListPageItemButton.TitleTrailingContent>
        </controls:ListPageItemButton>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:ResourcesModVersionItemViewModel}}" DataType="{x:Type viewModels:ResourcesModVersionItemViewModel}">
        <controls:ListPageItemButton Style="{StaticResource ListPageItemButtonEntranceStyle}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" TrailingText="{Binding TrailingText}" IconSource="{Binding IconSource}" IconKey="{Binding IconKey}" IsFirstVisible="{Binding Tag.IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsLastVisible="{Binding Tag.IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsPreviousItemHighlighted="{Binding Tag.IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" ShouldPlayEnterAnimation="{Binding Tag.ShouldPlayEnterAnimation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" EnterAnimationIndex="{Binding Tag.EnterAnimationIndex, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Command="{Binding DataContext.Versions.InstallVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="ModStepHost" Tag="ModStepHost" ClipToBounds="True">
    <Grid Name="ProjectListStep" Tag="ProjectListStep">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>
      <controls:DeferredListContentHost IsListVisible="{Binding ProjectList.HasVisibleProjects}">
        <ListBox Name="ResourcesModListBox" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" behaviors:VirtualizedListItemStateBehavior.IsEnabled="True" behaviors:VirtualizedListItemStateBehavior.ContentTopOffset="132" ItemsSource="{Binding ProjectList.ListItems}" behaviors:VirtualizedListItemStateBehavior.EntranceAnimationToken="{Binding ProjectList.ListEntranceAnimationToken}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Margin="12,132,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ListBox>
      </controls:DeferredListContentHost>
      <TextBlock Margin="12,132,12,0" Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding ProjectList.LoadingMessage}" Visibility="{Binding ProjectList.CanShowLoadingState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <TextBlock Margin="12,132,12,0" Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding ProjectList.EmptyMessage}" Visibility="{Binding ProjectList.CanShowEmptyState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <StackPanel Margin="12,132,12,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ProjectList.CanShowLoadErrorState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
        <TextBlock Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding ProjectList.LoadErrorMessage}" />
        <Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="{x:Static res:Strings.Refresh_Button}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding ProjectList.RefreshCommand}" />
      </StackPanel>
    </Grid>
    <Grid Name="ProjectDetailsStep" Tag="ProjectDetailsStep" Opacity="0" Visibility="Collapsed" DataContext="{Binding Details.CurrentProject}">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>
      <Grid Name="DetailsStepHost" ClipToBounds="True">
        <Grid Name="InstallTargetStep" Tag="InstallTargetStep">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
          <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ListPageScrollViewerStyle}" behaviors:SmoothScrollBehavior.IsEnabled="True" behaviors:SmoothScrollBehavior.ScrollAmount="92" behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds="130">
            <StackPanel MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch" Margin="12,82,0,64">
              <GroupBox Style="{StaticResource LauncherContentSectionStyle}" Header="{Binding DataContext.Details.InfoSectionText, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="74" Height="74">
                        <Grid Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" behaviors:RoundedClip.Radius="8">
                          <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconSource, Converter={StaticResource IconSourceImageConverter}}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Image}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Image>
                          <controls:SvgIcon Width="42" Height="42" Foreground="{DynamicResource Brush.Icon.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding IconKey}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type controls:SvgIcon}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </controls:SvgIcon>
                        </Grid>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ResourcesModDetailTitleTextStyle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource ResourcesModDetailDescriptionTextStyle}" Text="{Binding Description}" />
                      </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsVersionLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}" Text="{Binding SupportedMinecraftVersionsText}" />
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}" Visibility="{Binding ShowsLoaders, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsLoaderLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}" Text="{Binding SupportedLoadersText}" />
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsSourceLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}">
                        <Hyperlink Style="{StaticResource ResourcesModDetailHyperlinkStyle}" Command="{Binding DataContext.Parent.OpenProjectPageCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding}">
                          <Run Text="{Binding SourceText, Mode=OneWay}" />
                        </Hyperlink>
                      </TextBlock>
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}" Visibility="{Binding DataContext.Details.HasRelatedWebsite, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsRelatedWebsitesLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}">
                        <Hyperlink Style="{StaticResource ResourcesModDetailHyperlinkStyle}" Command="{Binding DataContext.Parent.OpenRelatedWebsiteCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding DataContext.Details.RelatedWebsite, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                          <Run Text="{Binding DataContext.Details.RelatedWebsite.Name, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
                        </Hyperlink>
                      </TextBlock>
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsDownloadsLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}" Text="{Binding DownloadsText}" />
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}" Visibility="{Binding HasTitleTags, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsTagsLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource ResourcesModDetailValueTextStyle}" Text="{Binding TitleTagsText}" />
                    </Grid>
                    <Grid Style="{StaticResource ResourcesModDetailFieldRowStyle}" Visibility="{Binding DataContext.Details.HasRequiredDependencies, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Static res:Strings.Resources_ModDetailsDependenciesLabel}" Style="{StaticResource ResourcesModDetailLabelTextStyle}" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding DataContext.Details.RequiredDependencies, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Margin="0,0,8,6" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.Details.OpenDependencyCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True" behaviors:RoundedClip.Radius="4">
                                  <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconSource, Converter={StaticResource IconSourceImageConverter}}">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type Image}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </Image>
                                  <controls:SvgIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding IconKey}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type controls:SvgIcon}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </controls:SvgIcon>
                                </Grid>
                                <TextBlock MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Border>
              </GroupBox>
              <GroupBox Margin="0,16,0,0" Style="{StaticResource LauncherContentSectionStyle}" Header="{Binding DataContext.Versions.InstallTargetSectionText, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
                <StackPanel>
                  <TextBlock Style="{StaticResource ResourcesModInstallTargetStateTextStyle}" Text="{Binding DataContext.Versions.InstallTargetsLoadingMessage, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" Visibility="{Binding DataContext.Versions.CanShowTargetsLoadingState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
                  <controls:DeferredListContentHost DataContext="{Binding DataContext, ElementName=Root}" IsListVisible="{Binding Versions.HasInstallTargets}">
                    <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" behaviors:VirtualizedListItemStateBehavior.IsEnabled="True" ItemsSource="{Binding Versions.InstallTargets}" behaviors:VirtualizedListItemStateBehavior.EntranceAnimationToken="{Binding Versions.InstallTargetsEntranceAnimationToken}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <controls:ListPageItemButton Style="{StaticResource ListPageItemButtonEntranceStyle}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" IconSource="{Binding IconSource}" IconKey="{Binding IconKey}" IsFirstVisible="{Binding Tag.IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsLastVisible="{Binding Tag.IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsPreviousItemHighlighted="{Binding Tag.IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" ShouldPlayEnterAnimation="{Binding Tag.ShouldPlayEnterAnimation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" EnterAnimationIndex="{Binding Tag.EnterAnimationIndex, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Command="{Binding DataContext.Versions.SelectTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ListBox>
                  </controls:DeferredListContentHost>
                  <TextBlock Style="{StaticResource ResourcesModInstallTargetStateTextStyle}" Text="{Binding DataContext.Versions.TargetsLoadErrorMessage, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" Visibility="{Binding DataContext.Versions.CanShowTargetsLoadErrorState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid Name="ProjectVersionsStep" Tag="ProjectVersionsStep" Opacity="0" Visibility="Collapsed">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
          <controls:DeferredListContentHost DataContext="{Binding DataContext, ElementName=Root}" IsListVisible="{Binding Versions.HasVisibleVersions}">
            <ListBox Name="ResourcesModVersionListBox" Margin="0,0,12,0" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" behaviors:VirtualizedListItemStateBehavior.IsEnabled="True" behaviors:VirtualizedListItemStateBehavior.ContentTopOffset="172" ItemsSource="{Binding Versions.ListItems}" behaviors:VirtualizedListItemStateBehavior.EntranceAnimationToken="{Binding Versions.ListEntranceAnimationToken}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Margin="12,172,0,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ListBox>
          </controls:DeferredListContentHost>
          <TextBlock Margin="12,172,12,64" Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding DataContext.Versions.LoadingMessage, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" Visibility="{Binding DataContext.Versions.CanShowLoadingState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
          <TextBlock Margin="12,172,12,64" Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding DataContext.Versions.EmptyMessage, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" Visibility="{Binding DataContext.Versions.CanShowEmptyState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
          <StackPanel Margin="12,172,12,64" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DataContext.Versions.CanShowLoadErrorState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}">
            <TextBlock Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding DataContext.Versions.LoadErrorMessage, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
            <Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="{x:Static res:Strings.Refresh_Button}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.Versions.RefreshCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesModPageView}}}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>