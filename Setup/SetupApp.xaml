<Application x:Class="StartRide.Setup.SetupApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!--
    安装包的全局视觉。刻意不复用启动器的主题字典：
    安装包要能在「启动器还没装 / 装坏了」的机器上跑起来，任何外部依赖都是风险。
    这里的画刷与启动器深色主题同源（同一个蓝 #0891FE），改色时两边要一起改。
  -->
  <Application.Resources>

    <SolidColorBrush x:Key="Brush.Window" Color="#FF0B0D11" />
    <SolidColorBrush x:Key="Brush.Rail" Color="#FF0E1116" />
    <SolidColorBrush x:Key="Brush.Footer" Color="#FF0E1116" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FF141821" />
    <SolidColorBrush x:Key="Brush.Line" Color="#FF1E232C" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE8ECF2" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#FF8A93A3" />
    <SolidColorBrush x:Key="Brush.Text.Faint" Color="#FF5C6473" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0891FE" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF047EDC" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF036FC2" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#1F0891FE" />
    <SolidColorBrush x:Key="Brush.Field" Color="#FF10141B" />

    <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="DimText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyText}">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 主按钮：蓝底胶囊 -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" CornerRadius="18" Background="{StaticResource Brush.Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FF232833" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次按钮：描边胶囊 -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" CornerRadius="18" Background="Transparent"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF191E27" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF232833" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 窗口右上角关闭键 -->
    <Style x:Key="CaptionCloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <Path x:Name="Glyph" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{StaticResource Brush.Text.Dim}"
                    StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF232833" />
                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 复核框：自绘，避免系统默认方框在深色底上发白 -->
    <Style x:Key="CheckBoxStyle" TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                      Background="{StaticResource Brush.Field}"
                      BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 1,4 L 4,7 L 9,1" Stroke="White" StrokeThickness="1.8"
                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FF3A4250" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
