<Window x:Class="StartRide.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartRide 安装程序"
        Width="920" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        AllowsTransparency="False"
        Background="{StaticResource Brush.Window}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

  <Window.Resources>
    <!-- 安装路径输入框 -->
    <Style x:Key="PathBox" TargetType="{x:Type TextBox}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource Brush.Field}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 步骤条文 -->
    <Style x:Key="StepTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyText}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="78" />
    </Grid.RowDefinitions>

    <!-- ═══════════ 标题栏（自绘，可拖动） ═══════════ -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Window}" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
      <Grid>
        <TextBlock Text="StartRide 安装程序" Margin="18,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource DimText}" />
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                Click="CloseButton_OnClick" />
      </Grid>
    </Border>

    <!-- ═══════════ 主体：左品牌栏 + 右步骤区 ═══════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="272" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左栏 -->
      <Border Grid.Column="0" Background="{StaticResource Brush.Rail}"
              BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
        <StackPanel Margin="30,30,28,24">
          <Image x:Name="BrandLogo" Width="196" HorizontalAlignment="Left" Stretch="Uniform" />
          <TextBlock Text="BeamNG.drive 多人联机启动器" Margin="0,8,0,0"
                     Style="{StaticResource DimText}" TextWrapping="Wrap" />

          <Border Height="1" Background="{StaticResource Brush.Line}" Margin="0,22,0,22" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border x:Name="Step1Mark" Width="22" Height="22" CornerRadius="11"
                    Background="{StaticResource Brush.Accent}">
              <TextBlock x:Name="Step1Num" Text="1" Foreground="White" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Step1Text" Text="欢迎" Margin="11,0,0,0" Style="{StaticResource StepTitle}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border x:Name="Step2Mark" Width="22" Height="22" CornerRadius="11"
                    Background="#FF1B212B" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
              <TextBlock x:Name="Step2Num" Text="2" Foreground="{StaticResource Brush.Text.Dim}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Step2Text" Text="正在安装" Margin="11,0,0,0"
                       Style="{StaticResource StepTitle}" Foreground="{StaticResource Brush.Text.Faint}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step3Mark" Width="22" Height="22" CornerRadius="11"
                    Background="#FF1B212B" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
              <TextBlock x:Name="Step3Num" Text="3" Foreground="{StaticResource Brush.Text.Dim}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Step3Text" Text="完成" Margin="11,0,0,0"
                       Style="{StaticResource StepTitle}" Foreground="{StaticResource Brush.Text.Faint}" />
          </StackPanel>

          <TextBlock x:Name="VersionLabel" Margin="0,26,0,0" Style="{StaticResource DimText}" />
        </StackPanel>
      </Border>

      <!-- 右栏 -->
      <Grid Grid.Column="1" Margin="36,30,36,0">

        <!-- ── 第 1 步：欢迎 ── -->
        <StackPanel x:Name="PanelWelcome">
          <TextBlock x:Name="WelcomeTitle" Text="安装 StartRide" FontSize="24"
                     Style="{StaticResource BodyText}" FontWeight="SemiBold" />
          <TextBlock x:Name="WelcomeLead" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="520"
                     HorizontalAlignment="Left"
                     Style="{StaticResource DimText}"
                     Text="StartRide 是一个第三方的 BeamNG.drive 联机启动器：管理游戏本体、模组与车辆，并内置自研的联机房间。" />

          <TextBlock Text="安装位置" Margin="0,26,0,8" Style="{StaticResource DimText}"
                     Foreground="{StaticResource Brush.Text}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathInput" Grid.Column="0" Style="{StaticResource PathBox}" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…"
                    Style="{StaticResource GhostButton}" Click="Browse_OnClick" />
            <Button x:Name="DefaultPathButton" Grid.Column="3" Content="恢复默认"
                    Style="{StaticResource GhostButton}" Click="DefaultPath_OnClick" />
          </Grid>

          <TextBlock x:Name="UpgradeHint" Margin="0,10,0,0" Visibility="Collapsed"
                     Style="{StaticResource DimText}" Foreground="{StaticResource Brush.Accent}" />

          <TextBlock Text="安装选项" Margin="0,24,0,10" Style="{StaticResource BodyText}" />
          <CheckBox x:Name="DesktopCheck" Content="创建桌面快捷方式" Margin="0,0,0,12"
                    Style="{StaticResource CheckBoxStyle}" IsChecked="True" />
          <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单快捷方式" Margin="0,0,0,12"
                    Style="{StaticResource CheckBoxStyle}" IsChecked="True" />
          <CheckBox x:Name="LaunchCheck" Content="安装完成后启动 StartRide" Margin="0,0,0,12"
                    Style="{StaticResource CheckBoxStyle}" IsChecked="True" />
        </StackPanel>

        <!-- ── 第 2 步：进度 ── -->
        <StackPanel x:Name="PanelProgress" Visibility="Collapsed">
          <TextBlock Text="正在安装" FontSize="24" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
          <TextBlock x:Name="ProgressLead" Margin="0,12,0,0" MaxWidth="520" HorizontalAlignment="Left"
                     TextWrapping="Wrap" Style="{StaticResource DimText}"
                     Text="请稍候，安装过程中不要关闭这个窗口。" />

          <Border x:Name="ProgressTrack" Margin="0,34,0,0" Height="8" CornerRadius="4"
                  Background="#FF1B212B" HorizontalAlignment="Stretch">
            <Border x:Name="ProgressFill" Width="0" CornerRadius="4" HorizontalAlignment="Left"
                    Background="{StaticResource Brush.Accent}" />
          </Border>

          <Grid Margin="0,12,0,0">
            <TextBlock x:Name="ProgressPercent" Text="0%" HorizontalAlignment="Left"
                       Style="{StaticResource BodyText}" />
            <TextBlock x:Name="ProgressFile" Text="" HorizontalAlignment="Right"
                       Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
          </Grid>

          <TextBlock x:Name="ProgressStage" Margin="0,28,0,0" Style="{StaticResource DimText}"
                     Foreground="{StaticResource Brush.Text}" />
        </StackPanel>

        <!-- ── 第 3 步：完成 ── -->
        <StackPanel x:Name="PanelDone" Visibility="Collapsed">
          <TextBlock Text="安装完成" FontSize="24" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
          <TextBlock x:Name="DoneLead" Margin="0,12,0,0" MaxWidth="520" HorizontalAlignment="Left"
                     TextWrapping="Wrap" Style="{StaticResource DimText}" />

          <Border Margin="0,24,0,0" CornerRadius="10" Background="{StaticResource Brush.Card}"
                  BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" Padding="18,14">
            <StackPanel>
              <TextBlock Text="接下来" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource DimText}"
                         Text="首次启动后，在「设置 → 游戏目录」里确认 BeamNG.drive 的安装位置；联机模组会在启动游戏时自动装入。" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="DonePath" Margin="0,16,0,0" Style="{StaticResource DimText}" TextWrapping="Wrap" />
        </StackPanel>

      </Grid>
    </Grid>

    <!-- ═══════════ 底部按钮条 ═══════════ -->
    <Border Grid.Row="2" Background="{StaticResource Brush.Footer}"
            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
      <Grid Margin="28,0">
        <TextBlock x:Name="FooterHint" VerticalAlignment="Center" Style="{StaticResource DimText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                  Margin="0,0,12,0" Click="Cancel_OnClick" />
          <Button x:Name="PrimaryButton" Content="安装" Style="{StaticResource PrimaryButton}"
                  Click="Primary_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
