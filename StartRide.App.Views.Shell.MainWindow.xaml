            <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Dialog_UserAgreementDisagreeButton}" Command="{Binding DisagreeAndExitCommand}" />
            <Button Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Margin="{StaticResource DialogTrailingButtonMargin}" Content="{x:Static res:Strings.Dialog_UserAgreementAgreeButton}" Command="{Binding AgreeCommand}" />
          </StackPanel>
        </Grid>
      </controls:DialogHost>
      <controls:FloatingMessage Panel.ZIndex="9999" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,76,0,0" Message="{Binding FloatingMessage}" IsOpen="{Binding IsFloatingMessageOpen}" />
    </Grid>
  </Border>
</Window>