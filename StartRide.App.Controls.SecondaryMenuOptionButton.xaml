<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Controls.SecondaryMenuOptionButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:controls="clr-namespace:StartRide.App.Controls" x:Name="Root" Margin="0,0,0,3" Focusable="False">
  <Button Name="PART_Button" Margin="0" Style="{StaticResource SecondaryMenuButtonStyle}" Tag="{Binding ElementName=Root}" behaviors:SecondaryMenuButtonBehavior.IsSelected="{Binding IsSelected, ElementName=Root}" Command="{Binding Command, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}" Click="Button_OnClick">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SecondaryMenuIconColumnWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
      </Grid.ColumnDefinitions>
      <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource SecondaryMenuAvatarContainerStyle}" TargetType="{x:Type Border}">
              <Setter Property="Visibility" Value="{Binding AvatarIconVisibility, ElementName=Root}" />
            </Style>
          </FrameworkElement.Style>
          <Image Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding AvatarSource, ElementName=Root}" />
        </Border>
        <controls:SvgIcon Width="{Binding IconWidth, ElementName=Root}" Height="{Binding IconHeight, ElementName=Root}" IconKey="{Binding IconKey, ElementName=Root}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type controls:SvgIcon}">
              <Setter Property="Visibility" Value="{Binding SvgIconVisibility, ElementName=Root}" />
            </Style>
          </FrameworkElement.Style>
        </controls:SvgIcon>
        <TextBlock TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Glyph, ElementName=Root}" FontFamily="{Binding GlyphFontFamily, ElementName=Root}" FontSize="{Binding GlyphFontSize, ElementName=Root}" FontWeight="{Binding GlyphFontWeight, ElementName=Root}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="{Binding GlyphIconVisibility, ElementName=Root}" />
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
      <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource SecondaryMenuItemTextStyle}" Text="{Binding Text, ElementName=Root}" Margin="{Binding TextMargin, ElementName=Root}" />
    </Grid>
  </Button>
</UserControl>