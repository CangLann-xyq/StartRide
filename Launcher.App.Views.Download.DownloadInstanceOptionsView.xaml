<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Download.DownloadInstanceOptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animation="clr-namespace:Launcher.App.Behaviors.Animation" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:models="clr-namespace:Launcher.Domain.Models;assembly=Launcher.Domain" xmlns:res="clr-namespace:Launcher.App.Resources" xmlns:viewModels="clr-namespace:Launcher.App.ViewModels.Download" Focusable="False" xmlns:download="clr-namespace:Launcher.App.Views.Download">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DownloadLoaderVersionComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource LauncherComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="Root" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" CornerRadius="7">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource Brush.List.Item.Hover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource Brush.List.Item.Selected}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DownloadLoaderVersionDropDownItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource LauncherComboBoxDropDownItemStyle}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Root" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" CornerRadius="7">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource Brush.List.Item.Hover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource Brush.List.Item.Selected}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DownloadLoaderVersionComboBoxStyle" TargetType="{x:Type controls:AnimatedComboBox}" BasedOn="{StaticResource LauncherComboBoxStyle}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DownloadLoaderVersionComboBoxItemStyle}" />
        <Setter Property="controls:AnimatedComboBox.DropDownItemContainerStyle" Value="{StaticResource DownloadLoaderVersionDropDownItemStyle}" />
      </Style>
      <DataTemplate x:Key="DownloadLoaderVersionItemTemplate" DataType="{x:Type models:LoaderVersionInfo}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="15" Foreground="{DynamicResource Brush.F4F4F4}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Version}" />
          <TextBlock Name="LoaderVersionTagText" Grid.Column="1" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.E8F4F4F4}" VerticalAlignment="Center" Text="{x:Static res:Strings.Download_LoaderVersionStableTag}" />
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Value="False" Binding="{Binding IsStable}">
            <Setter TargetName="LoaderVersionTagText" Value="{x:Static res:Strings.Download_LoaderVersionPreviewTag}" Property="TextBlock.Text" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="DownloadAddonLibraryVersionItemTemplate" DataType="{x:Type viewModels:DownloadAddonLibraryVersionOption}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="15" Foreground="{DynamicResource Brush.F4F4F4}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
          <TextBlock Name="AddonLibraryVersionTagText" Grid.Column="1" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.E8F4F4F4}" VerticalAlignment="Center" Text="{Binding TagText}" />
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Value="" Binding="{Binding TagText}">
            <Setter TargetName="AddonLibraryVersionTagText" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer Style="{StaticResource ListPageScrollViewerStyle}">
    <StackPanel Margin="12,132,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
      <TextBlock Margin="0,0,0,8" Text="{x:Static res:Strings.Download_InstanceNameLabel}" Style="{StaticResource DownloadInstanceOptionLabelTextStyle}" />
      <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,8,0,0" Style="{StaticResource DownloadInstanceOptionWarningTextStyle}" Text="{Binding InstanceNameDuplicateMessage}" />
      <TextBlock Margin="0,28,0,10" Text="{x:Static res:Strings.Download_LoaderLabel}" Style="{StaticResource DownloadInstanceOptionLabelTextStyle}" />
      <ListBox SelectionMode="Single" ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding SelectedLoaderOption, Mode=TwoWay}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource DialogChoiceListStyle}" TargetType="{x:Type ListBox}">
            <Setter Property="Margin" Value="0" />
          </Style>
        </FrameworkElement.Style>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                  <Image Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding IconSource, Converter={StaticResource IconSourceImageConverter}}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Image}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Value="" Binding="{Binding IconSource}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Image>
                  <TextBlock FontFamily="{DynamicResource LauncherIconFontFamily}" FontSize="26" Foreground="{DynamicResource Brush.F4F4F4}" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Value="" Binding="{Binding IconSource}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                  <TextBlock Style="{StaticResource DownloadLoaderOptionTitleTextStyle}" Text="{Binding Title}" />
                  <TextBlock Style="{StaticResource DownloadLoaderOptionSubtitleTextStyle}" Text="{Binding Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0" Width="200" VerticalAlignment="Center">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Value="True" Binding="{Binding IsSelected}" />
                            <Condition Value="True" Binding="{Binding DataContext.ShouldShowLoaderVersionSelector, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Grid>
                    <controls:AnimatedComboBox ItemTemplate="{StaticResource DownloadLoaderVersionItemTemplate}" Style="{StaticResource DownloadLoaderVersionComboBoxStyle}" ItemsSource="{Binding DataContext.LoaderVersions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedLoaderVersion, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding DataContext.HasLoaderVersions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Margin="12,0,34,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DataContext.LoaderVersionPlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectedLoaderVersion, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Grid>
              <Grid ClipToBounds="True">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Grid}">
                    <Setter Property="animation:AnimatedCollapse.IsExpanded" Value="False" />
                    <Setter Property="animation:AnimatedCollapse.Duration" Value="0:0:0.2" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Value="True" Binding="{Binding IsSelected}" />
                          <Condition Value="True" Binding="{Binding DataContext.ShouldShowAddonLibrarySelector, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="animation:AnimatedCollapse.IsExpanded" Value="True" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid Margin="50,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource DownloadLoaderOptionSubtitleTextStyle}" VerticalAlignment="Center" Text="{Binding DataContext.AddonLibraryLabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Grid Column="1" Margin="18,0,0,0" Width="200">
                    <controls:AnimatedComboBox ItemTemplate="{StaticResource DownloadAddonLibraryVersionItemTemplate}" Style="{StaticResource DownloadLoaderVersionComboBoxStyle}" ItemsSource="{Binding DataContext.AddonLibraryVersions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedAddonLibraryVersion, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding DataContext.IsAddonLibraryVersionSelectorEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Margin="12,0,34,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DataContext.AddonLibraryVersionPlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectedAddonLibraryVersion, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>