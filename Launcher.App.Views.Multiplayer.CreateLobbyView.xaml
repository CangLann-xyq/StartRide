<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Multiplayer.CreateLobbyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:multiplayer="clr-namespace:Launcher.App.Views.Multiplayer">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="CreateLobbyStepHost" ClipToBounds="True">
    <StackPanel Name="CreateLobbySetupLayer" Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>
      <GroupBox Header="{x:Static res:Strings.Multiplayer_SectionCreateLobby}" Style="{StaticResource LauncherContentSectionStyle}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Multiplayer_Create_OneClickHint}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
          <TextBlock Margin="0,14,0,0" Text="{x:Static res:Strings.Multiplayer_Create_StepOpenToLan}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0" Text="{x:Static res:Strings.Multiplayer_Create_StepSelectInstance}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0" Text="{x:Static res:Strings.Multiplayer_Create_StepCreateLobby}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>
      <Button Margin="0,26,0,0" HorizontalAlignment="Left" Content="{x:Static res:Strings.Multiplayer_Create_OneClickButton}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Command="{Binding CreateLobbyCommand}" />
    </StackPanel>
    <Grid Name="CreatedLobbyLayer" MinHeight="360" Opacity="0" Visibility="Collapsed">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>
      <StackPanel Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
        <controls:SvgIcon Width="64" Height="64" HorizontalAlignment="Left" IconKey="main_menu_Multiplayer" Foreground="{DynamicResource Brush.F4F4F4}" />
        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource PageTitleTextStyle}" Text="{Binding LobbyTitle}" />
        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Text="{x:Static res:Strings.Multiplayer_LobbyPoweredByTerracotta}" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="13" />
        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource LauncherDangerDialogButtonStyle}" Content="{Binding LeaveLobbyButtonText}" Command="{Binding RequestLeaveLobbyCommand}" />
        <StackPanel Margin="0,26,0,0">
          <GroupBox Header="{x:Static res:Strings.Multiplayer_LobbyRoomCodeHeader}" Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ReadOnlyFieldTextStyle}" Text="{Binding RoomCode}" />
                <Button Grid.Column="1" Margin="10,-4,-6,-4" Style="{StaticResource InlineIconButtonStyle}" Command="{Binding CopyRoomCodeCommand}">
                  <controls:SvgIcon Width="16" Height="16" IconKey="general/general_copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
              </Grid>
            </Border>
          </GroupBox>
        </StackPanel>
        <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.Multiplayer_LobbyPlayerListHeader}" Style="{StaticResource LauncherContentSectionStyle}">
          <ItemsControl ItemsSource="{Binding LobbyPlayers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:ListPageItemButton IconKey="main_menu_account" ItemMargin="0" Title="{Binding DisplayName}" Subtitle="{Binding Subtitle}" TrailingText="{Binding LatencyText}" IsFirstVisible="{Binding IsFirst}" IsLastVisible="{Binding IsLast}">
                  <controls:ListPageItemButton.TitleTrailingContent>
                    <StackPanel Orientation="Horizontal">
                      <controls:AdaptiveTagList ItemsSource="{Binding RoleTags}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type controls:AdaptiveTagList}">
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsHost}">
                                <Setter Property="controls:AdaptiveTagList.TagBackground" Value="{DynamicResource Brush.Accent.Selection}" />
                                <Setter Property="controls:AdaptiveTagList.TagForeground" Value="{DynamicResource Brush.Accent.Primary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </controls:AdaptiveTagList>
                      <controls:AdaptiveTagList TagBackground="{DynamicResource Brush.Accent.Selection}" TagForeground="{DynamicResource Brush.Accent.Primary}" ItemsSource="{Binding LocalTags}" />
                    </StackPanel>
                  </controls:ListPageItemButton.TitleTrailingContent>
                </controls:ListPageItemButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>