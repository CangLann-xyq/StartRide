<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Account.AccountPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:views="clr-namespace:Launcher.App.Views.Account" xmlns:res="clr-namespace:Launcher.App.Resources" x:Name="Root" Focusable="False">
  <Grid Name="PageRoot">
    <controls:SecondaryMenuFrame controls:SecondaryMenuOptionButton.RefreshRequested="SecondaryMenuOptionButton_OnRefreshRequested" Title="{x:Static res:Strings.Account_ListTitle}">
      <controls:SecondaryMenuFrame.MenuContent>
        <views:AccountMenuView />
      </controls:SecondaryMenuFrame.MenuContent>
    </controls:SecondaryMenuFrame>
    <Grid Name="AccountContentHost" Margin="272,36,24,8" ClipToBounds="True">
      <TextBlock Name="AccountEmptyStateView" Margin="12,0,0,0" Text="{x:Static res:Strings.Account_EmptySelection}" Style="{StaticResource PageEmptyStateTextStyle}" />
      <views:AccountDetailsView x:Name="AccountDetailsView" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" Opacity="0" Visibility="Collapsed" DataContext="{Binding Details}">
        <UIElement.RenderTransform>
          <TranslateTransform />
        </UIElement.RenderTransform>
      </views:AccountDetailsView>
    </Grid>
  </Grid>
</UserControl>