<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Replays.ReplaysPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:replays="clr-namespace:StartRide.App.ViewModels.Replays" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <!-- 模式切换按钮（回放文件 / 高光时刻）。Tag 绑"我是不是当前模式"来切换高亮外观；
         项目里 ModManagementFilterButtonStyle 就是这个套路，保持一致。 -->
    <Style x:Key="ReplaysViewModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherDialogButtonStyle}">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 高光类型筛选小按钮。MinWidth 比模式切换小得多，6 个才排得下一行（筛选行只有 32px 高）。 -->
    <Style x:Key="ReplaysHighlightChipStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherDialogButtonStyle}">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ReplaysViewModeTemplate" DataType="{x:Type replays:ReplaysPageViewModel}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="回放文件" Tag="{Binding IsReplaysMode}" Style="{StaticResource ReplaysViewModeButtonStyle}" Command="{Binding ShowReplaysViewCommand}" />
        <Button Content="高光时刻" Tag="{Binding IsHighlightsMode}" Style="{StaticResource ReplaysViewModeButtonStyle}" Command="{Binding ShowHighlightsViewCommand}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ReplaysHighlightFilterTemplate" DataType="{x:Type replays:ReplaysPageViewModel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding HighlightFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type replays:HighlightFilterChip}">
              <Button Content="{Binding Text}" Tag="{Binding IsActive}" Style="{StaticResource ReplaysHighlightChipStyle}" Command="{Binding DataContext.FilterHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" Text="{Binding HighlightStatText}" />
      </Grid>
    </DataTemplate>

    <!-- 一条高光：缩略图 + 类型与数值 + 地图与时间 + 时间码 -->
    <DataTemplate DataType="{x:Type replays:HighlightEntry}">
      <controls:ListPageItemButton IconSource="{Binding ShotImage}" IconKey="beamng/replay" IconWidth="88" IconHeight="50" IconColumnWidth="106" Title="{Binding Title}" Subtitle="{Binding Subtitle}" TrailingText="{Binding TimeCodeText}" ToolTip="{Binding DetailText}" Command="{Binding DataContext.RevealHighlightCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
        <controls:ListPageItemButton.TrailingContent>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource InlineIconButtonStyle}" ToolTip="在资源管理器中定位这段录像" IsEnabled="{Binding HasReplay}" Command="{Binding DataContext.RevealHighlightReplayCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
              <controls:SvgIcon Width="16" Height="16" IconKey="beamng/replay" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Button>
            <Button Margin="4,0,0,0" Style="{StaticResource InlineIconButtonStyle}" ToolTip="复制这条高光的信息" Command="{Binding DataContext.CopyHighlightCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
              <controls:SvgIcon Width="16" Height="16" IconKey="general/general_copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Button>
          </StackPanel>
        </controls:ListPageItemButton.TrailingContent>
      </controls:ListPageItemButton>
    </DataTemplate>
  </FrameworkElement.Resources>

  <Grid Name="PageRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:ListPageFrame Grid.Row="1" x:Name="ReplaysListFrame" Margin="24,36,24,8" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" UseFrameScrollViewer="True" Title="回放" TitleIconSource="/StartRide;component/Assets/Branding/beamng_logo_256.png" IsListVisible="True" IsSearchVisible="True" SearchText="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SearchToolbarContent="{Binding}" SearchToolbarContentTemplate="{StaticResource ReplaysViewModeTemplate}" IsSearchToolbarVisible="True" SearchFilterContent="{Binding}" SearchFilterContentTemplate="{StaticResource ReplaysHighlightFilterTemplate}" IsSearchFilterVisible="{Binding IsHighlightFilterVisible}">
      <controls:ListPageFrame.ListContent>
        <Grid Tag="ReplaysListStep">

          <!-- ① 回放文件 -->
          <Grid Visibility="{Binding IsReplaysMode, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
            <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Replays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Margin="12,20,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type replays:ReplayItem}">
                  <!-- IconKey 必须写 目录/文件名 双前缀；不写的话左侧 50px 图标列是空的 -->
                  <controls:ListPageItemButton IconKey="beamng/replay" IconWidth="30" IconHeight="30" Title="{Binding Name}" Subtitle="{Binding MapName}" TrailingText="{Binding FileSizeText}" ToolTip="点击在资源管理器中定位该回放" Command="{Binding DataContext.OpenReplayLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
            <TextBlock Margin="12,20,0,0" Text="{Binding StatusMessage}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>

          <!-- ② 高光时刻 -->
          <Grid Visibility="{Binding IsHighlightsMode, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
            <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Highlights}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Margin="12,20,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ListBox>
            <TextBlock Margin="12,20,0,0" Text="{Binding HighlightsEmptyText}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </Grid>
      </controls:ListPageFrame.ListContent>
    </controls:ListPageFrame>

    <!-- 空状态引导卡片：无回放时引导打开游戏回放功能（覆盖在列表之上）。高光模式下不显示。 -->
    <Border Grid.Row="1" Margin="36,190,36,8" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520" Visibility="{Binding NeedsGuide, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Border.Style>
        <Style BasedOn="{StaticResource ReadOnlyFieldSurfaceStyle}" TargetType="{x:Type Border}">
          <Setter Property="Padding" Value="32,28" />
        </Style>
      </Border.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:SvgIcon Width="26" Height="26" IconKey="beamng/replay" Foreground="{DynamicResource Brush.Accent.Primary}" VerticalAlignment="Center" />
          <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="还没有回放" />
        </StackPanel>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="BeamNG.drive 内置回放功能。启动游戏进入任意地图后，按 Esc 打开菜单选择「Replay / 回放」即可录制并保存回放。保存的回放会出现在这里。" />
        <Button Margin="0,20,0,0" HorizontalAlignment="Left" MinWidth="180" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="启动游戏并打开回放" Command="{Binding OpenGameForReplayCommand}" />
      </StackPanel>
    </Border>

    <!-- 高光为空时的引导卡片 -->
    <Border Grid.Row="1" Margin="36,190,36,8" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560">
      <Border.Style>
        <Style BasedOn="{StaticResource ReadOnlyFieldSurfaceStyle}" TargetType="{x:Type Border}">
          <Setter Property="Padding" Value="32,28" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHighlightsMode}" Value="True" />
                <Condition Binding="{Binding NoHighlights}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:SvgIcon Width="26" Height="26" IconKey="beamng/replay" Foreground="{DynamicResource Brush.Accent.Primary}" VerticalAlignment="Center" />
          <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="还没有高光记录" />
        </StackPanel>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="13" LineHeight="21" TextWrapping="Wrap">
          <Run Text="联机跑一局就会有了：上车后会自动开始录制，大跳跃、重击、翻车、烧胎、破纪录的极速都会自动抓一张截图、记下时间码，整局结束时汇总成一份" />
          <Run Text="高光回放" FontWeight="SemiBold" />
          <Run Text="。" />
        </TextBlock>
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Text="这份记录写在游戏的回放目录下（replays/startride），启动器只读它，不会上传任何东西。" />
        <WrapPanel Margin="0,20,0,0">
          <Button MinWidth="180" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="启动游戏去跑一局" Command="{Binding OpenGameForReplayCommand}" />
          <Button Margin="10,0,0,0" MinWidth="140" Style="{StaticResource LauncherDialogButtonStyle}" Content="打开高光目录" Command="{Binding OpenHighlightsFolderCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
