<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Replays.ReplaysPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StartRide.App.Resources" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:replays="clr-namespace:StartRide.App.ViewModels.Replays" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <!-- 模式切换按钮（回放文件 / 高光时刻）。Tag 绑"我是不是当前模式"来切换高亮外观；
         项目里 ModManagementFilterButtonStyle 就是这个套路，保持一致。 -->
    <Style x:Key="ReplaysViewModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherDialogButtonStyle}">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 高光类型筛选小按钮。MinWidth 比模式切换小得多，6 个才排得下一行（筛选行只有 32px 高）。 -->
    <Style x:Key="ReplaysHighlightChipStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LauncherDialogButtonStyle}">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
          <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ReplaysViewModeTemplate" DataType="{x:Type replays:ReplaysPageViewModel}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{x:Static res:Strings.Replays_ModeReplayFiles}" Tag="{Binding IsReplaysMode}" Style="{StaticResource ReplaysViewModeButtonStyle}" Command="{Binding ShowReplaysViewCommand}" />
        <Button Content="{x:Static res:Strings.Page_Highlights}" Tag="{Binding IsHighlightsMode}" Style="{StaticResource ReplaysViewModeButtonStyle}" Command="{Binding ShowHighlightsViewCommand}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ReplaysHighlightFilterTemplate" DataType="{x:Type replays:ReplaysPageViewModel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding HighlightFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type replays:HighlightFilterChip}">
              <Button Content="{Binding Text}" Tag="{Binding IsActive}" Style="{StaticResource ReplaysHighlightChipStyle}" Command="{Binding DataContext.FilterHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" Text="{Binding HighlightStatText}" />
      </Grid>
    </DataTemplate>

    <!-- 一条高光：缩略图 + 类型与数值 + 地图与时间 + 时间码 -->
    <DataTemplate DataType="{x:Type replays:HighlightEntry}">
      <controls:ListPageItemButton IconSource="{Binding ShotImage}" IconWidth="88" IconHeight="50" IconColumnWidth="106" Title="{Binding Title}" Subtitle="{Binding Subtitle}" TrailingText="{Binding TimeCodeText}" ToolTip="{Binding DetailText}" Command="{Binding DataContext.RevealHighlightCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
        <controls:ListPageItemButton.TrailingContent>
          <StackPanel Orientation="Horizontal">
            <!-- 这里原本还有一个圆形的 ▶ 按钮（在资源管理器中定位这段 .rpl 录像）；
                 用户觉得它多余，已去掉。定位截图仍可双击整条高光（RevealHighlightCommand）。 -->
            <Button Style="{StaticResource InlineIconButtonStyle}" ToolTip="{x:Static res:Strings.Replays_CopyHighlightTooltip}" Command="{Binding DataContext.CopyHighlightCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
              <controls:SvgIcon Width="16" Height="16" IconKey="general/general_copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Button>
          </StackPanel>
        </controls:ListPageItemButton.TrailingContent>
      </controls:ListPageItemButton>
    </DataTemplate>
  </FrameworkElement.Resources>

  <Grid Name="PageRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:ListPageFrame Grid.Row="1" x:Name="ReplaysListFrame" Margin="24,36,24,8" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" UseFrameScrollViewer="True" Title="{Binding HeaderTitle}" TitleIconSource="/StartRide;component/Assets/Branding/beamng_logo_256.png" IsListVisible="True" IsSearchVisible="True" SearchText="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SearchToolbarContent="{Binding}" SearchToolbarContentTemplate="{StaticResource ReplaysViewModeTemplate}" IsSearchToolbarVisible="True" SearchFilterContent="{Binding}" SearchFilterContentTemplate="{StaticResource ReplaysHighlightFilterTemplate}" IsSearchFilterVisible="{Binding IsHighlightFilterVisible}">
      <controls:ListPageFrame.ListContent>
        <Grid Tag="ReplaysListStep">

          <!-- ① 回放文件 -->
          <Grid Visibility="{Binding IsReplaysMode, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
            <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Replays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Margin="12,20,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type replays:ReplayItem}">
                  <!-- IconKey 必须写 目录/文件名 双前缀；不写的话左侧 50px 图标列是空的 -->
                  <controls:ListPageItemButton IconKey="beamng/replay" IconWidth="30" IconHeight="30" Title="{Binding Name}" Subtitle="{Binding MapName}" TrailingText="{Binding FileSizeText}" ToolTip="{x:Static res:Strings.Replays_ReplayItemTooltip}" Command="{Binding DataContext.OpenReplayLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
            <TextBlock Margin="12,20,0,0" Text="{Binding StatusMessage}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>

          <!-- ② 高光时刻 -->
          <Grid Visibility="{Binding IsHighlightsMode, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
            <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Highlights}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Margin="12,20,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ListBox>
            <TextBlock Margin="12,20,0,0" Text="{Binding HighlightsEmptyText}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </Grid>
      </controls:ListPageFrame.ListContent>
    </controls:ListPageFrame>

    <!-- 空状态引导卡片：无回放时引导打开游戏回放功能（覆盖在列表之上）。高光模式下不显示。 -->
    <Border Grid.Row="1" Margin="36,190,36,8" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520" Visibility="{Binding NeedsGuide, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Border.Style>
        <Style BasedOn="{StaticResource ReadOnlyFieldSurfaceStyle}" TargetType="{x:Type Border}">
          <Setter Property="Padding" Value="32,28" />
        </Style>
      </Border.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:SvgIcon Width="26" Height="26" IconKey="beamng/replay" Foreground="{DynamicResource Brush.Accent.Primary}" VerticalAlignment="Center" />
          <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Strings.Replays_EmptyReplaysTitle}" />
        </StackPanel>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="{x:Static res:Strings.Replays_EmptyReplaysBody}" />
        <Button Margin="0,20,0,0" HorizontalAlignment="Left" MinWidth="180" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{x:Static res:Strings.Replays_EmptyReplaysAction}" Command="{Binding OpenGameForReplayCommand}" />
      </StackPanel>
    </Border>

    <!-- 高光为空时的引导卡片 -->
    <Border Grid.Row="1" Margin="36,190,36,8" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560">
      <Border.Style>
        <Style BasedOn="{StaticResource ReadOnlyFieldSurfaceStyle}" TargetType="{x:Type Border}">
          <Setter Property="Padding" Value="32,28" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHighlightsMode}" Value="True" />
                <Condition Binding="{Binding NoHighlights}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:SvgIcon Width="26" Height="26" IconKey="beamng/replay" Foreground="{DynamicResource Brush.Accent.Primary}" VerticalAlignment="Center" />
          <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Strings.Replays_EmptyHighlightsTitle}" />
        </StackPanel>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="13" LineHeight="21" TextWrapping="Wrap">
          <Run Text="{x:Static res:Strings.Replays_EmptyHighlightsBodyPrefix}" />
          <Run Text="{x:Static res:Strings.Replays_EmptyHighlightsBodyBold}" FontWeight="SemiBold" />
          <Run Text="{x:Static res:Strings.Replays_EmptyHighlightsBodySuffix}" />
        </TextBlock>
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Text="{x:Static res:Strings.Replays_EmptyHighlightsNote}" />
        <WrapPanel Margin="0,20,0,0">
          <Button MinWidth="180" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{x:Static res:Strings.Replays_EmptyHighlightsAction}" Command="{Binding OpenGameForReplayCommand}" />
          <Button Margin="10,0,0,0" MinWidth="140" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Replays_OpenHighlightsFolderButton}" Command="{Binding OpenHighlightsFolderCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
