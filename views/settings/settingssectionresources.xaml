<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" xmlns:settings="clr-namespace:StartRide.App.ViewModels.Settings">
  <Style x:Key="SettingsOptionTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SettingsFieldLabelStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="SettingsDescriptionTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <DataTemplate x:Key="JavaSelectionOptionTemplate">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <DataTemplate x:Key="DownloadSourceOptionTemplate" DataType="{x:Type settings:SettingsDownloadSourceOption}">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <DataTemplate x:Key="UpdateChannelOptionTemplate" DataType="{x:Type settings:SettingsUpdateChannelOption}">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <DataTemplate x:Key="ThemeOptionTemplate" DataType="{x:Type settings:SettingsThemeOption}">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <DataTemplate x:Key="BackgroundEffectOptionTemplate" DataType="{x:Type settings:SettingsBackgroundEffectOption}">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <DataTemplate x:Key="LanguageOptionTemplate" DataType="{x:Type settings:SettingsLanguageOption}">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <Style x:Key="AccentColorPreviewEllipseStyle" TargetType="{x:Type Ellipse}">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Blue}" />
    <Style.Triggers>
      <DataTrigger Value="Cyan" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Cyan}" />
      </DataTrigger>
      <DataTrigger Value="Green" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Green}" />
      </DataTrigger>
      <DataTrigger Value="Emerald" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Emerald}" />
      </DataTrigger>
      <DataTrigger Value="Purple" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Purple}" />
      </DataTrigger>
      <DataTrigger Value="Pink" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Pink}" />
      </DataTrigger>
      <DataTrigger Value="Orange" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Orange}" />
      </DataTrigger>
      <DataTrigger Value="Amber" Binding="{Binding Id}">
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Amber}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="AccentColorOptionTemplate" DataType="{x:Type settings:SettingsAccentColorOption}">
    <StackPanel Orientation="Horizontal">
      <Ellipse Style="{StaticResource AccentColorPreviewEllipseStyle}" />
      <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
    </StackPanel>
  </DataTemplate>
  <Style x:Key="SettingsChoiceListBoxStyle" TargetType="{x:Type ListBox}">
    <Setter Property="Margin" Value="0,10,0,0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
    <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="JavaRuntimeListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource SettingsChoiceListBoxStyle}" />
  <Style x:Key="SettingsChoiceListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource DialogChoiceItemStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="JavaRuntimeListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SettingsChoiceListBoxItemStyle}">
    <Setter Property="UIElement.IsHitTestVisible" Value="{Binding DataContext.IsJavaManualSelection, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
  </Style>
  <DataTemplate x:Key="JavaRuntimeItemTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding DisplayName}" />
        <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Text="{Binding VersionText}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Foreground="{DynamicResource Brush.CFFFFFFF}" FontSize="12" VerticalAlignment="Center" Text="{Binding Architecture}" />
      </StackPanel>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource Brush.AFFFFFFF}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding ExecutablePath}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="MinecraftDirectoryItemTemplate" DataType="{x:Type settings:SettingsMinecraftDirectoryItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock behaviors:TextOverflowToolTip.IsEnabled="True" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" />
        <TextBlock Margin="0,4,0,0" behaviors:TextOverflowToolTip.IsEnabled="True" Foreground="{DynamicResource Brush.AFFFFFFF}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding DirectoryPath}" ToolTip="{Binding DirectoryPath}" />
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource LauncherDangerBrush}" FontSize="12" Text="{Binding AvailabilityText}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding IsAvailable}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="UIElement.Opacity" Value="0" />
            <Setter Property="UIElement.IsHitTestVisible" Value="False" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                <Setter Property="UIElement.Opacity" Value="1" />
                <Setter Property="UIElement.IsHitTestVisible" Value="True" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Button ToolTip="{x:Static res:Strings.Settings_RenameMinecraftDirectoryButton}" Style="{StaticResource InlineIconButtonStyle}" Command="{Binding DataContext.RequestRenameMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
          <controls:SvgIcon Width="16" Height="16" IconKey="general/general_edit" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Margin="4,0,0,0" ToolTip="{x:Static res:Strings.Settings_OpenMinecraftDirectoryButton}" Style="{StaticResource InlineIconButtonStyle}" IsEnabled="{Binding IsAvailable}" Command="{Binding DataContext.OpenMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
          <controls:SvgIcon Width="16" Height="16" IconKey="general/general_folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Margin="4,0,0,0" ToolTip="{x:Static res:Strings.Settings_RemoveMinecraftDirectoryFromListButton}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource SecondaryMenuDeleteButtonStyle}" Command="{Binding DataContext.RequestRemoveMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}">
          <controls:SvgIcon Width="16" Height="16" IconKey="setting_page/remove_folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="InteractiveControlItemTemplate" DataType="{x:Type settings:SettingsInteractiveControlItem}">
    <StackPanel>
      <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
      <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Category}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>