<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors">
  <Style x:Key="SettingsOptionTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ManagementListSectionHeaderTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.A8FFFFFF}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <DataTemplate x:Key="InstanceJavaSelectionOptionTemplate">
    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
  </DataTemplate>
  <Style x:Key="InstanceJavaRuntimeListBoxStyle" TargetType="{x:Type ListBox}">
    <Setter Property="Margin" Value="0,10,0,0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
    <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
    <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InstanceJavaRuntimeListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource DialogChoiceItemStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="UIElement.IsHitTestVisible" Value="{Binding DataContext.CanInteractWithInstanceJavaRuntimeList, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
  </Style>
  <DataTemplate x:Key="InstanceJavaRuntimeItemTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding DisplayName}" />
        <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Text="{Binding VersionText}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Foreground="{DynamicResource Brush.CFFFFFFF}" FontSize="12" VerticalAlignment="Center" Text="{Binding Architecture}" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource Brush.AFFFFFFF}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding ExecutablePath}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>