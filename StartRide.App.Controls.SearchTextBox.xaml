<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Controls.SearchTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" x:Name="Root" Height="{StaticResource LauncherCompactControlHeight}" Focusable="False">
  <Grid>
    <TextBox Name="PART_TextBox" Padding="32,0,7,0" Style="{StaticResource LauncherDialogTextBoxStyle}" Tag="{Binding Tag, ElementName=Root}" Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <controls:SvgIcon Width="15" Height="15" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.70FFFFFF}" IconKey="general/general_search" IsHitTestVisible="False" />
    <TextBlock Margin="32,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Brush.70FFFFFF}" IsHitTestVisible="False" Text="{x:Static res:Strings.Search_Placeholder}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="" Binding="{Binding Text, ElementName=PART_TextBox}" />
                <Condition Value="False" Binding="{Binding IsKeyboardFocusWithin, ElementName=PART_TextBox}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
  </Grid>
</UserControl>