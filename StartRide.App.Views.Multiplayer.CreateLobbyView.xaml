<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Multiplayer.CreateLobbyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:multiplayer="clr-namespace:StartRide.App.ViewModels.Multiplayer" xmlns:views="clr-namespace:StartRide.App.Views.Multiplayer">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 地图行：名字 + 游戏自带的介绍 + 出生点数量 -->
      <DataTemplate x:Key="CreateLobbyLevelItemTemplate" DataType="{x:Type multiplayer:LevelOptionItem}">
        <controls:ListPageItemButton ItemMargin="0" IconKey="beamng/map" IconWidth="19" IconHeight="19" IconColumnWidth="46" IconMargin="8,0,0,0" IconTileBackground="#12FFFFFF" IconTileBorderBrush="#1FFFFFFF" IconTileBorderThickness="1" IconTilePadding="8" IconTileCornerRadius="10" Title="{Binding Name}" Subtitle="{Binding Subtitle}" TrailingText="{Binding Meta}" IsSelected="{Binding IsSelected}" IsFirstVisible="{Binding IsFirst}" IsLastVisible="{Binding IsLast}" Command="{Binding DataContext.SelectLobbyLevelCommand, RelativeSource={RelativeSource AncestorType={x:Type views:CreateLobbyView}}}" CommandParameter="{Binding}">
          <controls:ListPageItemButton.TitleTrailingContent>
            <controls:AdaptiveTagList ItemsSource="{Binding LocalTags}" TagBackground="{DynamicResource Brush.Accent.Selection}" TagForeground="{DynamicResource Brush.Accent.Primary}" />
          </controls:ListPageItemButton.TitleTrailingContent>
        </controls:ListPageItemButton>
      </DataTemplate>

      <!-- 出生点行：游戏自己给的出生点名字与说明 -->
      <DataTemplate x:Key="CreateLobbySpawnItemTemplate" DataType="{x:Type multiplayer:SpawnOptionItem}">
        <controls:ListPageItemButton ItemMargin="0" IconKey="general/general_pin" IconWidth="18" IconHeight="18" IconColumnWidth="44" IconMargin="8,0,0,0" IconTileBackground="#12FFFFFF" IconTileBorderBrush="#1FFFFFFF" IconTileBorderThickness="1" IconTilePadding="8" IconTileCornerRadius="10" Title="{Binding Name}" Subtitle="{Binding Subtitle}" IsSelected="{Binding IsSelected}" IsFirstVisible="{Binding IsFirst}" IsLastVisible="{Binding IsLast}" Command="{Binding DataContext.SelectLobbySpawnCommand, RelativeSource={RelativeSource AncestorType={x:Type views:CreateLobbyView}}}" CommandParameter="{Binding}">
          <controls:ListPageItemButton.TitleTrailingContent>
            <controls:AdaptiveTagList ItemsSource="{Binding LocalTags}" TagBackground="{DynamicResource Brush.Accent.Selection}" TagForeground="{DynamicResource Brush.Accent.Primary}" />
          </controls:ListPageItemButton.TitleTrailingContent>
        </controls:ListPageItemButton>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Name="CreateLobbyStepHost" ClipToBounds="True">

    <!-- ── 建房设置：地图 + 出生位置 ───────────────────────────────────── -->
    <StackPanel Name="CreateLobbySetupLayer" Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>

      <DockPanel LastChildFill="False" Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Lobby_LevelRescanButton}" ToolTip="{x:Static res:Strings.Lobby_LevelRefreshHint}" Command="{Binding RescanLobbyLevelsCommand}" />
        <TextBlock VerticalAlignment="Center" Style="{StaticResource RidePageSubtitleTextStyle}" Text="{x:Static res:Strings.Lobby_CreateHint}" />
      </DockPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="380" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 地图 -->
        <Border Grid.Column="0" Style="{StaticResource RideDetailSurfaceStyle}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{x:Static res:Strings.Lobby_MapSectionTitle}" />
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{Binding SelectedLobbyLevelMeta}" />
            </DockPanel>
            <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_MapHint}" />

            <!-- 选中地图的实拍图 + 完整介绍。
                 缩略图固定 16:9（224x126）：游戏自带的预览多半是 4:3，
                 横着铺满整张卡片会把画面压成一条天空带，16:9 正好裁在画面主体上。 -->
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Width="224" Height="126" CornerRadius="11" ClipToBounds="True" Background="{DynamicResource Brush.14FFFFFF}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding HasSelectedLobbyLevelPreview}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Image Source="{Binding SelectedLobbyLevelPreview}" Stretch="UniformToFill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>

              <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" MaxHeight="76" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding SelectedLobbyLevelDescription}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding HasSelectedLobbyLevelDescription}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>

            <Border Margin="0,12,0,10" Style="{StaticResource RideHairlineStyle}" />

            <ListBox Style="{StaticResource RideWideListBoxStyle}" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" MaxHeight="330" ItemsSource="{Binding LobbyLevels}" ItemTemplate="{StaticResource CreateLobbyLevelItemTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" />

            <TextBlock Margin="2,8,2,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_LevelNoneFound}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="0" Binding="{Binding LobbyLevels.Count}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- 出生位置 -->
        <Border Grid.Column="2" Style="{StaticResource RideDetailSurfaceStyle}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{x:Static res:Strings.Lobby_SpawnSectionTitle}" />
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Accent.Primary}" Text="{Binding SelectedLobbySpawnName}" />
            </DockPanel>
            <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_SpawnHostHint}" />

            <Border Margin="0,12,0,10" Style="{StaticResource RideHairlineStyle}" />

            <ListBox Style="{StaticResource RideWideListBoxStyle}" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" MaxHeight="400" ItemsSource="{Binding LobbySpawns}" ItemTemplate="{StaticResource CreateLobbySpawnItemTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" />

            <TextBlock Margin="2,8,2,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_NoSpawnForLevel}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding HasLobbySpawns}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>

            <!-- 人数上限：房主定，含自己在内。建房前改的是「待用值」，建房后还能在房间面板里改。 -->
            <Border Margin="0,14,0,10" Style="{StaticResource RideHairlineStyle}" />

            <DockPanel LastChildFill="False">
              <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{x:Static res:Strings.Lobby_CapacitySectionTitle}" />
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Accent.Primary}" Text="{Binding LobbyCapacityText}" />
            </DockPanel>
            <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_CapacityHint}" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button MinWidth="52" Height="34" Style="{StaticResource LauncherDialogButtonStyle}" Content="−" ToolTip="{x:Static res:Strings.Lobby_CapacityDecreaseButton}" Command="{Binding DecreaseCapacityCommand}" />
              <TextBlock Margin="14,0,14,0" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{Binding LobbyCapacity}" />
              <Button MinWidth="52" Height="34" Style="{StaticResource LauncherDialogButtonStyle}" Content="+" ToolTip="{x:Static res:Strings.Lobby_CapacityIncreaseButton}" Command="{Binding IncreaseCapacityCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <DockPanel LastChildFill="False" Margin="0,16,0,0">
        <Button DockPanel.Dock="Left" HorizontalAlignment="Left" MinWidth="168" Content="{x:Static res:Strings.Lobby_CreateRoomButton}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Command="{Binding CreateLobbyCommand}" />
        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_LobbyMapNote}" />
      </DockPanel>
    </StackPanel>
    <!-- ── 建房成功后的房间面板 ───────────────────────────────────────── -->
    <Grid Name="CreatedLobbyLayer" MinHeight="360" Opacity="0" Visibility="Collapsed">
      <UIElement.RenderTransform>
        <TranslateTransform />
      </UIElement.RenderTransform>
      <StackPanel Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">

        <DockPanel LastChildFill="False" Margin="0,0,0,14">
          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LauncherDangerDialogButtonStyle}" Content="{Binding LeaveLobbyButtonText}" Command="{Binding RequestLeaveLobbyCommand}" />
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Width="22" Height="22" Margin="0,0,11,0" VerticalAlignment="Center" IconKey="main_menu_multiplayer" Foreground="{DynamicResource Brush.Text.Strong}" />
            <TextBlock Style="{StaticResource RidePageTitleTextStyle}" Text="{Binding LobbyTitle}" />
          </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource RideDetailSurfaceStyle}" Margin="0,0,0,14">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Lobby_CopyCodeButton}" Command="{Binding CopyRoomCodeCommand}" />
            <StackPanel>
              <TextBlock Text="{x:Static res:Strings.Multiplayer_LobbyRoomCodeHeader}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" />
              <TextBlock Margin="0,6,0,0" Text="{Binding RoomCode}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource RideStatStripStyle}" Margin="0,0,0,14">
          <DockPanel LastChildFill="False">
            <Border Style="{StaticResource RideStatChipStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Lobby_JoinedMapLabel}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource RideStatChipValueStyle}" Text="{Binding LobbyMapText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RideStatChipStyle}" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Lobby_JoinedSpawnLabel}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource RideStatChipValueStyle}" Text="{Binding LobbySpawnText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RideStatChipStyle}" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Lobby_CapacitySectionTitle}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource RideStatChipValueStyle}" Text="{Binding LobbyCapacitySummary}" />
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>

        <!-- 房主专属：房间已经建好了，还能在这里调整人数上限（走 set-capacity，不重开房间）。 -->
        <Border Margin="0,0,0,14">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource RideDetailSurfaceStyle}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsLobbyHost}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button MinWidth="48" Height="34" Style="{StaticResource LauncherDialogButtonStyle}" Content="−" ToolTip="{x:Static res:Strings.Lobby_CapacityDecreaseButton}" Command="{Binding DecreaseCapacityCommand}" />
              <TextBlock Margin="14,0,14,0" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{Binding LobbyCapacity}" />
              <Button MinWidth="48" Height="34" Style="{StaticResource LauncherDialogButtonStyle}" Content="+" ToolTip="{x:Static res:Strings.Lobby_CapacityIncreaseButton}" Command="{Binding IncreaseCapacityCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}" Text="{x:Static res:Strings.Lobby_CapacitySectionTitle}" />
              <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Lobby_CapacityHint}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource RideListSurfaceStyle}" MinHeight="160">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="12,8,12,6" LastChildFill="False">
              <TextBlock Text="{x:Static res:Strings.Multiplayer_LobbyPlayerListHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Multiplayer_LobbyPlayerListNote}" />
            </DockPanel>
            <ItemsControl Grid.Row="1" Margin="4,0,4,6" ItemsSource="{Binding LobbyPlayers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <controls:ListPageItemButton IconKey="main_menu_account" ItemMargin="0" Title="{Binding DisplayName}" Subtitle="{Binding Subtitle}" TrailingText="{Binding LatencyText}" IsFirstVisible="{Binding IsFirst}" IsLastVisible="{Binding IsLast}">
                    <controls:ListPageItemButton.TitleTrailingContent>
                      <StackPanel Orientation="Horizontal">
                        <controls:AdaptiveTagList ItemsSource="{Binding RoleTags}">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type controls:AdaptiveTagList}">
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsHost}">
                                  <Setter Property="controls:AdaptiveTagList.TagBackground" Value="{DynamicResource Brush.Accent.Selection}" />
                                  <Setter Property="controls:AdaptiveTagList.TagForeground" Value="{DynamicResource Brush.Accent.Primary}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </controls:AdaptiveTagList>
                        <controls:AdaptiveTagList TagBackground="{DynamicResource Brush.Accent.Selection}" TagForeground="{DynamicResource Brush.Accent.Primary}" ItemsSource="{Binding LocalTags}" />
                      </StackPanel>
                    </controls:ListPageItemButton.TitleTrailingContent>
                  </controls:ListPageItemButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
