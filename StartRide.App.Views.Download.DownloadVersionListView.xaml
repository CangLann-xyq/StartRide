<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Download.DownloadVersionListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:views="clr-namespace:StartRide.App.Views.Download" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" Focusable="False">
  <ListBox Name="DownloadVersionListBox" ItemContainerStyle="{StaticResource DownloadVersionListBoxItemStyle}" Style="{StaticResource DownloadVersionListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" behaviors:VirtualizedListItemStateBehavior.IsEnabled="True" behaviors:VirtualizedListItemStateBehavior.ContentTopOffset="132" ItemsSource="{Binding VisibleVersions}" SelectedItem="{Binding SelectedMinecraftVersion, Mode=OneWay}" behaviors:VirtualizedListItemStateBehavior.EntranceAnimationToken="{Binding ListEntranceAnimationToken}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel Margin="12,132,0,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <controls:ListPageItemButton Style="{StaticResource DownloadVersionListItemButtonEntranceStyle}" Title="{Binding Name}" Subtitle="{Binding TypeLabel}" TrailingText="{Binding ReleaseDateText}" IconSource="{Binding IconSource}" IsSelected="{Binding IsSelected}" IsFirstVisible="{Binding Tag.IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsLastVisible="{Binding Tag.IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsPreviousItemHighlighted="{Binding Tag.IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" ShouldPlayEnterAnimation="{Binding Tag.ShouldPlayEnterAnimation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" EnterAnimationIndex="{Binding Tag.EnterAnimationIndex, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Command="{Binding DataContext.SelectMinecraftVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type views:DownloadVersionListView}}}" CommandParameter="{Binding}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ListBox>
</UserControl>