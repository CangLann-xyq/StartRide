<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Settings.LaunchMemorySettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" Focusable="False" xmlns:res="clr-namespace:Launcher.App.Resources" xmlns:settings="clr-namespace:Launcher.App.Views.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <controls:LaunchSettingsEditor ShowModeSelector="False" AreLaunchSettingsOverridesEnabled="True" ShowMemorySettings="True" MemorySettingsModeOptions="{Binding MemoryModeOptions}" SelectedMemorySettingsModeOption="{Binding SelectedMemoryModeOption, Mode=TwoWay}" MemoryMb="{Binding DefaultMemoryMb, Mode=TwoWay}" MemoryMinimumMb="{Binding MemorySliderMinimumMb}" MemoryMaximumMb="{Binding MemorySliderMaximumMb}" IsMemorySliderEnabled="{Binding IsMemorySliderEnabled}" IsMemorySliderVisible="{Binding IsMemorySliderVisible}" IsAutomaticMemorySummaryVisible="{Binding IsAutomaticMemorySummaryVisible}" AutomaticMemoryText="{Binding AutomaticMemoryText}" MemoryValueText="{Binding DefaultMemoryText}" SystemMemorySummaryText="{Binding SystemMemorySummaryText}" CanEditAutoRepairMissingFiles="{Binding DefaultCheckFilesBeforeLaunch}" LaunchCheckFilesBeforeLaunchEnabled="{Binding DefaultCheckFilesBeforeLaunch, Mode=TwoWay}" LaunchAutoRepairMissingFilesEnabled="{Binding DefaultAutoRepairMissingFiles, Mode=TwoWay}" LaunchMinimizeLauncherAfterLaunchEnabled="{Binding DefaultMinimizeLauncherAfterLaunch, Mode=TwoWay}" LaunchFullScreenEnabled="{Binding DefaultLaunchFullScreen, Mode=TwoWay}" LaunchAutoJoinServerAddress="{Binding DefaultAutoJoinServerAddress, Mode=TwoWay}" LaunchPreLaunchCommand="{Binding DefaultPreLaunchCommand, Mode=TwoWay}" LaunchWaitForPreLaunchCommand="{Binding DefaultWaitForPreLaunchCommand, Mode=TwoWay}" LaunchPostExitCommand="{Binding DefaultPostExitCommand, Mode=TwoWay}" LaunchJvmArguments="{Binding DefaultJvmArguments, Mode=TwoWay}" LaunchGameArguments="{Binding DefaultGameArguments, Mode=TwoWay}" />

    <!-- 本机内存条：原来只有「总内存/可用」，看不到插了几根、什么频率 -->
    <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.Settings_MemoryHardwareSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding MemorySlotSummaryText}" Style="{StaticResource SettingsOptionTextStyle}" />
              <TextBlock Margin="0,6,0,0" Text="{Binding MemoryTotalSummaryText}" Style="{StaticResource SettingsDescriptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_MemoryRefreshButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding RefreshMemoryHardwareCommand}" />
          </Grid>
          <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding MemoryModules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" Text="{Binding Title}" />
                  <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.AFFFFFFF}" FontSize="11" Text="{Binding Subtitle}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </GroupBox>

    <!-- 真实内存上限：作业对象施加到游戏进程，不是只记个数字 -->
    <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.Settings_MemoryLimitLabel}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Settings_MemoryLimitDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_MemoryLimitLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LimitGameMemory, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>
