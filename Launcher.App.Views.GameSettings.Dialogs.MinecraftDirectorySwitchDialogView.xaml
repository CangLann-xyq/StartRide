<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.GameSettings.Dialogs.MinecraftDirectorySwitchDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:res="clr-namespace:Launcher.App.Resources" xmlns:settings="clr-namespace:Launcher.App.ViewModels.Settings" Focusable="False" xmlns:dialogs="clr-namespace:Launcher.App.Views.GameSettings.Dialogs">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="MinecraftDirectorySwitchItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SettingsChoiceListBoxItemStyle}">
        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
      </Style>
      <DataTemplate x:Key="MinecraftDirectorySwitchItemTemplate" DataType="{x:Type settings:SettingsMinecraftDirectoryItem}">
        <StackPanel>
          <TextBlock behaviors:TextOverflowToolTip.IsEnabled="True" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" />
          <TextBlock Margin="0,4,0,0" behaviors:TextOverflowToolTip.IsEnabled="True" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding DirectoryPath}" ToolTip="{Binding DirectoryPath}" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource LauncherDangerBrush}" FontSize="12" Text="{Binding AvailabilityText}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsAvailable}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Style="{StaticResource DialogContentGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{x:Static res:Strings.Dialog_SwitchMinecraftDirectoryTitle}" Style="{StaticResource DialogTitleTextStyle}" />
    <StackPanel Grid.Row="1" Margin="0,16,0,24">
      <TextBlock Text="{x:Static res:Strings.Settings_MinecraftDirectoryListLabel}" Style="{StaticResource DialogBodyTextStyle}" />
      <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.Settings_MinecraftDirectoryChangeBlockedByActiveTasks}" Foreground="{DynamicResource LauncherDangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding IsChangeBlockedByActiveTasks, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <ListBox Name="DirectoryListBox" MaxHeight="360" ItemTemplate="{StaticResource MinecraftDirectorySwitchItemTemplate}" ItemContainerStyle="{StaticResource MinecraftDirectorySwitchItemStyle}" Style="{StaticResource SettingsChoiceListBoxStyle}" ItemsSource="{Binding Directories}" SelectedItem="{Binding SelectedDirectory, Mode=TwoWay}" PreviewMouseLeftButtonDown="DirectoryListBox_PreviewMouseLeftButtonDown" PreviewKeyDown="DirectoryListBox_PreviewKeyDown" SelectionChanged="DirectoryListBox_SelectionChanged" />
    </StackPanel>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
      <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding CancelCommand}" />
      <Button Margin="{StaticResource DialogTrailingButtonMargin}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{x:Static res:Strings.Confirm_Button}" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </Grid>
</UserControl>