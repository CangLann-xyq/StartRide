<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Settings.LanguageSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:settings="clr-namespace:Launcher.App.Views.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <GroupBox Header="{x:Static res:Strings.Settings_LanguageSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <StackPanel>
        <Border Style="{StaticResource SectionFieldSurfaceStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_LauncherLanguageLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource LanguageOptionTemplate}" SelectionItemTemplate="{StaticResource LanguageOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
          </Grid>
        </Border>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.Text.Danger}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LanguageRestartNoticeText}" Visibility="{Binding IsLanguageRestartNoticeVisible, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      </StackPanel>
    </GroupBox>
    <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.Settings_GameLanguageSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static res:Strings.Settings_AutoSetGameLanguageToLauncherLanguageLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
          <CheckBox Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding AutoSetGameLanguageToLauncherLanguage, Mode=TwoWay}" />
        </Grid>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>