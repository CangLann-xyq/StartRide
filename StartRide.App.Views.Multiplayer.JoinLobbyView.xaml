<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Multiplayer.JoinLobbyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:multiplayer="clr-namespace:StartRide.App.ViewModels.Multiplayer" xmlns:views="clr-namespace:StartRide.App.Views.Multiplayer">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <!-- StartRide 自有版式：页头（图标 + 标题 + 说明 + 动作）→ 统计条 → 列表卡面。
       原版这里是「分组框标题 + 又一个大标题」两层重复，中间还夹一个只装一句说明的
       空分组框，是原版套模板的痕迹。 -->
  <StackPanel Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">

    <!-- ① 页头 -->
    <DockPanel LastChildFill="False" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Multiplayer_Join_RefreshButton}" Command="{Binding RefreshRoomsCommand}" />
      <StackPanel Orientation="Horizontal">
        <controls:SvgIcon Width="22" Height="22" Margin="0,0,11,0" VerticalAlignment="Center" IconKey="main_menu_multiplayer" Foreground="{DynamicResource Brush.Text.Strong}" />
        <TextBlock Style="{StaticResource RidePageTitleTextStyle}" Text="{x:Static res:Strings.Multiplayer_SectionJoinLobby}" />
        <TextBlock Style="{StaticResource RidePageSubtitleTextStyle}" Text="选择公开房间直接进入，无需房主提供房间码" />
      </StackPanel>
    </DockPanel>

    <!-- ② 统计条 -->
    <Border Style="{StaticResource RideStatStripStyle}" Margin="0,0,0,14">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{Binding RoomsLoadStatus}" IsHitTestVisible="False" />
        <Border Style="{StaticResource RideStatChipStyle}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource RideStatChipValueStyle}" Text="{Binding PublicRooms.Count}" />
            <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="个公开房间" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ③ 房间列表 -->
    <Border Style="{StaticResource RideListSurfaceStyle}" MinHeight="200">
      <Grid>
        <ItemsControl ItemsSource="{Binding PublicRooms}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Margin="4,4,4,4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type multiplayer:PublicRoomItem}">
              <controls:ListPageItemButton IconKey="beamng/online" IconWidth="21" IconHeight="21" IconColumnWidth="58" IconMargin="8,0,0,0" IconTileBackground="#12FFFFFF" IconTileBorderBrush="#1FFFFFFF" IconTileBorderThickness="1" IconTilePadding="9" IconTileCornerRadius="11" ItemMargin="0,2" Title="{Binding Name}" Subtitle="{Binding Host, StringFormat=房主：{0}}" TrailingText="{Binding PlayerCount}" Command="{Binding DataContext.JoinRoomCommand, RelativeSource={RelativeSource AncestorType={x:Type views:JoinLobbyView}}}" CommandParameter="{Binding}">
                <controls:ListPageItemButton.TitleTrailingContent>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,2" CornerRadius="9" Background="{DynamicResource Brush.Field.ReadOnly.Surface}">
                      <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" Text="{Binding Map}" />
                    </Border>
                  </StackPanel>
                </controls:ListPageItemButton.TitleTrailingContent>
              </controls:ListPageItemButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 状态：加载中 / 无房间 -->
        <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" LineHeight="20" Foreground="{DynamicResource Brush.Text.Subtle}" FontSize="12.5" Text="{Binding RoomsLoadStatus}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding HasRoomsLoadStatus}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="0" Binding="{Binding PublicRooms.Count}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
