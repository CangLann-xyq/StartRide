<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Resources.ResourcesPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:views="clr-namespace:StartRide.App.Views.Resources" xmlns:resources="clr-namespace:StartRide.App.ViewModels.Resources" xmlns:res="clr-namespace:StartRide.App.Resources" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="ResourcesMenuItemTemplate" DataType="{x:Type resources:ResourcesSectionItem}">
        <controls:SecondaryMenuOptionButton IconMode="Svg" Text="{Binding Title}" IconKey="{Binding IconKey}" IsSelected="{Binding IsSelected}" Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ResourcesPageView}}}" CommandParameter="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="ResourcesModVersionFilterTemplate" DataType="{x:Type resources:ResourcesModPageViewModel}">
        <views:ResourcesModVersionFilterView />
      </DataTemplate>
      <DataTemplate x:Key="ResourcesProjectFilterButtonTemplate" DataType="{x:Type resources:ResourcesModPageViewModel}">
        <Button MinWidth="68" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static res:Strings.Resources_ModFilterButtonLabel}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding ProjectList.OpenFilterDialogCommand}" />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type resources:ResourcesModPageViewModel}}" DataType="{x:Type resources:ResourcesModPageViewModel}">
        <views:ResourcesModPageView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type resources:ResourcesResourcePacksPageViewModel}}" DataType="{x:Type resources:ResourcesResourcePacksPageViewModel}">
        <views:ResourcesModPageView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type resources:ResourcesShaderPacksPageViewModel}}" DataType="{x:Type resources:ResourcesShaderPacksPageViewModel}">
        <views:ResourcesModPageView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type resources:ResourcesWorldsPageViewModel}}" DataType="{x:Type resources:ResourcesWorldsPageViewModel}">
        <views:ResourcesModPageView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type resources:ResourcesModpacksPageViewModel}}" DataType="{x:Type resources:ResourcesModpacksPageViewModel}">
        <views:ResourcesModPageView />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="PageRoot">
    <controls:SecondaryMenuFrame Title="{x:Static res:Strings.Page_Resources}">
      <controls:SecondaryMenuFrame.MenuContent>
        <ItemsControl ItemTemplate="{StaticResource ResourcesMenuItemTemplate}" ItemsSource="{Binding Sections}" />
      </controls:SecondaryMenuFrame.MenuContent>
    </controls:SecondaryMenuFrame>
    <controls:ListPageFrame x:Name="ResourcesListFrame" Margin="272,36,24,8" SearchLeadingContentTemplate="{StaticResource ResourcesProjectFilterButtonTemplate}" SearchFilterContentTemplate="{StaticResource ResourcesModVersionFilterTemplate}" IsListVisible="True" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" UseFrameScrollViewer="False" Title="{Binding PageTitle}" TitleIconSource="{Binding PageTitleIconSource}" IsHeaderBackButtonVisible="{Binding IsModProjectDetailsStep}" HeaderBackCommand="{Binding CurrentOnlineProjectPage.BackToProjectListCommand}" SearchText="{Binding ActiveModSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSearchVisible="{Binding IsModSearchVisible}" SearchLeadingContent="{Binding CurrentOnlineProjectPage}" IsSearchLeadingContentVisible="{Binding CurrentOnlineProjectPage.IsProjectListStep}" SearchFilterContent="{Binding CurrentOnlineProjectPage}" IsSearchFilterVisible="{Binding CurrentOnlineProjectPage.IsProjectVersionsStep}">
      <controls:ListPageFrame.ListContent>
        <Grid Tag="ResourcesSectionHost" ClipToBounds="True">
          <Grid Loaded="SectionContentRoot_OnLoaded" Unloaded="SectionContentRoot_OnUnloaded">
            <UIElement.RenderTransform>
              <TranslateTransform />
            </UIElement.RenderTransform>
            <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentSectionViewModel}" />
          </Grid>
        </Grid>
      </controls:ListPageFrame.ListContent>
    </controls:ListPageFrame>
  </Grid>
</UserControl>