<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Controls.LaunchSettingsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animation="clr-namespace:Launcher.App.Behaviors.Animation" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SettingsOptionRowStyle" TargetType="{x:Type Grid}">
        <Setter Property="Margin" Value="0,0,0,14" />
      </Style>
      <Style x:Key="SettingsOptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="AdvancedLaunchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource LauncherDialogWrappingTextBoxStyle}">
        <EventSetter Event="Loaded" Handler="AdvancedLaunchTextBox_OnLoaded" />
        <EventSetter Event="TextChanged" Handler="AdvancedLaunchTextBox_OnTextChanged" />
        <EventSetter Event="SizeChanged" Handler="AdvancedLaunchTextBox_OnSizeChanged" />
      </Style>
      <Style x:Key="AdvancedLaunchEditableTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource AdvancedLaunchTextBoxStyle}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding ShowModeSelector, ElementName=Root}" />
              <Condition Value="False" Binding="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Collapsed" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AdvancedLaunchGlobalTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource AdvancedLaunchTextBoxStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Text" Value="{x:Static res:Strings.GameSettings_LaunchSettingsModeUseGlobal}" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding ShowModeSelector, ElementName=Root}" />
              <Condition Value="False" Binding="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="LaunchSettingsModeOptionTemplate">
        <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Text="{Binding Title}" />
      </DataTemplate>
      <DataTemplate x:Key="MemorySettingsModeOptionTemplate">
        <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Text="{Binding Title}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <Border Margin="0,0,0,26">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource SectionFieldSurfaceStyle}" TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding ShowModeSelector, ElementName=Root}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchSettingsModeLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
        <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource LaunchSettingsModeOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding LaunchSettingsModeOptions, ElementName=Root}" SelectedItem="{Binding SelectedLaunchSettingsModeOption, ElementName=Root, Mode=TwoWay}" />
      </Grid>
    </Border>
    <GroupBox Header="{x:Static res:Strings.GameSettings_LaunchSettingsSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid Style="{StaticResource SettingsOptionRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchCheckFilesOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LaunchCheckFilesBeforeLaunchEnabled, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
          <Grid Style="{StaticResource SettingsOptionRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchAutoRepairOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LaunchAutoRepairMissingFilesEnabled, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding CanEditAutoRepairMissingFiles, ElementName=Root}" />
          </Grid>
          <Grid Style="{StaticResource SettingsOptionRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchMinimizeLauncherOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LaunchMinimizeLauncherAfterLaunchEnabled, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
          <Grid Style="{StaticResource SettingsOptionRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchFullScreenOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LaunchFullScreenEnabled, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
          <!-- 自动加入服务器地址：Minecraft 概念（MC 客户端直接吃 host:port），
               BeamNG 联机走启动器自己的中继+房间流程，没有对应参数 → 本轮起不再显示。 -->
          <Grid Margin="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_LaunchAutoJoinServerOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <TextBox Grid.Column="1" Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding LaunchAutoJoinServerAddress, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.Settings_MemorySection}" Style="{StaticResource LauncherContentSectionStyle}" Visibility="{Binding ElementName=Root, Path=ShowMemorySettings, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid Style="{StaticResource SettingsOptionRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_MemoryModeLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource MemorySettingsModeOptionTemplate}" SelectionItemTemplate="{StaticResource MemorySettingsModeOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding MemorySettingsModeOptions, ElementName=Root}" SelectedItem="{Binding SelectedMemorySettingsModeOption, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
          <StackPanel Margin="0,0,0,14" animation:AnimatedCollapse.IsExpanded="{Binding IsMemorySliderVisible, ElementName=Root}">
            <TextBlock Text="{x:Static res:Strings.Settings_MaxMemoryLabel}" Style="{StaticResource SettingsOptionTextStyle}" Margin="0,0,0,10" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
              </Grid.ColumnDefinitions>
              <Slider Style="{StaticResource LauncherSliderStyle}" Minimum="{Binding MemoryMinimumMb, ElementName=Root}" Maximum="{Binding MemoryMaximumMb, ElementName=Root}" Value="{Binding MemoryMb, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding IsMemorySliderEnabled, ElementName=Root}" />
              <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource Brush.CFFFFFFF}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding MemoryValueText, ElementName=Root}" />
            </Grid>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static res:Strings.Settings_SystemMemorySummaryLabel}" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="12" />
              <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.F2F2F2}" FontSize="13" Text="{Binding SystemMemorySummaryText, ElementName=Root}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right" Visibility="{Binding IsAutomaticMemorySummaryVisible, ElementName=Root, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
              <TextBlock Text="{x:Static res:Strings.Settings_AutomaticMemoryAllocationLabel}" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="12" TextAlignment="Right" />
              <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.F2F2F2}" FontSize="13" TextAlignment="Right" Text="{Binding AutomaticMemoryText, ElementName=Root}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,26,0,0" Header="{x:Static res:Strings.GameSettings_AdvancedLaunchSettingsSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.GameSettings_PreLaunchCommandOption}" Style="{StaticResource SettingsOptionTextStyle}" Margin="0,0,0,8" />
          <Grid>
            <TextBox Style="{StaticResource AdvancedLaunchEditableTextBoxStyle}" Text="{Binding LaunchPreLaunchCommand, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
            <TextBox Style="{StaticResource AdvancedLaunchGlobalTextBoxStyle}" />
          </Grid>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.GameSettings_WaitForPreLaunchCommandOption}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding LaunchWaitForPreLaunchCommand, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
          </Grid>
          <TextBlock Text="{x:Static res:Strings.GameSettings_PostExitCommandOption}" Style="{StaticResource SettingsOptionTextStyle}" Margin="0,16,0,8" />
          <Grid>
            <TextBox Style="{StaticResource AdvancedLaunchEditableTextBoxStyle}" Text="{Binding LaunchPostExitCommand, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
            <TextBox Style="{StaticResource AdvancedLaunchGlobalTextBoxStyle}" />
          </Grid>
          <!-- 自定义 JVM 参数：BeamNG 是原生引擎，没有 Java 运行时，这项永远是空操作 → 不再显示。
               BeamNG 的等价物是下面那栏「游戏启动参数」，那栏是真的会拼进命令行的。 -->
          <StackPanel Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.GameSettings_CustomJvmArgumentsOption}" Style="{StaticResource SettingsOptionTextStyle}" Margin="0,16,0,8" />
            <Grid>
              <TextBox Style="{StaticResource AdvancedLaunchEditableTextBoxStyle}" Text="{Binding LaunchJvmArguments, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
              <TextBox Style="{StaticResource AdvancedLaunchGlobalTextBoxStyle}" />
            </Grid>
          </StackPanel>
          <TextBlock Text="{x:Static res:Strings.GameSettings_CustomGameArgumentsOption}" Style="{StaticResource SettingsOptionTextStyle}" Margin="0,16,0,8" />
          <Grid>
            <TextBox Style="{StaticResource AdvancedLaunchEditableTextBoxStyle}" Text="{Binding LaunchGameArguments, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AreLaunchSettingsOverridesEnabled, ElementName=Root}" />
            <TextBox Style="{StaticResource AdvancedLaunchGlobalTextBoxStyle}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>