<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Settings.FeedbackSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <GroupBox Header="{x:Static res:Strings.Settings_FeedbackChannelsSection}" Style="{StaticResource RideSectionStyle}">
      <Border Style="{StaticResource RideSectionBodyStyle}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Settings_FeedbackDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
          <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,14,0,0" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:SvgIcon Width="26" Height="26" IconKey="{Binding IconKey}" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Accent.Primary}" />
                    <StackPanel Grid.Column="1" Margin="12,0,16,0">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsOptionTextStyle}" />
                      <TextBlock Margin="0,4,0,0" Text="{Binding Description}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_FeedbackOpenButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,14,0,0" Header="{x:Static res:Strings.Settings_FeedbackBeforeSubmitSection}" Style="{StaticResource RideSectionStyle}">
      <Border Style="{StaticResource RideSectionBodyStyle}">
        <TextBlock Text="{x:Static res:Strings.Settings_FeedbackBeforeSubmitDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>
