<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Account.Dialogs.AddAccountDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StartRide.App.Resources" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:models="clr-namespace:StartRide.App.Models" Focusable="False" xmlns:dialogs="clr-namespace:StartRide.App.Views.Account.Dialogs">
  <Grid Style="{StaticResource DialogContentGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="{Binding Dialog.AddAccountDialogTitle}" />
      <TextBlock TextWrapping="Wrap" Style="{StaticResource DialogSubtitleTextStyle}" Text="{Binding Dialog.AddAccountDialogSubtitle}" />
    </StackPanel>
    <ListBox Grid.Row="1" Style="{StaticResource DialogChoiceListStyle}" ItemsSource="{Binding Dialog.AccountTypeOptions}" SelectedItem="{Binding Dialog.SelectedAccountTypeOption, Mode=TwoWay}" Visibility="{Binding Dialog.IsAccountTypeStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type models:AccountTypeOption}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="30" Height="30">
              <controls:SvgIcon Width="24" Height="24" Foreground="{DynamicResource Brush.F4F4F4}" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding IconKey}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type controls:SvgIcon}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </controls:SvgIcon>
              <TextBlock FontFamily="{DynamicResource LauncherIconFontFamily}" FontSize="22" Foreground="{DynamicResource Brush.F4F4F4}" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.AFFFFFFF}" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsOfflineNameStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <TextBlock Text="{x:Static res:Strings.Account_UsernameLabel}" Style="{StaticResource DialogFieldLabelTextStyle}" />
      <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding Dialog.NewOfflineAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="{x:Static res:Strings.Account_UsernameValidation}" Style="{StaticResource DialogValidationTextStyle}" Visibility="{Binding Dialog.IsNewOfflineAccountNameInvalid, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    </StackPanel>
    <StackPanel Name="ThirdPartyCredentialsPanel" Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" IsEnabled="{Binding Dialog.IsAddAccountFooterEnabled}" Visibility="{Binding Dialog.IsThirdPartyFormStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <TextBlock Text="{x:Static res:Strings.Account_AuthenticationServerLabel}" Style="{StaticResource DialogFieldLabelTextStyle}" />
      <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}" behaviors:TextBoxPlaceholder.Text="{x:Static res:Strings.Account_AuthenticationServerPlaceholder}" IsReadOnly="{Binding Dialog.IsThirdPartyIdentityReadOnly}" Text="{Binding Dialog.ThirdParty.AuthenticationServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Style="{StaticResource DialogValidationTextStyle}" Text="{Binding Dialog.ThirdParty.AuthenticationServerError}" Visibility="{Binding Dialog.ThirdParty.HasAuthenticationServerError, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <TextBlock Text="{x:Static res:Strings.Account_UsernameOrEmailLabel}" Margin="0,12,0,8" Style="{StaticResource DialogFieldLabelTextStyle}" />
      <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}" IsReadOnly="{Binding Dialog.IsThirdPartyIdentityReadOnly}" Text="{Binding Dialog.ThirdParty.UsernameOrEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Style="{StaticResource DialogValidationTextStyle}" Text="{Binding Dialog.ThirdParty.UsernameError}" Visibility="{Binding Dialog.ThirdParty.HasUsernameError, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <TextBlock Text="{x:Static res:Strings.Account_PasswordLabel}" Margin="0,12,0,8" Style="{StaticResource DialogFieldLabelTextStyle}" />
      <PasswordBox Name="ThirdPartyPasswordBox" Style="{StaticResource LauncherDialogPasswordBoxStyle}" PasswordChanged="ThirdPartyPasswordBox_OnPasswordChanged" />
      <TextBlock Style="{StaticResource DialogValidationTextStyle}" Text="{Binding Dialog.ThirdParty.PasswordError}" Visibility="{Binding Dialog.ThirdParty.HasPasswordError, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsMicrosoftStatusStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Grid Width="34" Height="34" HorizontalAlignment="Center">
        <controls:SvgIcon Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding Dialog.MicrosoftLoginIconKey}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type controls:SvgIcon}">
              <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Dialog.MicrosoftLoginIconKey}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Dialog.IsMicrosoftLoginResultStep}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.FF8A8A}" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Dialog.IsMicrosoftReauthenticationResultStep}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.FF8A8A}" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Dialog.IsMicrosoftLoginSuccessful}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.7DFFB2}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </controls:SvgIcon>
        <TextBlock FontFamily="{DynamicResource LauncherIconFontFamily}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Dialog.MicrosoftLoginIcon}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Dialog.MicrosoftLoginIconKey}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
      <TextBlock Margin="0,16,0,0" Style="{StaticResource DialogBodyTextStyle}" TextAlignment="Center" Text="{Binding Dialog.MicrosoftLoginMessage}" />
    </StackPanel>
    <ListBox Grid.Row="1" SelectionMode="Multiple" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Style="{StaticResource DialogChoiceListStyle}" ItemsSource="{Binding Dialog.ThirdParty.Profiles}" Visibility="{Binding Dialog.IsThirdPartyProfileSelectionStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <ItemsControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource DialogChoiceItemStyle}" TargetType="{x:Type ListBoxItem}">
          <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding AvatarSource}" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.F4F4F4}" FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsThirdPartyImportProgressStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <TextBlock Style="{StaticResource DialogBodyTextStyle}" TextAlignment="Center" Text="{Binding Dialog.ThirdPartyImportCurrentProfileName}" />
      <TextBlock Margin="0,12,0,0" Style="{StaticResource DialogBodyTextStyle}" TextAlignment="Center" Text="{Binding Dialog.ThirdPartyImportProgressText}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsThirdPartyImportResultStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <TextBlock Style="{StaticResource DialogBodyTextStyle}" TextAlignment="Center" Text="{Binding Dialog.ThirdPartyImportFailureText}" />
    </StackPanel>
    <Grid Row="2">
      <Button Style="{StaticResource LauncherDialogButtonStyle}" HorizontalAlignment="Left" Content="{x:Static res:Strings.Back_Button}" Command="{Binding RequestBackAddAccountDialogCommand}" Visibility="{Binding Dialog.CanShowAddAccountBackButton, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <Button Style="{StaticResource LauncherDialogButtonStyle}" HorizontalAlignment="Left" Content="{x:Static res:Strings.SelectAll_Button}" IsEnabled="{Binding Dialog.CanSelectAllThirdPartyProfiles}" Command="{Binding RequestSelectAllThirdPartyProfilesCommand}" Visibility="{Binding Dialog.IsThirdPartyProfileSelectionStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <StackPanel Style="{StaticResource DialogFooterStyle}" IsEnabled="{Binding Dialog.IsAddAccountFooterEnabled}" Visibility="{Binding Dialog.CanShowStandardAddAccountFooter, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
        <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding RequestCancelAddAccountDialogCommand}" Visibility="{Binding Dialog.CanShowAddAccountCancelButton, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
        <Button Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Margin="{StaticResource DialogTrailingButtonMargin}" Content="{Binding Dialog.AddAccountConfirmButtonText}" IsEnabled="{Binding Dialog.CanConfirmAddAccountDialog}" Command="{Binding RequestConfirmAddAccountDialogCommand}" />
      </StackPanel>
      <StackPanel Style="{StaticResource DialogFooterStyle}" Visibility="{Binding Dialog.IsThirdPartyImportProgressStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
        <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding RequestCancelAddAccountDialogCommand}" />
      </StackPanel>
      <StackPanel Style="{StaticResource DialogFooterStyle}" Visibility="{Binding Dialog.CanShowMicrosoftAuthenticationCancelButton, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
        <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding RequestCancelAddAccountDialogCommand}" />
      </StackPanel>
      <StackPanel Style="{StaticResource DialogFooterStyle}" Visibility="{Binding Dialog.IsThirdPartyImportResultStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
        <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Confirm_Button}" Command="{Binding RequestConfirmAddAccountDialogCommand}" />
        <Button Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Margin="{StaticResource DialogTrailingButtonMargin}" Content="{x:Static res:Strings.Retry_Button}" Command="{Binding RequestRetryThirdPartyProfileImportCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>