<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Shell.ShellNavigationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:models="clr-namespace:StartRide.App.Models" xmlns:res="clr-namespace:StartRide.App.Resources" x:Name="Root" xmlns:shell="clr-namespace:StartRide.App.Views.Shell">
  <Grid>
    <Border BorderBrush="{DynamicResource Brush.14FFFFFF}" BorderThickness="0,0,0,1" Background="{x:Null}">
      <Grid Margin="18,0,96,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧品牌标识：StartRide 官方 logo 图标（四角圆角） -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <Image Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="/StartRide;component/Assets/Branding/startride_icon_64.png" />
          <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Strong}" Text="StartRide" />
        </StackPanel>

        <!-- 中部：主导航标签页 -->
        <ItemsControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:NavigationItem}">
              <Button Style="{StaticResource TopNavigationTabStyle}" Command="{Binding DataContext.NavigateCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Width="18" Height="18" VerticalAlignment="Center" IconKey="{Binding IconKey}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                  <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="{Binding Page, Converter={StaticResource PageTitleConverter}}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 右侧：下载任务入口（纯图标，悬停显示名称） -->
        <Button Grid.Column="2" Style="{StaticResource TopNavigationTabStyle}" DataContext="{Binding DownloadTasksNavigationItem}" Command="{Binding DataContext.NavigateCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="{Binding Page, Converter={StaticResource PageTitleConverter}}" Margin="8,0,4,0">
          <Grid Width="20" Height="20">
            <Ellipse Name="DownloadTaskPulseCircle" Width="20" Height="20" Fill="{DynamicResource Brush.66808080}" Opacity="0" CacheMode="BitmapCache" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="DownloadTaskPulseScale" ScaleX="0.9" ScaleY="0.9" />
              </UIElement.RenderTransform>
            </Ellipse>
            <controls:SvgIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding IconKey}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
          </Grid>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>