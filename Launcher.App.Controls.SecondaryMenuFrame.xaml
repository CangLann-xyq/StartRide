<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Controls.SecondaryMenuFrame" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:controls="clr-namespace:Launcher.App.Controls" x:Name="Root" Focusable="False">
  <Border Style="{StaticResource SecondaryMenuPanelShadowStyle}">
    <controls:BackdropBlurBorder Style="{StaticResource SecondaryMenuBackdropStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <ScrollViewer behaviors:VerticalEdgeOpacityMask.IsEnabled="True" behaviors:VerticalEdgeOpacityMask.TopFadeLength="50" behaviors:VerticalEdgeOpacityMask.BottomFadeLength="24" behaviors:VerticalEdgeOpacityMask.MinimumOpacity="0">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SecondaryMenuScrollViewerStyle}" TargetType="{x:Type ScrollViewer}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding UseInternalScrollViewer, ElementName=Root}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <Border Style="{StaticResource SecondaryMenuHeaderSpacerStyle}" />
              <StackPanel Style="{StaticResource SecondaryMenuItemsPanelStyle}">
                <ContentControl Name="ScrollableContentHost" />
                <Border Style="{StaticResource SecondaryMenuBottomSpacerStyle}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <ContentControl Name="DirectContentHost" behaviors:VerticalEdgeOpacityMask.IsEnabled="True" behaviors:VerticalEdgeOpacityMask.TopFadeLength="50" behaviors:VerticalEdgeOpacityMask.BottomFadeLength="24" behaviors:VerticalEdgeOpacityMask.MinimumOpacity="0">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding UseInternalScrollViewer, ElementName=Root}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
          <Border Style="{StaticResource SecondaryMenuHeaderOverlayStyle}">
            <TextBlock Style="{StaticResource SecondaryMenuHeaderTextStyle}" Text="{Binding Title, ElementName=Root}" />
          </Border>
        </Grid>
        <ContentControl Grid.Row="1" Content="{Binding FooterContent, ElementName=Root}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentControl>
      </Grid>
    </controls:BackdropBlurBorder>
  </Border>
</UserControl>