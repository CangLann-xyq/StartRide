<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Home.HomeLaunchPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:home="clr-namespace:Launcher.App.Views.Home">
  <!-- StartRide 主页：左右对称边距保证真居中；垂直节奏全部用正边距，不再用负边距互相拉扯 -->
  <Grid Margin="24,0,24,0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

      <!-- 品牌标识：StartRide 官方 logo 图标（四角圆角） -->
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10">
        <Image Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="/StartRide;component/Assets/Branding/startride_icon_128.png" />
        <TextBlock Margin="12,0,0,2" VerticalAlignment="Center" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Strong}" Text="StartRide" />
      </StackPanel>

      <!-- 账户名（无账户时显示引导提示） -->
      <TextBlock Style="{StaticResource HomeAccountNameTextStyle}" Text="{Binding HomeAccountDisplayName}" />
      <TextBlock Text="{x:Static res:Strings.Home_ChooseOrCreateAccount}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource HomeAccountHintTextStyle}" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding HasSelectedAccount}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>

      <!-- 启动按钮 -->
      <Button Content="{x:Static res:Strings.Launch_Button}" Style="{StaticResource HomeLaunchButtonStyle}" Command="{Binding LaunchCommand}" />

      <!-- 游戏版本：版本号前加 BeamNG 官方 logo，让人一眼看出这是 BeamNG 的版本 -->
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,12,0,0">
        <controls:SvgIcon Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center" IconKey="beamng/beamng" Foreground="{DynamicResource Brush.Home.Name.Foreground}" />
        <TextBlock Margin="0" VerticalAlignment="Center" Style="{StaticResource HomeVersionNameTextStyle}" Text="{Binding HomeVersionDisplayName}" />
      </StackPanel>

      <!-- StartRide 运行状态：游戏在跑 → "已运行 X" + 结束按钮；没在跑 → 累计游玩统计 -->
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,10,0,0">
        <StackPanel.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding ShowGameRuntimeLine}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.8FB8C7D9}" Text="{Binding GameRuntimeSummary}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsGameRunning}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>

        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.8FB8C7D9}" Text="{Binding PlaytimeSummary}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsGameRunning}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>

        <Button Margin="10,0,0,0" Content="{Binding EndGameButtonText}" Command="{Binding EndGameCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource HomeChangeVersionButtonStyle}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsGameRunning}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </StackPanel>

      <!-- 游戏设置链接；启动时同位切换为进度信息（无位移） -->
      <Grid HorizontalAlignment="Center" Margin="0,6,0,0">
        <Button Content="{x:Static res:Strings.Home_GameSettingsButton}" Command="{Binding OpenSelectedInstanceSettingsCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource HomeChangeVersionButtonStyle}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsLaunching}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="UIElement.Opacity" Value="0" />
              <Setter Property="UIElement.IsHitTestVisible" Value="False" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsLaunching}">
                  <Setter Property="UIElement.Opacity" Value="1" />
                  <Setter Property="UIElement.IsHitTestVisible" Value="True" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <TextBlock Margin="0,0,0,8" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.CCFFFFFF}" FontSize="13" TextAlignment="Center" Text="{Binding LaunchStatusMessage}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Height="5" Maximum="100" VerticalAlignment="Center" Style="{StaticResource LauncherProgressBarStyle}" Value="{Binding LaunchProgressPercent}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Width="28" Height="28" Foreground="{DynamicResource Brush.8F96A3}" Style="{StaticResource InlineIconButtonStyle}" ToolTip="{x:Static res:Strings.Cancel_Button}" Command="{Binding CancelLaunchCommand}">
              <controls:SvgIcon Width="16" Height="16" IconKey="home_page/home_page_close" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </Grid>
          <TextBlock Width="260" Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.8FB8C7D9}" FontSize="11" TextAlignment="Center" Text="{Binding LaunchDownloadSpeedText}" Visibility="{Binding HasLaunchDownloadSpeedText, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
