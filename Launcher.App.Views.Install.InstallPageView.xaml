<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Install.InstallPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" x:Name="Root" Focusable="False" xmlns:install="clr-namespace:Launcher.App.Views.Install">
  <Grid Name="PageRoot">
    <controls:ListPageFrame Margin="16,36,24,8" Title="{x:Static res:Strings.Page_Install}" IsSearchVisible="False" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" IsListVisible="{Binding HasTasks}">
      <controls:ListPageFrame.OverlayContent>
        <TextBlock Margin="12,42,0,0" Text="{x:Static res:Strings.Install_Empty}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding HasTasks}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </controls:ListPageFrame.OverlayContent>
      <controls:ListPageFrame.ListContent>
        <ItemsControl Margin="12,0,0,0" ItemsSource="{Binding Tasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource InstallTaskCardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource InstallTaskTitleTextStyle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource InstallTaskSubtitleTextStyle}" Text="{Binding Subtitle}" />
                  </StackPanel>
                  <Grid Column="1" Margin="18,0,0,0" MinWidth="92" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource InstallTaskCancelButtonStyle}" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                      <controls:SvgIcon Width="14" Height="14" IconKey="general/general_delete" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right">
                      <TextBlock Style="{StaticResource InstallTaskStateTextStyle}" Text="{Binding StateText}" />
                      <TextBlock Style="{StaticResource InstallTaskSpeedTextStyle}" Text="{Binding DownloadSpeedText}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Style="{StaticResource InstallTaskStatusTextStyle}" Text="{Binding StatusMessage}" />
                  <Grid Row="2" ColumnSpan="2" Margin="0,8,0,0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="5" Maximum="100" Style="{StaticResource LauncherProgressBarStyle}" VerticalAlignment="Center" Value="{Binding ProgressPercent}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InstallTaskProgressTextStyle}" Text="{Binding ProgressText}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:ListPageFrame.ListContent>
    </controls:ListPageFrame>
  </Grid>
</UserControl>