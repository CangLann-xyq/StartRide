<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Multiplayer.JoinLobbyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:multiplayer="clr-namespace:Launcher.App.ViewModels.Multiplayer" xmlns:views="clr-namespace:Launcher.App.Views.Multiplayer">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="12,62,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <GroupBox Header="{x:Static res:Strings.Multiplayer_SectionJoinLobby}" Style="{StaticResource LauncherContentSectionStyle}">
      <StackPanel>
        <TextBlock Text="浏览所有公开房间，点击即可直接加入，无需输入房间代码。" Style="{StaticResource SettingsDescriptionTextStyle}" />
      </StackPanel>
    </GroupBox>

    <!-- 工具栏：标题 + 刷新 -->
    <Grid Margin="0,26,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Multiplayer_Join_RoomsSection}" Style="{StaticResource PageTitleTextStyle}" FontSize="18" />
        <Border Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2" CornerRadius="9" Background="{DynamicResource Brush.Accent.Selection}">
          <TextBlock Foreground="{DynamicResource Brush.Accent.Primary}" FontSize="12" Text="{Binding PublicRooms.Count, StringFormat={}{0} 个}" />
        </Border>
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Multiplayer_Join_RefreshButton}" Command="{Binding RefreshRoomsCommand}" />
    </Grid>

    <!-- 房间列表 -->
    <GroupBox Margin="0,16,0,0" Style="{StaticResource LauncherContentSectionStyle}">
      <Grid>
        <ItemsControl ItemsSource="{Binding PublicRooms}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type multiplayer:PublicRoomItem}">
              <controls:ListPageItemButton IconKey="beamng/car" IconWidth="30" IconHeight="30" ItemMargin="0,2" Title="{Binding Name}" Subtitle="{Binding Host, StringFormat=房主：{0}}" TrailingText="{Binding PlayerCount}" Command="{Binding DataContext.JoinRoomCommand, RelativeSource={RelativeSource AncestorType={x:Type views:JoinLobbyView}}}" CommandParameter="{Binding}">
                <controls:ListPageItemButton.TitleTrailingContent>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,2" CornerRadius="9" Background="{DynamicResource Brush.Field.ReadOnly.Surface}">
                      <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" Text="{Binding Map}" />
                    </Border>
                  </StackPanel>
                </controls:ListPageItemButton.TitleTrailingContent>
              </controls:ListPageItemButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 空状态 / 加载状态 -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource LauncherTextSecondaryBrush}" FontSize="13" Text="{Binding RoomsLoadStatus}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding HasRoomsLoadStatus}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </GroupBox>
  </StackPanel>
</UserControl>
