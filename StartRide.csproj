<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>StartRide</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <!-- App 的入口 Main 由 WPF 从 ApplicationDefinition 的 XAML 生成；
         反编译出的文件名不是约定的 App.xaml，所以要显式声明，否则报 CS5001。 -->
    <Page Remove="StartRide.App.App.xaml" />
    <ApplicationDefinition Include="StartRide.App.App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- ⚠️ Setup\ 是**独立工程**（自研安装包，有自己的 csproj）。
         SDK 风格的默认通配会把 Setup\ 下的 .cs/.xaml 一并吸进主工程，
         轻则重名冲突、重则抢走 ApplicationDefinition 导致启动即崩。
         这里必须显式排除，且要放在所有 Include 之前。 -->
    <Compile Remove="Setup\**" />
    <Page Remove="Setup\**" />
    <ApplicationDefinition Remove="Setup\**" />
    <Resource Remove="Setup\**" />
    <EmbeddedResource Remove="Setup\**" />
    <None Remove="Setup\**" />
  </ItemGroup>
