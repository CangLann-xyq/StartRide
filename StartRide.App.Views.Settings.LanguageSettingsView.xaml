<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Settings.LanguageSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:settings="clr-namespace:StartRide.App.Views.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <GroupBox Header="{x:Static res:Strings.Settings_LanguageSection}" Style="{StaticResource RideSectionStyle}">
      <StackPanel>
        <Border Style="{StaticResource RideSectionBodyStyle}">
          <controls:AnimatedComboBox Width="220" HorizontalAlignment="Right" ItemTemplate="{StaticResource LanguageOptionTemplate}" SelectionItemTemplate="{StaticResource LanguageOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
        </Border>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.Text.Danger}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LanguageRestartNoticeText}" Visibility="{Binding IsLanguageRestartNoticeVisible, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      </StackPanel>
    </GroupBox>

  </StackPanel>
</UserControl>