<UserControl x:Class="StartRide.App.Views.Ai.AiAssistantPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StartRide.App.Views.Ai"
             x:Name="Root" Focusable="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />

    <!--
      details / summary 折叠头：1:1 参考程序 .ai-local-steps>summary 与
      .ai-mode-disclosure>summary —— 左侧三角 marker、12px 次要色文字、右侧 ⌄/⌃，
      默认收起；只有「需要你查看」才自动展开（逻辑在 AiMessage.RefreshStepsHeader）。
    -->
    <Style x:Key="AiDetailToggle" TargetType="{x:Type ToggleButton}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="14,6,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border Background="Transparent" Padding="0,3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Marker" Grid.Column="0" Text="▸" Margin="0,0,7,0" FontSize="10"
                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock x:Name="Chevron" Grid.Column="2" Text="⌄" FontSize="12"
                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Marker" Property="Text" Value="▾" />
                <Setter TargetName="Chevron" Property="Text" Value="⌃" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 执行过程专用：有失败/待确认时折叠头转主题蓝（参考 data-state=attention > summary） -->
    <Style x:Key="AiStepsToggle" TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource AiDetailToggle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding StepsNeedAttention}" Value="True">
          <Setter Property="Foreground" Value="#FF0891FE" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AiFoldToggle" TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource AiDetailToggle}" />

    <!-- .ai-step-rows：1px 边 + 10px 圆角 + 淡玻璃底，里面每行两列 -->
    <Style x:Key="AiDetailRows" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="0,7,0,0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1E769DCC" />
      <Setter Property="Background" Value="#0CEEF6FF" />
    </Style>

    <!-- .ai-message-text：15px / 1.8 行高；WPF 没有 Markdown，用字号与行距还原排版层次 -->
    <Style x:Key="AiBody" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="27" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    </Style>

    <!-- .ai-turns button：24×20 的小横条，点了滚回对应那一轮 -->
    <Style x:Key="AiTurnButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Hit" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hit" Property="Background" Value="#14FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .ai-latest：滚离底部时出现的圆形「回到最新」 -->
    <Style x:Key="AiLatestButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" CornerRadius="16" BorderThickness="1" BorderBrush="#1F7D95B2"
                    Background="#E6233346">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2C4A70" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      玻璃卡：1:1 参考站 auth-panel_tokenPanel 的版式语言 ——
      14px 圆角、单像素亮边、自上而下的浅渐变、内侧一道高光，
      里面是「小号灰标签 + 等宽正文」。旧版是「左边一条竖线」的附注块，
      在深色底上太像引用块，不像一个独立的过程卡片。
    -->
    <Style x:Key="AiSubPanel" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1AFFFFFF" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#12FFFFFF" Offset="0" />
            <GradientStop Color="#06FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 内部还要再分「标签 / 正文」两行时用的同款卡（无外边距） -->
    <Style x:Key="AiGlassCard" TargetType="{x:Type Border}" BasedOn="{StaticResource AiSubPanel}">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="AiMono" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>

    <!-- 卡内小号标签 / 右上计数：和参考站 tokenPanel 的 span + token 同层级 -->
    <Style x:Key="AiCardLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>

    <Style x:Key="AiCardCount" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
    </Style>

    <!--
      .ai-message：助手消息没有卡片（border:0 / background:transparent / radius:0），
      只有顶部一道 .ai-duration 发丝线；用户消息才由 DataTrigger 换成右侧 18px 圆角气泡。
    -->
    <Style x:Key="AiBubble" TargetType="{x:Type Border}">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 卡片：玻璃渐变 + 单像素亮边，比纯色块更有层次（纯色在深底上会发死） -->
    <Style x:Key="AiSideCard" TargetType="{x:Type Border}">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,14,16,14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#10FFFFFF" Offset="0" />
            <GradientStop Color="#06FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 卡片内的一行：左边标签、右边开关 -->
    <Style x:Key="AiRowLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    </Style>

    <!-- 主按钮：主题蓝填充胶囊（对话页只有一个主动作，不该和「停止」长得一样） -->
    <Style x:Key="AiPrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
      <Setter Property="Padding" Value="18,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次按钮：透明底 + 发丝边，和主按钮拉开层级 -->
    <Style x:Key="AiGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AiPrimaryButton}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                    BorderThickness="1" BorderBrush="#1FFFFFFF"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      输入框。
      WPF 默认 TextBox 是 Aero2 那套浅色方框 —— 在深色玻璃面上就是一块白砖，
      连边框都是系统灰。这里换成「凹陷玻璃槽 + 聚焦时亮蓝环」。
    -->
    <Style x:Key="AiField" TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Primary}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Primary}" />
      <Setter Property="SelectionOpacity" Value="0.34" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Brush.Glass.FaceSunken}"
                    BorderBrush="#1AFFFFFF">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#30FFFFFF" />
              </Trigger>
              <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF" />
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      三态分段控件（禁止 / 询问 / 允许）。
      用 RadioButton 而不是 ComboBox：三选一且都要一眼看见，下拉要两步。
      选中色走 Tag 传进来（同一个模板，三种语义三种底色）——
      模板里只有一个「选中态背景」需要变，为此写三份模板不值得。
    -->
    <Style x:Key="AiSegBase" TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid>
              <Border x:Name="Sel" CornerRadius="6" Background="{TemplateBinding Tag}" Opacity="0" />
              <ContentPresenter Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Sel" Property="Opacity" Value="0.35" />
              </Trigger>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Sel" Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <!--
                禁用（Agent 关着 / 正在跑）时**不能**去动 Sel.Opacity：
                那是「选中底」，一压就变成三段都有一点底色 —— 其中「允许」的底色最显眼，
                于是看起来像三项全选了「允许」（实测截图就是这个效果）。
                正确做法：选中区分原样保留，整段文字压暗即可。
              -->
              <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      ⚠️ Tag 必须给真正的 Brush，不能写成 "#8CE0A03C" 这种字符串：
      Tag 是 object 类型，XAML 不知道它最后会喂给 Background，于是原样存成 string，
      模板里的 TemplateBinding 转不成画刷 → 静默没有底色。
      实测表现：只有「允许」（本来就是 DynamicResource 画刷）有蓝底，
      「禁止 / 询问」选中时只剩白字，看起来像没选中。
    -->
    <SolidColorBrush x:Key="AiSegDenyFill" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="AiSegAskFill" Color="#8CE0A03C" />

    <Style x:Key="AiSegDeny" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource AiSegBase}">
      <Setter Property="Tag" Value="{StaticResource AiSegDenyFill}" />
    </Style>
    <Style x:Key="AiSegAsk" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource AiSegBase}">
      <Setter Property="Tag" Value="{StaticResource AiSegAskFill}" />
    </Style>
    <Style x:Key="AiSegAllow" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource AiSegBase}">
      <Setter Property="Tag" Value="{DynamicResource Brush.Accent.Primary}" />
    </Style>

    <!-- 分段槽：三段共用的凹陷底 -->
    <Style x:Key="AiSegTrack" TargetType="{x:Type Border}">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Background" Value="#0AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
    </Style>

    <!-- 右栏用的精简开关：46×28 在 34 行高的卡里偏壮，缩到 42×24 更秀气 -->
    <Style x:Key="AiSwitch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource LauncherSwitchToggleButtonStyle}">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="AiDivider" TargetType="{x:Type Border}">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,10,0,10" />
      <Setter Property="Background" Value="#0FFFFFFF" />
    </Style>

    <Style x:Key="AiSideTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>

    <Style x:Key="AiHint" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,10" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,64,20,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="292" />
    </Grid.ColumnDefinitions>

    <!-- ================= 左：对话 =================
         1:1 参考「冒险者下载站」客户端：
           .ai-chat-shell  = 左侧 24px 对话定位细条 + 右侧滚动对话记录
           .ai-message     = 助手消息透明无卡片，顶部 .ai-duration 耗时行
           .ai-message.user= 右对齐 18px 圆角气泡
           .ai-local-steps = details/summary 折叠执行过程，正文按 textOffset 切开插在中间
           .ai-composer    = 状态行 + 输入 + 发送/停止
         配色按 StartRide 深色蓝色主题映射，不用参考程序的浅色底。
    -->
    <Grid Grid.Column="0" Margin="0,0,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="AI 助手" />
        <TextBlock Style="{StaticResource PageStatusTextStyle}" Text="{Binding ModeHint, Mode=OneWay}" />
      </StackPanel>

      <!-- 对话记录 role=log -->
      <Grid Grid.Row="1" x:Name="ChatShell">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- .ai-turns：每一轮用户消息一个小横条 -->
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Messages}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource AiTurnButton}" Tag="{Binding}"
                      Click="TurnMarker_Click" ToolTip="跳到这一轮">
                <Border Width="12" Height="2" CornerRadius="2" Background="#57647C" />
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Column="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8,18,10,18"
                      ScrollChanged="ChatScroll_ScrollChanged">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MainContentScrollBarStyle}" />
          </ScrollViewer.Resources>
          <ItemsControl x:Name="ChatItems" ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,24" x:Name="MsgRoot">
                  <Border x:Name="Bubble" Style="{StaticResource AiBubble}">
                    <StackPanel>

                      <!-- .ai-duration：耗时 + 时间戳 + 底部发丝线 -->
                      <StackPanel x:Name="DurationRow" Margin="0,0,0,13" Visibility="Collapsed">
                        <Grid>
                          <TextBlock Text="{Binding DurationText, Mode=OneWay}" FontSize="12"
                                     Foreground="{DynamicResource Brush.Text.Muted}" />
                          <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontSize="10"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource Brush.Text.Muted}" />
                        </Grid>
                        <Border Height="1" Margin="0,9,0,0" Background="#1882A0C8" />
                      </StackPanel>

                      <!-- 首轮响应前的占位状态行 -->
                      <TextBlock Text="正在理解你的需求…" FontSize="12" Margin="0,0,0,6"
                                 Foreground="{DynamicResource Brush.Text.Muted}"
                                 Visibility="{Binding IsUnderstandingVisible, Converter={StaticResource BoolVis}}" />

                      <!-- 第一次工具调用之前已经写出的正文，留在折叠块上方 -->
                      <TextBlock x:Name="BeforeText" Style="{StaticResource AiBody}"
                                 local:AiMarkdown.Text="{Binding TextBefore, Mode=OneWay}" Margin="0,0,0,10"
                                 Visibility="{Binding HasTextBefore, Converter={StaticResource BoolVis}}" />

                      <!-- 思考过程 details -->
                      <StackPanel x:Name="ThinkingBlock"
                                  Visibility="{Binding HasThinking, Converter={StaticResource BoolVis}}">
                        <ToggleButton Style="{StaticResource AiDetailToggle}"
                                      Content="{Binding ThinkingHeader, Mode=OneWay}"
                                      IsChecked="{Binding IsThinkingExpanded, Mode=TwoWay}" />
                        <Border Style="{StaticResource AiDetailRows}"
                                Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolVis}}">
                          <TextBlock Style="{StaticResource AiMono}" Text="{Binding Thinking}" />
                        </Border>
                      </StackPanel>

                      <!-- 理解与计划 details -->
                      <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolVis}}">
                        <ToggleButton Style="{StaticResource AiDetailToggle}"
                                      Content="{Binding PlanHeader, Mode=OneWay}"
                                      IsChecked="{Binding IsPlanExpanded, Mode=TwoWay}" />
                        <Border Style="{StaticResource AiDetailRows}"
                                Visibility="{Binding IsPlanExpanded, Converter={StaticResource BoolVis}}">
                          <TextBlock Style="{StaticResource AiMono}" Text="{Binding Plan}" />
                        </Border>
                      </StackPanel>

                      <!-- 执行过程 details：1:1 .ai-local-steps / .ai-step-rows / .ai-step-row -->
                      <StackPanel x:Name="StepsBlock"
                                  Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}}">
                        <ToggleButton Style="{StaticResource AiStepsToggle}"
                                      Content="{Binding StepsSummary, Mode=OneWay}"
                                      IsChecked="{Binding IsStepsExpanded, Mode=TwoWay}" />
                        <Border Style="{StaticResource AiDetailRows}"
                                Visibility="{Binding IsStepsExpanded, Converter={StaticResource BoolVis}}">
                          <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                                             FontSize="12" Margin="0,0,12,0"
                                             Foreground="{DynamicResource Brush.Text.Strong}" />
                                  <TextBlock x:Name="RowStatus" Grid.Column="1" Text="{Binding Detail}"
                                             TextWrapping="Wrap" MaxWidth="300" FontSize="12"
                                             Foreground="{DynamicResource Brush.Text.Muted}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="RowStatus" Property="Foreground" Value="#E8B96A" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="RowStatus" Property="Foreground" Value="#FF0891FE" />
                                  </DataTrigger>
                                </DataTemplate.Triggers>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </StackPanel>

                      <!-- 正文：无步骤时整段；有步骤时接在折叠块下方 -->
                      <TextBlock x:Name="Body" Style="{StaticResource AiBody}"
                                 local:AiMarkdown.Text="{Binding BodyText, Mode=OneWay}" />
                      <TextBlock Text="正在输出…" FontSize="11" Margin="0,6,0,0"
                                 Foreground="{DynamicResource Brush.Text.Muted}"
                                 Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}}" />

                      <TextBlock x:Name="TimeStamp" Text="{Binding TimeText, Mode=OneWay}"
                                 FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Brush.Text.Muted}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <DataTemplate.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsUnderstanding}" Value="True" />
                      <Condition Binding="{Binding UnderstandingDone}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="MsgRoot" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>
                  <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="DurationRow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TimeStamp" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Padding" Value="10,15" />
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="18" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#147EADE3" />
                    <Setter TargetName="Bubble" Property="Background" Value="#1F77A7E0" />
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="520" />
                    <Setter TargetName="Body" Property="FontSize" Value="13" />
                    <Setter TargetName="Body" Property="LineHeight" Value="22" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsNotice}" Value="True">
                    <Setter TargetName="Bubble" Property="Padding" Value="2,0" />
                    <Setter TargetName="Body" Property="FontSize" Value="11.5" />
                    <Setter TargetName="Body"
                            Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                    <Setter TargetName="TimeStamp" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="1" x:Name="LatestBtn" Content="↓" Click="Latest_Click"
                Style="{StaticResource AiLatestButton}" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,10"
                ToolTip="回到最新消息" />
      </Grid>

      <!-- 确认条：参考 .ai-inline-confirm（卡片 + details「查看完整路径与操作说明」） -->
      <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="14" Padding="14,11"
              BorderThickness="1" BorderBrush="#4DE0A03C" Background="#12E0A03C"
              Visibility="{Binding HasPendingConfirm, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <TextBlock Text="允许本次操作？" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Strong}" />
          <TextBlock Text="{Binding ConfirmTitle, Mode=OneWay}" FontSize="12" Margin="0,5,0,0"
                     TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Strong}" />
          <ToggleButton x:Name="ConfirmFold" Style="{StaticResource AiDetailToggle}"
                        Content="查看完整路径与操作说明" IsChecked="False" />
          <Border Style="{StaticResource AiDetailRows}"
                  Visibility="{Binding ElementName=ConfirmFold, Path=IsChecked, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource AiMono}" Text="{Binding ConfirmTarget, Mode=OneWay}" />
              <TextBlock Style="{StaticResource AiMono}" Text="{Binding ConfirmExtra, Mode=OneWay}"
                         Margin="0,6,0,0" Foreground="#E8B96A"
                         Visibility="{Binding HasConfirmExtra, Converter={StaticResource BoolVis}}" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="拒绝" Command="{Binding DenyConfirmCommand}" Margin="0,0,8,0"
                    Style="{StaticResource AiGhostButton}" />
            <Button Content="本轮都允许" Command="{Binding AllowTurnCommand}" Margin="0,0,8,0"
                    Style="{StaticResource AiGhostButton}" />
            <Button Content="允许一次" Command="{Binding AllowOnceCommand}"
                    Style="{StaticResource AiPrimaryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- .ai-composer：状态行 + 输入 + 发送/停止 -->
      <Border Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="12,10"
              CornerRadius="14" BorderThickness="1"
              BorderBrush="#1CFFFFFF" Background="#10FFFFFF">
        <StackPanel>
          <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11.5" Margin="0,0,0,6"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.Text.Muted}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="140"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource Brush.Text.Strong}"
                       CaretBrush="{DynamicResource Brush.Accent.Primary}"
                       SelectionBrush="{DynamicResource Brush.Accent.Primary}" SelectionOpacity="0.32"
                       FontSize="13" KeyDown="InputBox_KeyDown" />
              <TextBlock Text="问点什么…  Enter 发送 · Shift+Enter 换行"
                         Margin="3,3,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                         FontSize="12.5" Foreground="{DynamicResource Brush.Text.Muted}"
                         Visibility="{Binding IsInputEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
              <Button Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,0"
                      Style="{StaticResource AiGhostButton}" />
              <Button Content="发送" Command="{Binding SendCommand}"
                      Style="{StaticResource AiPrimaryButton}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= 右：设置 ================= -->
    <!--
      版式说明：每张卡 = 卡片头（6px 主题色竖条 + 标题 + 发丝分隔线）+ 若干「标签 / 开关」行。
      开关用全应用统一的 LauncherSwitchToggleButtonStyle（46×28 玻璃轨道），
      不再用原生 CheckBox —— 原生方框在深色玻璃面上像上个时代的控件。
    -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MainContentScrollBarStyle}" />
      </ScrollViewer.Resources>
      <StackPanel>

        <!-- 本周额度：放最上面，因为「还能不能聊」比任何开关都先被关心 -->
        <Border Style="{StaticResource AiSideCard}" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent.Primary}" />
              <TextBlock Grid.Column="1" Style="{StaticResource AiSideTitle}" Margin="8,0,0,0" Text="本周额度" />
              <TextBlock Grid.Column="2" Text="周一 00:00 重置" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Text.Muted}" />
            </Grid>

            <TextBlock Text="{Binding QuotaSummary}"
                       FontSize="18" FontWeight="SemiBold" Margin="0,2,0,8"
                       Foreground="{DynamicResource Brush.Text.Strong}" />

            <ProgressBar Value="{Binding QuotaPercent, Mode=OneWay}" Maximum="100" Height="5"
                         Background="#1AFFFFFF" BorderThickness="0">
              <ProgressBar.Style>
                <Style TargetType="{x:Type ProgressBar}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5" ClipToBounds="True">
                          <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding QuotaWarning}" Value="True">
                      <Setter Property="Foreground" Value="#E8B96A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Style="{StaticResource AiHint}" Margin="0,8,0,0" Text="{Binding QuotaDetail}" />

            <TextBlock Style="{StaticResource AiHint}" Margin="0,6,0,0" Foreground="#E8B96A"
                       Text="额度快用完了。额度按 DeepSeek 实际 token 计费折算，用完要等下周一。"
                       Visibility="{Binding QuotaWarning, Converter={StaticResource BoolVis}}" />
          </StackPanel>
        </Border>

        <!-- 模式 -->
        <Border Style="{StaticResource AiSideCard}" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent.Primary}" />
              <TextBlock Grid.Column="1" Style="{StaticResource AiSideTitle}" Margin="8,0,0,0" Text="模式" />
            </Grid>

            <Grid Height="34">
              <TextBlock Style="{StaticResource AiRowLabel}" Text="Agent 模式" />
              <CheckBox Style="{StaticResource AiSwitch}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsChecked="{Binding IsAgentMode, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditPermissions}" />
            </Grid>
            <TextBlock Style="{StaticResource AiHint}"
                       Text="打开后我才能动你的文件、跑命令；关掉只聊天，什么都不碰。" />

            <Border Style="{StaticResource AiDivider}" />

            <Grid Height="34">
              <TextBlock Style="{StaticResource AiRowLabel}" Text="显示思考过程" />
              <CheckBox Style="{StaticResource AiSwitch}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsChecked="{Binding UseReasoning, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditPermissions}" />
            </Grid>
            <TextBlock Style="{StaticResource AiHint}"
                       Text="用 deepseek-reasoner，思考过程默认折叠，想看点开就能看。Agent 模式固定用 deepseek-chat。" />
          </StackPanel>
        </Border>

        <!-- 权限（三态：禁止 / 询问 / 允许） -->
        <Border Style="{StaticResource AiSideCard}" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent.Primary}" />
              <TextBlock Grid.Column="1" Style="{StaticResource AiSideTitle}" Margin="8,0,0,0" Text="权限" />
              <TextBlock Grid.Column="2" Text="随 Agent 模式生效" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Text.Muted}" />
            </Grid>

            <!-- Agent 关着时明确说一句，别让人以为设了就在生效 -->
            <TextBlock Style="{StaticResource AiHint}" Margin="0,0,0,8" Foreground="#E8B96A"
                       Text="Agent 模式已关闭 —— 下面三项现在不生效，模型连工具都没有。"
                       Visibility="{Binding AgentOffHintVisible, Converter={StaticResource BoolVis}}" />

            <!-- 读 -->
            <TextBlock Style="{StaticResource AiRowLabel}" Text="读取文件 / 列目录" Margin="0,0,0,5" />
            <Border Style="{StaticResource AiSegTrack}" IsEnabled="{Binding PermissionsEnabled}">
              <UniformGrid Columns="3" Height="26">
                <RadioButton Style="{StaticResource AiSegDeny}" Content="禁止" GroupName="SegRead"
                             IsChecked="{Binding ReadDeny, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAsk}" Content="询问" GroupName="SegRead"
                             IsChecked="{Binding ReadAsk, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAllow}" Content="允许" GroupName="SegRead"
                             IsChecked="{Binding ReadAllow, Mode=TwoWay}" />
              </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource AiHint}" Margin="0,5,0,11"
                       Text="{Binding ReadPolicyHint, Mode=OneWay}" />

            <Border Style="{StaticResource AiDivider}" Margin="0,0,0,11" />

            <!-- 写 -->
            <TextBlock Style="{StaticResource AiRowLabel}" Text="写入 / 覆盖文件" Margin="0,0,0,5" />
            <Border Style="{StaticResource AiSegTrack}" IsEnabled="{Binding PermissionsEnabled}">
              <UniformGrid Columns="3" Height="26">
                <RadioButton Style="{StaticResource AiSegDeny}" Content="禁止" GroupName="SegWrite"
                             IsChecked="{Binding WriteDeny, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAsk}" Content="询问" GroupName="SegWrite"
                             IsChecked="{Binding WriteAsk, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAllow}" Content="允许" GroupName="SegWrite"
                             IsChecked="{Binding WriteAllow, Mode=TwoWay}" />
              </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource AiHint}" Margin="0,5,0,11"
                       Text="{Binding WritePolicyHint, Mode=OneWay}" />

            <Border Style="{StaticResource AiDivider}" Margin="0,0,0,11" />

            <!-- 执行 -->
            <TextBlock Style="{StaticResource AiRowLabel}" Text="执行命令（cmd）" Margin="0,0,0,5" />
            <Border Style="{StaticResource AiSegTrack}" IsEnabled="{Binding PermissionsEnabled}">
              <UniformGrid Columns="3" Height="26">
                <RadioButton Style="{StaticResource AiSegDeny}" Content="禁止" GroupName="SegExec"
                             IsChecked="{Binding ExecDeny, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAsk}" Content="询问" GroupName="SegExec"
                             IsChecked="{Binding ExecAsk, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AiSegAllow}" Content="允许" GroupName="SegExec"
                             IsChecked="{Binding ExecAllow, Mode=TwoWay}" />
              </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource AiHint}" Margin="0,5,0,0"
                       Text="{Binding ExecPolicyHint, Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!-- 工作目录 -->
        <Border Style="{StaticResource AiSideCard}" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent.Primary}" />
              <TextBlock Grid.Column="1" Style="{StaticResource AiSideTitle}" Margin="8,0,0,0" Text="工作目录" />
            </Grid>

            <TextBox Style="{StaticResource AiField}" FontSize="11.5" Margin="0,0,0,6"
                     Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource AiMono}" FontSize="10.5" Margin="0,0,0,10"
                       Text="{Binding EffectiveRoot, Mode=OneWay}" />
            <Button Content="选择目录…" Command="{Binding PickFolderCommand}" HorizontalAlignment="Left"
                    Style="{StaticResource AiGhostButton}" />
            <TextBlock Style="{StaticResource AiHint}" Margin="0,10,0,0"
                       Text="所有读写路径都被限制在这个目录内，越界直接拒绝。留空 = 用户目录。" />
          </StackPanel>
        </Border>

        <!-- 其它 -->
        <Border Style="{StaticResource AiSideCard}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent.Primary}" />
              <TextBlock Grid.Column="1" Style="{StaticResource AiSideTitle}" Margin="8,0,0,0" Text="其它" />
            </Grid>

            <StackPanel Orientation="Horizontal">
              <Button Content="清空" Command="{Binding ClearCommand}" Margin="0,0,8,0"
                      Style="{StaticResource AiGhostButton}" />
              <Button Content="检查服务端" Command="{Binding CheckHealthCommand}"
                      Style="{StaticResource AiGhostButton}" />
            </StackPanel>
            <TextBlock Style="{StaticResource AiHint}" Margin="0,10,0,0"
                       Text="密钥只在服务器上，安装包里没有。默认连 cloudfurhub.cn，连不上自动切备用域。" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
