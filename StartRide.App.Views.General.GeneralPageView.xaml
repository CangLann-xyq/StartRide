<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.General.GeneralPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Focusable="False" xmlns:general="clr-namespace:StartRide.App.Views.General;assembly=StartRide">
  <ScrollViewer Name="PageRoot" Margin="28,64,20,20" Visibility="{Binding CurrentPage, Converter={StaticResource FallbackPageVisibilityConverter}}">
    <ScrollViewer.Style>
      <Style BasedOn="{StaticResource MainContentScrollViewerStyle}" TargetType="{x:Type ScrollViewer}" />
    </ScrollViewer.Style>
    <StackPanel>
      <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding CurrentPage, Converter={StaticResource PageTitleConverter}}" />
      <TextBlock Style="{StaticResource PageStatusTextStyle}" Text="{Binding StatusMessage}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>