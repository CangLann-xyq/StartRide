<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.GameSettings.InstanceBackupSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:Launcher.App.Behaviors" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:gameSettings="clr-namespace:Launcher.App.ViewModels.GameSettings" xmlns:res="clr-namespace:Launcher.App.Resources" xmlns:views="clr-namespace:Launcher.App.Views.GameSettings" x:Name="Root" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/GameSettings/GameSettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="{DataTemplateKey {x:Type gameSettings:BackupManagementInfoPanelItem}}" DataType="{x:Type gameSettings:BackupManagementInfoPanelItem}">
        <GroupBox Header="{x:Static res:Strings.GameSettings_BackupInfoSection}" Margin="0,0,0,12" Style="{StaticResource LauncherContentSectionStyle}">
          <StackPanel>
            <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
              <TextBlock Style="{StaticResource ReadOnlyFieldTextStyle}" Text="{Binding DataContext.BackupInfoText, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" />
            </Border>
            <TextBlock Margin="0,12,0,8" Text="{x:Static res:Strings.GameSettings_BackupDirectorySection}" Style="{StaticResource ManagementListSectionHeaderTextStyle}" />
            <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
              <TextBlock Style="{StaticResource ReadOnlyFieldTextStyle}" Text="{Binding DataContext.BackupDirectoryText, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" />
            </Border>
            <WrapPanel Margin="0,12,0,0">
              <Button Margin="0,0,8,4" Content="{x:Static res:Strings.GameSettings_BackupOpenFolderButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" />
              <Button Margin="0,0,8,4" Content="{x:Static res:Strings.GameSettings_BackupChangeDirectoryButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.ChangeBackupDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" />
              <Button Margin="0,0,8,4" Content="{x:Static res:Strings.GameSettings_BackupCreateNowButton}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Command="{Binding DataContext.CreateBackupNowCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type gameSettings:BackupManagementListSectionItem}}" DataType="{x:Type gameSettings:BackupManagementListSectionItem}">
        <TextBlock Text="{x:Static res:Strings.GameSettings_BackupListSection}" Style="{StaticResource ManagementListSectionHeaderTextStyle}" />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type gameSettings:InstanceBackupItemViewModel}}" DataType="{x:Type gameSettings:InstanceBackupItemViewModel}">
        <controls:ListPageItemButton Style="{StaticResource ListPageItemButtonEntranceStyle}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" TrailingText="{Binding TrailingText}" IconKey="{Binding IconKey}" IsSelected="{Binding IsSelected}" IsFirstVisible="{Binding Tag.IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsLastVisible="{Binding Tag.IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" IsPreviousItemHighlighted="{Binding Tag.IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" ShouldPlayEnterAnimation="{Binding Tag.ShouldPlayEnterAnimation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" EnterAnimationIndex="{Binding Tag.EnterAnimationIndex, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Command="{Binding DataContext.SelectBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" CommandParameter="{Binding}">
          <controls:ListPageItemButton.TrailingContent>
            <StackPanel Orientation="Horizontal">
              <Button ToolTip="{x:Static res:Strings.GameSettings_BackupRestoreTooltip}" Style="{StaticResource InlineIconButtonStyle}" Command="{Binding DataContext.RequestRestoreBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" CommandParameter="{Binding}">
                <controls:SvgIcon Width="16" Height="16" IconKey="instance_setting_page/recover" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
              </Button>
              <Button Margin="4,0,0,0" ToolTip="{x:Static res:Strings.GameSettings_BackupOpenLocationTooltip}" Style="{StaticResource InlineIconButtonStyle}" Command="{Binding DataContext.OpenBackupLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" CommandParameter="{Binding}">
                <controls:SvgIcon Width="16" Height="16" IconKey="general/general_folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
              </Button>
              <Button Margin="4,0,0,0" ToolTip="{x:Static res:Strings.Delete_Button}" Style="{StaticResource SecondaryMenuDeleteButtonStyle}" Command="{Binding DataContext.RequestDeleteBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type views:InstanceBackupSettingsView}}}" CommandParameter="{Binding}">
                <controls:SvgIcon Width="16" Height="16" IconKey="general/general_delete" Style="{StaticResource DangerActionSvgIconStyle}" />
              </Button>
            </StackPanel>
          </controls:ListPageItemButton.TrailingContent>
        </controls:ListPageItemButton>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid ClipToBounds="True">
    <controls:DeferredListContentHost IsListVisible="{Binding CanShowBackupScrollableContent}">
      <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" behaviors:VirtualizedListItemStateBehavior.IsEnabled="True" behaviors:VirtualizedListItemStateBehavior.ContentTopOffset="132" ItemsSource="{Binding VisibleBackupListItems}" behaviors:VirtualizedListItemStateBehavior.EntranceAnimationToken="{Binding ListEntranceAnimationToken}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Margin="12,132,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ListBox>
    </controls:DeferredListContentHost>
    <TextBlock Margin="12,260,12,0" Text="{x:Static res:Strings.GameSettings_BackupLoading}" Style="{StaticResource PageEmptyStateTextStyle}" Visibility="{Binding CanShowBackupLoadingState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    <TextBlock Margin="12,260,12,0" Style="{StaticResource PageEmptyStateTextStyle}" Text="{Binding BackupEmptyMessage}" Visibility="{Binding CanShowBackupEmptyState, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
  </Grid>
</UserControl>