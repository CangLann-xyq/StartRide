<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Account.Dialogs.RenameAccountDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StartRide.App.Resources" xmlns:controls="clr-namespace:StartRide.App.Controls" Focusable="False" xmlns:dialogs="clr-namespace:StartRide.App.Views.Account.Dialogs">
  <Grid Style="{StaticResource DialogContentGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="{Binding Dialog.RenameAccountDialogTitle}" />
      <TextBlock Style="{StaticResource DialogSubtitleTextStyle}" Text="{Binding Dialog.RenameAccountDialogSubtitle}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsRenameAccountInputStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <TextBlock Text="{x:Static res:Strings.Account_NewUsernameLabel}" Style="{StaticResource DialogFieldLabelTextStyle}" />
      <TextBox Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding Dialog.RenameAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="{x:Static res:Strings.Account_UsernameValidation}" Style="{StaticResource DialogValidationTextStyle}" Visibility="{Binding Dialog.IsRenameAccountNameInvalid, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" Visibility="{Binding Dialog.IsRenameAccountMessageStep, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Grid Width="34" Height="34" HorizontalAlignment="Center">
        <controls:SvgIcon Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="{Binding Dialog.RenameAccountIconKey}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type controls:SvgIcon}">
              <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Dialog.RenameAccountIconKey}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Dialog.IsRenameAccountResultStep}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.FF8A8A}" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Dialog.IsRenameAccountSuccessful}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.7DFFB2}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </controls:SvgIcon>
        <TextBlock FontFamily="{DynamicResource LauncherIconFontFamily}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Dialog.RenameAccountIcon}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Dialog.RenameAccountIconKey}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
      <TextBlock Margin="0,16,0,0" Style="{StaticResource DialogBodyTextStyle}" TextAlignment="Center" Text="{Binding Dialog.RenameAccountMessage}" />
      <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Dialog.RenameAccountErrorCodeMessage}" Visibility="{Binding Dialog.HasRenameAccountErrorCode, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    </StackPanel>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
      <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding RequestCancelRenameAccountDialogCommand}" Visibility="{Binding Dialog.CanShowRenameAccountCancelButton, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <Button Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Margin="{StaticResource DialogTrailingButtonMargin}" Content="{x:Static res:Strings.Confirm_Button}" IsEnabled="{Binding Dialog.CanConfirmRenameAccountDialog}" Command="{Binding RequestConfirmRenameAccountDialogCommand}" />
    </StackPanel>
  </Grid>
</UserControl>