<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Vehicles.VehiclesPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StartRide.App.Resources" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:vehicles="clr-namespace:StartRide.App.ViewModels.Vehicles" xmlns:views="clr-namespace:StartRide.App.Views.Vehicles" x:Name="Root" Focusable="False">

  <Grid Name="PageRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="*" MinWidth="600" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource RideSidebarSurfaceStyle}">
      <Grid>
        <ListBox Background="{x:Null}" BorderThickness="0" Padding="0" PreviewMouseLeftButtonDown="VehiclesList_PreviewMouseLeftButtonDown" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource RideWideListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Vehicles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Margin="8,12,8,20" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vehicles:VehicleItem}">
              <controls:ListPageItemButton IconKey="beamng/car" IconWidth="21" IconHeight="21" IconColumnWidth="58" IconMargin="8,0,0,0" IconTileBackground="#12FFFFFF" IconTileBorderBrush="#1FFFFFFF" IconTileBorderThickness="1" IconTilePadding="9" IconTileCornerRadius="11" Title="{Binding DisplayName}" Subtitle="{Binding FileName}" TrailingText="{Binding FileSizeText}" TrailingFontSize="12.5" SubtitleFontSize="11.5" IsSelected="{Binding IsSelected}" ToolTip="{x:Static res:Strings.Vehicles_ListItemTooltip}" Command="{Binding DataContext.SelectVehicleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Margin="26,28,26,0" Text="{Binding StatusMessage}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding HasVehicles}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="30,18,30,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="24" Height="24" Margin="0,0,11,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="/StartRide;component/Assets/Branding/beamng_logo_256.png" />
          <TextBlock Style="{StaticResource RidePageTitleTextStyle}" Text="{x:Static res:Strings.Page_Download}" />
        </StackPanel>

        <TextBlock Grid.Column="1" Margin="14,0,14,0" Style="{StaticResource RidePageSubtitleTextStyle}" Text="{Binding VehiclesDirectory}" ToolTip="{Binding VehiclesDirectory}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{x:Static res:Strings.Vehicles_OpenModsFolderButton}" Command="{Binding OpenModsFolderCommand}" Style="{StaticResource LauncherDialogButtonStyle}" ToolTip="{x:Static res:Strings.Vehicles_OpenModsFolderTooltip}" />
          <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Vehicles_OpenVehiclesFolderButton}" Command="{Binding OpenVehiclesFolderCommand}" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" ToolTip="{x:Static res:Strings.Vehicles_OpenVehiclesFolderTooltip}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="30,14,30,0" Style="{StaticResource RideStatStripStyle}">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{Binding StatBandText}" />
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource RideStatChipStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipValueStyle}" Text="{Binding StatCountText}" />
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Vehicles_StatChipCountLabel}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RideStatChipStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipValueStyle}" Text="{Binding StatTotalText}" />
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Vehicles_StatChipTotalLabel}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RideStatChipStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipValueStyle}" Text="{Binding StatAverageText}" />
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Vehicles_StatChipAverageLabel}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RideStatChipStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RideStatChipValueStyle}" Text="{Binding StatMaxText}" />
                <TextBlock Style="{StaticResource RideStatChipLabelStyle}" Text="{x:Static res:Strings.Vehicles_StatChipMaxLabel}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2" Margin="30,12,30,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="150" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:SearchTextBox VerticalAlignment="Center" KeyDown="VehicleSearch_KeyDown" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:Strings.Vehicles_SearchTooltip}" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{x:Static res:Strings.Vehicles_SortByNameButton}" Command="{Binding SortByNameCommand}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource LauncherDialogButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="Opacity" Value="0.55" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsSortByName}">
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Button>
          <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Vehicles_SortBySizeButton}" Command="{Binding SortBySizeCommand}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource LauncherDialogButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="Opacity" Value="0.55" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsSortBySize}">
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Button>
          <Border Width="1" Margin="12,6,12,6" Background="#1AFFFFFF" />
          <controls:AnimatedComboBox Width="94" Height="32" VerticalAlignment="Center" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" ToolTip="{x:Static res:Strings.Vehicles_SourceFilterTooltip}" />
          <Border Width="1" Margin="12,6,12,6" Background="#1AFFFFFF" />
          <Button Content="{x:Static res:Strings.Vehicles_RefreshButton}" Command="{Binding RefreshCommand}" Style="{StaticResource LauncherDialogButtonStyle}" ToolTip="{x:Static res:Strings.Vehicles_RefreshTooltip}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Margin="24,16,30,18" Style="{StaticResource RideDetailSurfaceStyle}">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type StackPanel}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding HasSelection}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <controls:SvgIcon Width="30" Height="30" HorizontalAlignment="Center" IconKey="beamng/car" Foreground="{DynamicResource Brush.Text.Subtle}" />
            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{x:Static res:Strings.Vehicles_EmptyDetailHint}" />
          </StackPanel>

          <StackPanel>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type StackPanel}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding HasSelection}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Style="{StaticResource RideDetailTitleStyle}" Text="{Binding SelectedTitle}" />
            <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{Binding SelectedPercentText}" />

            <Border Style="{StaticResource RideHairlineStyle}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource RideDetailMetaLabelStyle}" Text="{x:Static res:Strings.Vehicles_DetailSourceLabel}" />
              <TextBlock Style="{StaticResource RideDetailMetaValueStyle}" Text="{Binding SelectedSourceText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource RideDetailMetaLabelStyle}" Text="{x:Static res:Strings.Vehicles_DetailVehicleIdLabel}" />
              <TextBlock Style="{StaticResource RideDetailMetaValueStyle}" Text="{Binding SelectedVehicleId}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource RideDetailMetaLabelStyle}" Text="{x:Static res:Strings.Vehicles_DetailFileLabel}" />
              <TextBlock Style="{StaticResource RideDetailMetaValueStyle}" Text="{Binding SelectedFileName}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource RideDetailMetaLabelStyle}" Text="{x:Static res:Strings.Vehicles_DetailSizeLabel}" />
              <TextBlock Style="{StaticResource RideDetailMetaValueStyle}" Text="{Binding SelectedSizeText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource RideDetailMetaLabelStyle}" Text="{x:Static res:Strings.Vehicles_DetailDirectoryLabel}" />
              <TextBlock Style="{StaticResource RideDetailMetaValueStyle}" Text="{Binding SelectedDirectoryPath}" />
            </StackPanel>

            <Border Style="{StaticResource RideHairlineStyle}" />

            <Button HorizontalAlignment="Stretch" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{x:Static res:Strings.Vehicles_RevealButton}" Command="{Binding RevealSelectedCommand}" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Vehicles_CopyPathButton}" Command="{Binding CopyVehiclePathCommand}" CommandParameter="{Binding SelectedVehicle}" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Vehicles_CopyIdButton}" Command="{Binding CopyVehicleIdCommand}" CommandParameter="{Binding SelectedVehicle}" ToolTip="{x:Static res:Strings.Vehicles_CopyIdTooltip}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
