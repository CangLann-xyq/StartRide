<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Account.AccountDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:StartRide.App.Behaviors" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:models="clr-namespace:StartRide.App.Models" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:accountControls="clr-namespace:StartRide.App.Controls.Account" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:account="clr-namespace:StartRide.App.Views.Account">
  <Grid Name="PART_ProgressiveBlurLayer" Background="#00FFFFFF" behaviors:VerticalEdgeOpacityMask.IsEnabled="True" behaviors:VerticalEdgeOpacityMask.TopFadeLength="70" behaviors:VerticalEdgeOpacityMask.TopIntermediateLength="30" behaviors:VerticalEdgeOpacityMask.BottomFadeLength="72" behaviors:VerticalEdgeOpacityMask.MinimumOpacity="0">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Grid}">
        <Setter Property="behaviors:VerticalEdgeOpacityMask.TopIntermediateOpacity" Value="0.1" />
      </Style>
    </FrameworkElement.Style>
    <Grid Name="PART_ProgressiveBlurDirectHost" SnapsToDevicePixels="True">
      <Grid Name="PART_ProgressiveBlurVisualSource" Background="#00FFFFFF">
        <ScrollViewer Name="AccountDetailsScrollViewer" Style="{StaticResource ListPageScrollViewerStyle}">
          <StackPanel Name="DetailsContentRoot" Margin="12,132,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
            <UIElement.RenderTransform>
              <TranslateTransform />
            </UIElement.RenderTransform>
            <!-- StartRide：Steam 头像（有则显示真图，本地缓存/远程 URL），无头像回退首字母圆形 -->
            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Left" Background="#FF1B2838" BorderBrush="#FF2A475E" BorderThickness="1.5" ClipToBounds="True">
              <Grid>
                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding AccountList.SelectedAccount.AvatarSource}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Image}">
                      <Setter Property="Visibility" Value="{Binding AccountList.SelectedAccount.AvatarSource, Converter={StaticResource BlankToCollapsedConverter}}" />
                    </Style>
                  </FrameworkElement.Style>
                </Image>
                <TextBlock Text="{Binding AccountList.SelectedAccount.DisplayName, Converter={StaticResource StringInitialConverter}}" FontSize="28" FontWeight="SemiBold" Foreground="#FF66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AccountList.SelectedAccount.AvatarSource}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AccountList.SelectedAccount.AvatarSource}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </Grid>
            </Border>
            <Grid Margin="0,18,0,0" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource RidePageTitleTextStyle}" VerticalAlignment="Center" Text="{Binding AccountList.SelectedAccount.DisplayName}" />
              <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource InlineIconButtonStyle}" IsEnabled="{Binding CanRenameSelectedAccount}" Visibility="{Binding CanRenameSelectedAccount, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" Command="{Binding RequestRenameAccountCommand}">
                <controls:SvgIcon Width="16" Height="16" IconKey="general/general_edit" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
              </Button>
            </Grid>
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12.5" Text="{Binding AccountList.SelectedAccount, Converter={StaticResource AccountKindTextConverter}}" />
            <StackPanel Margin="0,26,0,0">
              <GroupBox Header="{x:Static res:Strings.Account_UuidHeader}" Style="{StaticResource RideSectionStyle}">
                <StackPanel>
                  <Border Style="{StaticResource RideFieldSurfaceStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource ReadOnlyFieldTextStyle}" Text="{Binding OfflineUuid.SelectedAccountUuidText}" />
                      <Button Grid.Column="1" Margin="10,-4,-6,-4" Style="{StaticResource InlineIconButtonStyle}" Command="{Binding OfflineUuid.CopySelectedUuidCommand}">
                        <controls:SvgIcon Width="16" Height="16" IconKey="general/general_copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                      </Button>
                    </Grid>
                  </Border>
                  <Grid Margin="0,12,0,0" Visibility="{Binding OfflineUuid.HasSelectedOfflineAccount, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Account_OfflineUuidModeLabel}" Foreground="{DynamicResource Brush.CFFFFFFF}" FontSize="13" VerticalAlignment="Center" />
                    <controls:AnimatedComboBox Grid.Column="1" Style="{StaticResource LauncherComboBoxStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ItemsSource="{Binding OfflineUuid.OfflineUuidOptions}" SelectedItem="{Binding OfflineUuid.SelectedOfflineUuidOption, Mode=TwoWay}" IsEnabled="{Binding OfflineUuid.CanChangeOfflineUuidMode}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:OfflineUuidModeOption}">
                          <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </controls:AnimatedComboBox>
                  </Grid>
                  <Grid Margin="0,12,0,0" Visibility="{Binding OfflineUuid.HasManualUuidEditor, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="36" FontSize="12" Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding OfflineUuid.ManualUuidText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{x:Static res:Strings.Apply_Button}" IsEnabled="{Binding OfflineUuid.CanApplyManualUuid}" Command="{Binding OfflineUuid.ApplyManualUuidCommand}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="2,8,0,0" Text="{x:Static res:Strings.Account_OfflineUuidInvalid}" Foreground="{DynamicResource Brush.FFFF8A8A}" FontSize="12" Visibility="{Binding OfflineUuid.IsManualUuidInvalid, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
                  </Grid>
                </StackPanel>
              </GroupBox>
              <!-- StartRide：已删除 Minecraft 皮肤/披风管理（BeamNG 联机无需皮肤）。 -->
              <GroupBox Margin="0,14,0,0" Header="{x:Static res:Strings.Account_IdentityHeader}" Style="{StaticResource RideSectionStyle}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Brush.0891FE}" VerticalAlignment="Center">
                      <controls:SvgIcon Width="26" Height="26" IconKey="general/general_person" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="14" FontWeight="SemiBold" Text="{Binding AccountList.SelectedAccount.DisplayName}" />
                      <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="12" Text="联机昵称" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Name="PART_ProgressiveBlurViewport" HorizontalAlignment="Stretch" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False" SnapsToDevicePixels="True" Visibility="Collapsed">
      <Grid Name="PART_ProgressiveBlurUpscaleHost" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="Linear">
        <UIElement.RenderTransform>
          <ScaleTransform x:Name="PART_ProgressiveBlurUpscaleTransform" ScaleX="1" ScaleY="1" />
        </UIElement.RenderTransform>
        <Grid Name="PART_ProgressiveBlurVerticalHost" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Name="PART_ProgressiveBlurHorizontalHost" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
              <VisualBrush x:Name="PART_ProgressiveBlurBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill" TileMode="None" />
            </Border.Background>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>