<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Settings.ThemeSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animation="clr-namespace:Launcher.App.Behaviors.Animation" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:settings="clr-namespace:Launcher.App.Views.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <GroupBox Header="{x:Static res:Strings.Settings_ThemeSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_ThemeFollowSystemLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <CheckBox Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding FollowSystemTheme, Mode=TwoWay}" />
          </Grid>
          <Grid Margin="0,18,0,0" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding IsThemeSelectionVisible}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_ThemeSelectionLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource ThemeOptionTemplate}" SelectionItemTemplate="{StaticResource ThemeOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,18,0,0" Header="{x:Static res:Strings.Settings_AccentSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static res:Strings.Settings_AccentSelectionLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
          <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource AccentColorOptionTemplate}" SelectionItemTemplate="{StaticResource AccentColorOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding AccentColorOptions}" SelectedItem="{Binding SelectedAccentColorOption, Mode=TwoWay}" />
        </Grid>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,18,0,0" Header="{x:Static res:Strings.Settings_BackgroundSection}" Style="{StaticResource LauncherContentSectionStyle}">
      <Border Style="{StaticResource SectionFieldSurfaceStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_BackgroundSection}" Style="{StaticResource SettingsOptionTextStyle}" />
            <controls:AnimatedComboBox Grid.Column="1" ItemTemplate="{StaticResource BackgroundEffectOptionTemplate}" SelectionItemTemplate="{StaticResource BackgroundEffectOptionTemplate}" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding BackgroundEffectOptions}" SelectedItem="{Binding SelectedBackgroundEffectOption, Mode=TwoWay}" />
          </Grid>
          <Grid Margin="0,18,0,0" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding IsBackgroundImageSelectionVisible}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{x:Static res:Strings.Settings_BackgroundImageSelectionLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
              <TextBlock Margin="0,4,16,0" Text="{x:Static res:Strings.Settings_BackgroundImageSelectionDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_BackgroundImageOpenFolderButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding OpenLauncherBackgroundImageFolderCommand}" />
            <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_BackgroundImageRefreshButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding RefreshLauncherBackgroundImageCommand}" />
            <Button Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_BackgroundImageClearButton}" Style="{StaticResource LauncherDangerDialogButtonStyle}" Command="{Binding ClearLauncherBackgroundImagesCommand}" />
          </Grid>
          <Grid Margin="0,18,0,0" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding IsBackgroundImageSelectionVisible}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{x:Static res:Strings.Settings_BackgroundImageControlBlurLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
              <TextBlock Margin="0,4,16,0" Text="{x:Static res:Strings.Settings_BackgroundImageControlBlurDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource LauncherSwitchToggleButtonStyle}" IsChecked="{Binding EnableImageBackgroundControlBlur, Mode=TwoWay}" />
          </Grid>
          <Grid Margin="0,18,0,0" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding IsBackgroundOpacityVisible}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="162" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_BackgroundOpacityLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" Style="{StaticResource LauncherSliderStyle}" Value="{Binding LauncherBackgroundOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource ReadOnlyFieldTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding LauncherBackgroundOpacityText}" />
          </Grid>
        </StackPanel>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>