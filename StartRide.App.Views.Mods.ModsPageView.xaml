<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Mods.ModsPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:mods="clr-namespace:StartRide.App.ViewModels.Mods" x:Name="Root" Focusable="False">
  <!-- StartRide：ListPageFrame 铺满整页（其内部头部自带约 70px 留白），标题与工具栏覆盖进头部区域，消除空洞 -->
  <Grid Name="PageRoot">
    <controls:ListPageFrame x:Name="ModsListFrame" Margin="24,8,24,8" IsProgressiveBlurEnabled="{DynamicResource Is.ProgressiveBlur.Enabled}" UseFrameScrollViewer="True" Title="" IsListVisible="{Binding IsLocalView}" IsSearchVisible="False">
      <controls:ListPageFrame.ListContent>
        <Grid Tag="ModsListStep">
          <ListBox ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Mods}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Margin="12,32,12,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type mods:ModItem}">
                <!-- IconKey 必须写 目录/文件名 双前缀；不写的话左侧 50px 图标列是空的 -->
                <controls:ListPageItemButton IconKey="beamng/mod" IconWidth="30" IconHeight="30" Title="{Binding Name}" Subtitle="{Binding FileSizeText}" ToolTip="点击在资源管理器中定位该模组" Command="{Binding DataContext.RevealModCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <TextBlock Margin="12,32,12,0" Text="{Binding StatusMessage}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource PageEmptyStateTextStyle}" TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding HasMods}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </Grid>
      </controls:ListPageFrame.ListContent>
    </controls:ListPageFrame>

    <!-- 在线仓库列表（覆盖在本机列表之上） -->
    <Grid Margin="24,108,24,8" Visibility="{Binding IsOnlineView, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 下载进度文字（仅下载中显示） -->
      <TextBlock Grid.Row="0" Margin="0,0,0,6" Foreground="{DynamicResource Brush.CCFFFFFF}" FontSize="12" Text="{Binding DownloadStatusText}" Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />

      <!-- 状态行：拉取状态 + 刷新 -->
      <DockPanel Grid.Row="1" Margin="0,4,0,8" LastChildFill="True">
        <Button DockPanel.Dock="Right" Height="32" MinWidth="76" HorizontalAlignment="Right" Style="{StaticResource LauncherDialogButtonStyle}" Content="刷新" Command="{Binding RefreshRepositoryCommand}" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.CCFFFFFF}" FontSize="12" Text="{Binding RepositoryStatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- 在线列表：虚拟化 ListBox（上万条目也只渲染可见卡片），
           滚动到底自动续拉下一波页面，直到拉完全库 -->
      <ListBox Grid.Row="2" x:Name="RepositoryListBox" ScrollViewer.ScrollChanged="OnRepositoryScrollChanged" ItemContainerStyle="{StaticResource ListPageVirtualizedListBoxItemStyle}" Style="{StaticResource ListPageVirtualizedListBoxStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Background="{x:Null}" BorderThickness="0" Padding="0" ItemsSource="{Binding RepositoryMods}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Margin="0,0,0,64" IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type mods:RepositoryModItem}">
            <Border Margin="0,0,0,10" Padding="16,14" BorderBrush="{DynamicResource Brush.284E4E4E}" BorderThickness="1" CornerRadius="12" Background="#22FFFFFF">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource Brush.F4F4F4}" FontSize="14.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="430" />
                    <Border Margin="8,0,0,0" Padding="8,3" VerticalAlignment="Center" Background="#1EFFFFFF" CornerRadius="9">
                      <TextBlock Foreground="{DynamicResource Brush.CCFFFFFF}" FontSize="11" Text="{Binding Category}" />
                    </Border>
                    <Border Margin="8,0,0,0" Padding="8,3" VerticalAlignment="Center" Background="#1EFFFFFF" CornerRadius="9" Visibility="{Binding Version, Converter={StaticResource BlankToCollapsedConverter}}">
                      <TextBlock Foreground="{DynamicResource Brush.CCFFFFFF}" FontSize="11" Text="{Binding Version, StringFormat=v{0}}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="12" Text="{Binding Author, StringFormat=作者：{0}}" />
                    <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="12" Text="{Binding RatingText, StringFormat=评分 {0}}" Visibility="{Binding RatingText, Converter={StaticResource BlankToCollapsedConverter}}" />
                    <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource Brush.8FFFFFFF}" FontSize="12" Text="{Binding DownloadsText, StringFormat={}{0} 次下载}" Visibility="{Binding DownloadsText, Converter={StaticResource BlankToCollapsedConverter}}" />
                  </StackPanel>
                  <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.A8FFFFFF}" FontSize="12" TextWrapping="Wrap" MaxWidth="620" Text="{Binding Description}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="104" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="下载" Click="OnDownloadModClick" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- 页面标题（覆盖在 frame 头部留白区）＋ BeamNG 官方图标 -->
    <StackPanel Margin="36,22,36,0" Orientation="Horizontal" VerticalAlignment="Top">
      <Image Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="/StartRide;component/Assets/Branding/beamng_logo_256.png" />
      <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Strong}" Text="模组仓库" />
    </StackPanel>

    <!-- 工具栏 -->
    <StackPanel Margin="36,60,36,0" Orientation="Horizontal" VerticalAlignment="Top">
      <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="在线仓库" Command="{Binding ShowOnlineCommand}" />
      <Button Margin="8,0,0,0" Style="{StaticResource LauncherDialogButtonStyle}" Content="本机模组" Command="{Binding ShowLocalCommand}" />
      <Button Margin="8,0,0,0" Style="{StaticResource LauncherDialogButtonStyle}" Content="打开模组文件夹" Command="{Binding OpenModsFolderCommand}" />
      <TextBox Margin="16,0,0,0" Width="160" Height="32" VerticalAlignment="Center" Style="{StaticResource LauncherDialogTextBoxStyle}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索模组" Visibility="{Binding IsOnlineView, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
      <controls:AnimatedComboBox Margin="8,0,0,0" Width="90" Height="32" VerticalAlignment="Center" Style="{StaticResource LauncherComboBoxStyle}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Visibility="{Binding IsOnlineView, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />
    </StackPanel>
  </Grid>
</UserControl>
