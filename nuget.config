<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 覆盖机器级 Offline.config：它指向的 C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\
         在本机不存在，restore 报 NU1301。这里 clear 后只留 nuget.org。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
