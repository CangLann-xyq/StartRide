<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Settings.InfoSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StartRide.App.Controls" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:settings="clr-namespace:StartRide.App.Views.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/StartRide;component/Views/Settings/SettingsSectionResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,12,72" MaxWidth="{StaticResource DetailPageContentMaxWidth}" HorizontalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Left">

      <Image Height="56" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Source="/StartRide;component/Assets/Branding/startride_logo_full_dark.png" />
      <TextBlock Margin="0,10,0,0" Text="{x:Static res:Strings.App_Title}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding LauncherVersionText, StringFormat=v{0}}" />
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis">
        <Run Text="{x:Static res:Strings.Settings_DeveloperLabel}" />
        <Run Text=" · " />
        <Run Text="{x:Static res:Strings.Settings_DeveloperValue}" />
      </TextBlock>
      <WrapPanel Margin="0,16,0,0">
        <Button Margin="0,0,10,10" Content="{x:Static res:Strings.Settings_ViewProjectHomeButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding OpenProjectHomeCommand}" />
        <Button Margin="0,0,10,10" Content="{x:Static res:Strings.Settings_ViewGithubRepositoryButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding OpenGithubRepositoryCommand}" />

        <Button Margin="0,0,10,10" Content="{x:Static res:Strings.Settings_SectionFeedback}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding OpenFeedbackCommand}" />
        <Button Name="CheckUpdatesButton" Margin="0,0,10,10" Style="{StaticResource LauncherPrimaryDialogButtonStyle}" Content="{Binding CheckUpdatesButtonText}" Command="{Binding CheckUpdatesCommand}" RequestBringIntoView="CheckUpdatesButton_OnRequestBringIntoView" />
      </WrapPanel>
    </StackPanel>
    <GroupBox Margin="0,14,0,0" Header="{x:Static res:Strings.Settings_UpdateSection}" Style="{StaticResource RideSectionStyle}">
      <Border Style="{StaticResource RideSectionBodyStyle}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Settings_UpdateSectionDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_UpdateChannelLabel}" Style="{StaticResource SettingsOptionTextStyle}" />
            <Border Grid.Column="1" Style="{StaticResource RideFieldSurfaceStyle}">
              <TextBlock Style="{StaticResource ReadOnlyFieldTextStyle}" Text="{x:Static res:Strings.Settings_UpdateChannelOnlyReleaseTitle}" />
            </Border>
          </Grid>
          <TextBlock Margin="0,10,0,0" Text="{x:Static res:Strings.Settings_UpdateChannelOnlyReleaseDescription}" Style="{StaticResource SettingsDescriptionTextStyle}" />
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,14,0,0" Header="{x:Static res:Strings.Settings_LegalSection}" Style="{StaticResource RideSectionStyle}">
      <Border Style="{StaticResource RideSectionBodyStyle}">
        <StackPanel>

          <ItemsControl ItemsSource="{Binding LegalDocuments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,20" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsOptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,16,0" Text="{Binding Description}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.OpenLegalDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource RideHairlineStyle}" Margin="0,0,0,14" />
          <TextBlock Text="{x:Static res:Strings.Settings_DerivationNotice}" Style="{StaticResource SettingsDescriptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </GroupBox>
    <GroupBox Margin="0,14,0,0" Header="{x:Static res:Strings.Settings_ReferenceProjectsSection}" Style="{StaticResource RideSectionStyle}">
      <Border Style="{StaticResource RideSectionBodyStyle}">
        <StackPanel>

          <TextBlock Margin="0,0,0,16" Text="{x:Static res:Strings.Settings_ReferenceProjectsDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsDescriptionTextStyle}" />
          <ItemsControl ItemsSource="{Binding ReferenceProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,18" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource SettingsOptionTextStyle}" Text="{Binding Name}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsDescriptionTextStyle}" Text="{Binding CopyrightNotice}" />
                  <TextBlock Margin="0,2,0,0" Style="{StaticResource SettingsDescriptionTextStyle}" Text="{Binding LicenseText}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}" Style="{StaticResource LauncherDialogButtonStyle}" Command="{Binding DataContext.OpenReferenceProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </GroupBox>
  </StackPanel>
</UserControl>