<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="StartRide.App.Views.Account.Dialogs.DeleteCloudAccountDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StartRide.App.Resources" Focusable="False" xmlns:dialogs="clr-namespace:StartRide.App.Views.Account.Dialogs">
  <Grid Style="{StaticResource DialogContentGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{x:Static res:Strings.Dialog_DeleteCloudAccountTitle}" Style="{StaticResource DialogTitleTextStyle}" />
    <TextBlock Grid.Row="1" Margin="0,16,0,0" Text="{Binding CloudDeleteDialogMessage}" Style="{StaticResource DialogBodyTextStyle}" />
    <TextBlock Grid.Row="2" Margin="0,12,0,26" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding CloudDeleteDialogNote}" />
    <StackPanel Grid.Row="3" Style="{StaticResource DialogFooterStyle}">
      <Button Style="{StaticResource LauncherDialogButtonStyle}" Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding CancelDeleteCloudAccountCommand}" />
      <Button Style="{StaticResource LauncherDangerDialogButtonStyle}" Margin="{StaticResource DialogTrailingButtonMargin}" Content="{Binding CloudDeleteConfirmText}" Command="{Binding ConfirmDeleteCloudAccountCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
