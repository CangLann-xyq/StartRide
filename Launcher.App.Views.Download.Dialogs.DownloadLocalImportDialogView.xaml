<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Launcher.App.Views.Download.Dialogs.DownloadLocalImportDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animation="clr-namespace:Launcher.App.Behaviors.Animation" xmlns:controls="clr-namespace:Launcher.App.Controls" xmlns:res="clr-namespace:Launcher.App.Resources" Focusable="False" xmlns:dialogs="clr-namespace:Launcher.App.Views.Download.Dialogs">
  <Grid Style="{StaticResource DialogContentGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{x:Static res:Strings.Download_LocalImportDialogTitle}" Style="{StaticResource DialogTitleTextStyle}" />
      <TextBlock Text="{x:Static res:Strings.Download_LocalImportDialogSubtitle}" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding Path=LocalImportDialog.IsSelectionState}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource DialogSubtitleTextStyle}" TargetType="{x:Type TextBlock}" />
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Text="{x:Static res:Strings.Download_LocalImportUnrecognizedMessage}" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding Path=LocalImportDialog.IsUnrecognizedState}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource DialogBodyTextStyle}" TargetType="{x:Type TextBlock}" />
        </FrameworkElement.Style>
      </TextBlock>
    </StackPanel>
    <StackPanel Grid.Row="1" Style="{StaticResource DialogFormPanelStyle}" animation:AnimatedCollapse.Duration="0:0:0.18" animation:AnimatedCollapse.IsExpanded="{Binding LocalImportDialog.IsSelectionState}">
      <StackPanel>
        <Border Style="{StaticResource DialogDropZoneBorderStyle}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:SvgIcon Width="30" Height="30" IconKey="instance_download_page/localimport" Foreground="{DynamicResource Brush.Icon.Primary}" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0" Text="{x:Static res:Strings.Download_LocalImportDropZoneTitle}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Margin="0,6,0,0" Text="{x:Static res:Strings.Download_LocalImportDropZoneSubtitle}" Style="{StaticResource DialogBodyTextStyle}" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center" />
          </StackPanel>
        </Border>
        <TextBlock Margin="0,18,0,8" Text="{x:Static res:Strings.Download_LocalImportSelectedFileLabel}" Style="{StaticResource DialogFieldLabelTextStyle}" />
        <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
          <Grid>
            <TextBlock Text="{Binding LocalImportDialog.SelectedFileName}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource ReadOnlyFieldTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="TextWrapping" Value="NoWrap" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding LocalImportDialog.HasSelectedFile}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <TextBlock Text="{x:Static res:Strings.Download_LocalImportNoFileSelected}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource ReadOnlyFieldTextStyle}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                  <Setter Property="TextWrapping" Value="NoWrap" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding LocalImportDialog.HasSelectedFile}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="{x:Static res:Strings.Download_LocalImportSelectFileButton}" HorizontalAlignment="Left" Command="{Binding LocalImportDialog.SelectFileCommand}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource LauncherDialogButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding LocalImportDialog.IsSelectionState}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static res:Strings.Cancel_Button}" Command="{Binding LocalImportDialog.CancelCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource LauncherDialogButtonStyle}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding LocalImportDialog.IsSelectionState}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
        <Button Margin="{StaticResource DialogTrailingButtonMargin}" Content="{x:Static res:Strings.Confirm_Button}" Command="{Binding LocalImportDialog.ConfirmImportCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource LauncherPrimaryDialogButtonStyle}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding LocalImportDialog.IsSelectionState}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
        <Button Margin="{StaticResource DialogTrailingButtonMargin}" Content="{x:Static res:Strings.Confirm_Button}" Command="{Binding LocalImportDialog.ConfirmUnrecognizedCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource LauncherPrimaryDialogButtonStyle}" TargetType="{x:Type Button}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding LocalImportDialog.IsUnrecognizedState}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>